---
interface Props { overlay?: boolean; }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const current = (prefix: string) => path.startsWith(prefix);
---
<header
  class:list={['site-nav', { 'site-nav-overlay': overlay }]}
  aria-label="Navigation principale"
  data-site-header
  data-overlay={overlay ? 'true' : 'false'}
>
  <a
    class="brand brand-lockup"
    href="/"
    aria-label="Cuisine du Cambodge — Accueil"
    aria-current={path === '/' ? 'page' : undefined}
  >
    <img
      class="brand-logo"
      src="/images/brand/cuisine-du-cambodge-header-logo.png"
      alt=""
      width="480"
      height="155"
      loading="eager"
      decoding="async"
    />
  </a>

  <nav class="nav-links" aria-label="Rubriques">
    <a href="/recettes/" aria-current={current('/recettes/') ? 'page' : undefined}>Recettes</a>
    <a href="/glossaire/" aria-current={current('/glossaire/') ? 'page' : undefined}>Glossaire</a>
    <a href="/apprendre/" aria-current={current('/apprendre/') ? 'page' : undefined}>Ateliers</a>
    <a href="/culture/" aria-current={current('/culture/') ? 'page' : undefined}>Carnets</a>
    <a href="/a-propos/" aria-current={current('/a-propos/') ? 'page' : undefined}>À propos</a>
  </nav>

  <details class="mobile-menu" data-mobile-menu>
    <summary aria-label="Ouvrir le menu">
      <span>Menu</span>
      <i aria-hidden="true"></i>
    </summary>
    <div class="mobile-menu-panel">
      <div class="mobile-menu-ornament" aria-hidden="true"></div>
      <p class="mobile-menu-kicker">Cambodge · Cuisine khmère · Khmer culinary journal</p>
      <nav aria-label="Navigation mobile">
        <a href="/recettes/" aria-current={current('/recettes/') ? 'page' : undefined}><span>01</span>Recettes</a>
        <a href="/glossaire/" aria-current={current('/glossaire/') ? 'page' : undefined}><span>02</span>Glossaire</a>
        <a href="/apprendre/" aria-current={current('/apprendre/') ? 'page' : undefined}><span>03</span>Ateliers</a>
        <a href="/culture/" aria-current={current('/culture/') ? 'page' : undefined}><span>04</span>Carnets</a>
        <a href="/a-propos/" aria-current={current('/a-propos/') ? 'page' : undefined}><span>05</span>À propos</a>
      </nav>
    </div>
  </details>
</header>
