---
interface Props { overlay?: boolean; }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
const current = (prefix: string) => path.startsWith(prefix);
---
<header
  class:list={['site-nav', { 'site-nav-overlay': overlay }]}
  aria-label="Navigation principale"
  data-site-header
  data-overlay={overlay ? 'true' : 'false'}
>
  <a
    class="brand brand-lockup"
    href="/"
    aria-label="Cuisine du Cambodge — Accueil"
    aria-current={path === '/' ? 'page' : undefined}
  >
    <img
      class="brand-logo"
      src="/images/brand/cuisine-du-cambodge-header-logo.png?v=2"
      alt=""
      width="480"
      height="148"
      loading="eager"
      decoding="async"
    />
  </a>

  <nav class="nav-links" aria-label="Rubriques">
    <a href="/recettes/" aria-current={current('/recettes/') ? 'page' : undefined}>Recettes</a>
    <a href="/glossaire/" aria-current={current('/glossaire/') ? 'page' : undefined}>Glossaire</a>
    <a href="/apprendre/" aria-current={current('/apprendre/') ? 'page' : undefined}>Ateliers</a>
    <a href="/culture/" aria-current={current('/culture/') ? 'page' : undefined}>Carnets</a>
    <a href="/a-propos/" aria-current={current('/a-propos/') ? 'page' : undefined}>À propos</a>
  </nav>

  <details class="mobile-menu" data-mobile-menu>
    <summary aria-label="Ouvrir le menu">
      <span>Menu</span>
      <i aria-hidden="true"></i>
    </summary>
    <div class="mobile-menu-panel">
      <div class="mobile-menu-ornament" aria-hidden="true"></div>
      <div class="mobile-menu-heading">
        <p class="mobile-menu-kicker">Cuisine du Cambodge</p>
        <p class="mobile-menu-title">Explorer</p>
      </div>
      <nav aria-label="Navigation mobile">
        <a href="/recettes/" aria-current={current('/recettes/') ? 'page' : undefined}>
          <span class="mobile-menu-index">01</span>
          <strong>Recettes</strong>
          <small>Plats et techniques</small>
        </a>
        <a href="/glossaire/" aria-current={current('/glossaire/') ? 'page' : undefined}>
          <span class="mobile-menu-index">02</span>
          <strong>Glossaire</strong>
          <small>Produits et mots khmers</small>
        </a>
        <a href="/apprendre/" aria-current={current('/apprendre/') ? 'page' : undefined}>
          <span class="mobile-menu-index">03</span>
          <strong>Ateliers</strong>
          <small>Apprendre les gestes</small>
        </a>
        <a href="/culture/" aria-current={current('/culture/') ? 'page' : undefined}>
          <span class="mobile-menu-index">04</span>
          <strong>Carnets</strong>
          <small>Culture et transmission</small>
        </a>
        <a href="/a-propos/" aria-current={current('/a-propos/') ? 'page' : undefined}>
          <span class="mobile-menu-index">05</span>
          <strong>À propos</strong>
          <small>Le projet</small>
        </a>
      </nav>
    </div>
  </details>
</header>
