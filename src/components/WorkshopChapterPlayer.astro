---
import type { WorkshopAudioInfo } from '../data/workshop-audio';
import '../styles/workshop-chapter-player.css';

interface Props { info: WorkshopAudioInfo }
const { info } = Astro.props;
const formatTime = (value: number) => {
  const seconds = Math.floor(value);
  return Math.floor(seconds / 60) + ':' + String(seconds % 60).padStart(2, '0');
};
---
<section
  class="workshop-chapter-player"
  aria-label="Lecteur audio de l’atelier"
  data-workshop-chapter-player
  data-chapters={JSON.stringify(info.chapters)}
  data-audio-duration={info.duration}
>
  <div class="workshop-player-heading">
    <div>
      <p class="workshop-player-kicker">L’atelier à écouter</p>
      <h3>À vos oreilles, à votre rythme.</h3>
      <p>Une voix vous accompagne pendant les gestes. Vous pouvez écouter et faire défiler la page séparément.</p>
    </div>
    <span class="workshop-player-voice">Voix IA Coral · sans musique</span>
  </div>

  <audio data-player-audio src={info.audio} preload="metadata" aria-label={"Narration : " + info.title}></audio>

  <div class="workshop-player-main-controls">
    <button class="workshop-player-primary" type="button" data-player-play aria-label="Écouter l’atelier">▶ <span>Écouter</span></button>
    <div class="workshop-player-seek-area">
      <label class="workshop-player-seek-label" for={"workshop-seek-" + info.slug}>Avancement de l’atelier</label>
      <input id={"workshop-seek-" + info.slug} data-player-seek type="range" min="0" max={info.duration} step="0.1" value="0" aria-label="Avancer ou reculer dans la narration" />
      <span class="workshop-player-time" data-player-time>0:00 / {formatTime(info.duration)}</span>
    </div>
  </div>

  <div class="workshop-player-secondary-controls">
    <div class="workshop-player-skip-controls">
      <button type="button" data-player-stop aria-label="Arrêter la narration et revenir au début">■ Arrêter</button>
      <button type="button" data-player-previous aria-label="Revenir au chapitre précédent">← Chapitre précédent</button>
      <button type="button" data-player-next aria-label="Passer au chapitre suivant">Chapitre suivant →</button>
    </div>
    <button class="workshop-player-follow" type="button" data-player-follow aria-pressed="false">
      <span aria-hidden="true">◉</span> Suivre la narration <span class="workshop-follow-state" data-follow-state>Désactivé</span>
    </button>
  </div>

  <div class="workshop-player-chapters">
    <p>Aller à un chapitre</p>
    <ol>
      {info.chapters.map((chapter, index) => (
        <li>
          <button type="button" data-player-chapter={index} aria-current={index === 0 ? 'step' : undefined}>
            <span>{index === 0 ? 'Intro' : String(index).padStart(2, '0')}</span>
            <strong>{chapter.title}</strong>
            <small>{formatTime(chapter.start)}</small>
          </button>
        </li>
      ))}
    </ol>
  </div>

  <details class="workshop-player-transcript">
    <summary>Lire la narration du chapitre <span aria-hidden="true">+</span></summary>
    <p data-player-transcript>{info.chapters[0]?.text}</p>
  </details>
  <p class="workshop-player-status" data-player-status aria-live="polite">Prêt à écouter. Le défilement de la page est libre.</p>
  <p class="workshop-player-notice">Le suivi automatique est facultatif. Faites défiler la page vous-même à tout moment : le son continuera.</p>

  <!-- Mobile sheet is navigation only: the single <audio> above remains authoritative. -->
  <div class="workshop-mobile-backdrop" data-mobile-backdrop hidden aria-hidden="true"></div>
  <div class="workshop-mobile-dock" data-player-mobile-dock data-dock-visible="false" role="region" aria-label="Mini-lecteur de l’atelier" data-dock-expanded="false">
    <div class="workshop-mobile-sheet" data-mobile-sheet id={"workshop-mobile-sheet-" + info.slug} hidden aria-label="Chapitres et transcription">
      <header class="workshop-mobile-sheet-header" data-mobile-sheet-gesture>
        <div>
          <p class="workshop-mobile-sheet-eyebrow">Votre guide audio</p>
          <h4>Chapitres et narration</h4>
          <p>Choisissez un passage ou consultez son texte. La lecture reste à votre rythme.</p>
        </div>
        <button type="button" class="workshop-mobile-sheet-close" data-mobile-sheet-close aria-label="Replier la navigation audio">⌄ Fermer</button>
      </header>
      <div class="workshop-mobile-sheet-body">
        <nav class="workshop-mobile-chapters" aria-label="Choisir un chapitre audio">
          {info.chapters.map((chapter, index) => (
            <button type="button" data-mobile-chapter={index} aria-current={index === 0 ? 'step' : undefined}>
              <span>{index === 0 ? 'Intro' : '0' + index}</span>
              <strong>{chapter.title}</strong>
              <small>{formatTime(chapter.start)}</small>
            </button>
          ))}
        </nav>
        <section class="workshop-mobile-transcript" aria-label="Texte de la narration en cours">
          <h5>Texte du chapitre actif</h5>
          <p data-mobile-transcript>{info.chapters[0]?.text}</p>
        </section>
        <p class="workshop-mobile-sheet-hint">Le suivi est facultatif : vous pouvez toujours faire défiler les gestes indépendamment de la voix.</p>
      </div>
    </div>
    <button class="workshop-mobile-dock-grip" data-mobile-toggle data-mobile-gesture-zone type="button"
      aria-controls={"workshop-mobile-sheet-" + info.slug} aria-expanded="false"
      aria-label="Déployer les chapitres et la transcription du lecteur">
      <span class="workshop-mobile-dock-handle" aria-hidden="true"></span>
      <span data-mobile-toggle-label>Glisser vers le haut · Chapitres &amp; texte</span>
      <span class="workshop-mobile-dock-chevron" aria-hidden="true">⌃</span>
    </button>
    <div class="workshop-mobile-dock-heading">
      <div class="workshop-mobile-dock-caption">
        <span class="workshop-mobile-kicker">Atelier audio · <span data-mobile-chapter-count>Introduction</span></span>
        <strong data-mobile-chapter-title>{info.chapters[0]?.title}</strong>
      </div>
      <button type="button" data-mobile-follow class="workshop-mobile-follow" aria-pressed="false" aria-label="Suivre la narration et les étapes">◉ Suivre</button>
    </div>
    <div class="workshop-mobile-dock-controls">
      <button type="button" data-mobile-previous class="workshop-mobile-icon" aria-label="Chapitre précédent" disabled>‹</button>
      <button type="button" data-mobile-play class="workshop-mobile-play" aria-label="Écouter l’atelier">▶</button>
      <div class="workshop-mobile-timeline">
        <input data-mobile-seek type="range" min="0" max={info.duration} step="0.1" value="0" aria-label="Avancer ou reculer dans la narration" />
        <span data-mobile-time>0:00 / {formatTime(info.duration)}</span>
      </div>
      <button type="button" data-mobile-next class="workshop-mobile-icon" aria-label="Chapitre suivant">›</button>
      <button type="button" data-mobile-stop class="workshop-mobile-icon workshop-mobile-stop" aria-label="Arrêter la narration">■</button>
    </div>
  </div>
</section>

<script>
  import { initWorkshopChapterPlayers } from '../scripts/workshopChapterPlayer';
  initWorkshopChapterPlayers();
</script>
