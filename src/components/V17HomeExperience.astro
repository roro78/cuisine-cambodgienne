---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/v17-accueil-rebuild.css';
import '../styles/v17-generated-media.css';
import '../styles/v17-finition-editoriale.css';
import '../styles/v17-mortar-cinema.css';
import '../styles/v17-scene-handoffs.css';
import '../styles/v17-d17-cinematic-scenes.css';
import '../styles/v17-d18-table-assemble.css';
import '../styles/v18-table-cutout-dishes.css';
const hero = '/images/cuisine/v17-hero-amok-genere.webp';
// Approved binary is committed; the CI verifies its SHA-256. Never silently
// replace the approved market scene with unrelated documentary photographs.
const market = '/images/cuisine/v17-marche-cambodgien-ia.webp';
const kampot = '/images/cuisine/kampot-1600.webp';
const dessertGenerated = '/images/cuisine/v17-desserts-khmers-generes.webp';
const galangal = '/images/cuisine/v17-galangal-1000.jpg';
const chili = '/images/cuisine/v17-chili-450.png';

interface Props { preview?: boolean; }
// Le paramètre preview reste typé pour la route de prévisualisation, sans texte de debug.
---
<a class="v17r-skip" href="#v17r-main">Aller au contenu</a>
  <div class="v17r-wrap" data-v17r-preview>
    <SiteHeader />
    <main class="v17r" id="v17r-main">
      <!-- D17: one continuous aromatic motif across the market, ingredients
           and mortar; entirely decorative and absent without JS. -->
      <div class="v17r-aromatic-traveller" data-v17-aromatic-traveller aria-hidden="true">
        <img src="/images/brand/v17-lemongrass.svg" alt="" width="670" height="420" decoding="async"/>
      </div>
      <section class="v17r-hero v17r-hero--generated" aria-labelledby="v17r-hero-title">
        <div class="v17r-hero-art" aria-hidden="true">
          <svg class="v17r-temple-illustration" viewBox="0 0 900 430" xmlns="http://www.w3.org/2000/svg" fill="none">
            <g fill="#b58c50" opacity=".38"><path d="M50 430V311h105v-61h35v-69h25v-38h26v38h26v69h37v61h78V252h25v-43h25v-52h23v-40h25v40h22v52h27v43h95v58h59V248h32v-48h28v-50h23v50h28v48h32v63h89v119H50Z"/><path d="M427 157l15-74 17-40 17 40 18 74z"/></g>
            <g stroke="#b58c50" stroke-width="5" opacity=".25"><path d="M17 430L84 360M748 430l84-120M660 430l25-120M206 430l19-100"/></g>
          </svg>
          <img class="v17r-botanic v17r-hero-green-corner" src="/images/brand/v17-banana-leaves.svg" alt="" width="560" height="690" />
          <img class="v17r-botanic v17r-hero-bloom-left" src="/images/brand/v17-plumeria.svg" alt="" width="340" height="340" />
        </div>
        <div class="v17r-hero-copy">
          <p class="v17r-eyebrow">Des saveurs vraies, un voyage gourmand.</p>
          <h1 id="v17r-hero-title">LE CAMBODGE<br/>DANS VOTRE <span>ASSIETTE</span></h1>
          <p>Des recettes parfumées, des ingrédients à découvrir et des gestes pour cuisiner le Cambodge chez soi.</p>
          <a class="v17r-pill" href="/recettes/">Découvrir les recettes <span aria-hidden="true">↗</span></a>
          <p class="v17r-hero-disclosure">Certaines scènes sont des illustrations créées avec l’IA. <a href="/credits-photos/#illustrations-ia">Voir les crédits</a>.</p>
        </div>
        <div class="v17r-hero-media">
          <figure class="v17r-hero-dish">
            <img src={hero} srcset="/images/cuisine/v17-hero-amok-genere-640.webp 640w, /images/cuisine/v17-hero-amok-genere-1120.webp 1120w, /images/cuisine/v17-hero-amok-genere.webp 1448w" sizes="(max-width: 760px) 96vw, 54vw" width="1448" height="1086" fetchpriority="high" decoding="async" alt="Illustration générée d’un Amok Trey au poisson, à la noix de coco, aux aromates et aux piments, dans des feuilles de bananier" />
            <figcaption>Amok Trey <span>Poisson, coco et aromates</span></figcaption>
          </figure>
          <img class="v17r-botanic v17r-hero-flower-dish" src="/images/brand/v17-plumeria.svg" alt="" width="340" height="340" />
          <img class="v17r-botanic v17r-hero-lime" src="/images/brand/v17-lime.svg" alt="" width="420" height="360" />
          <svg class="v17r-decoration v17r-leaf" viewBox="0 0 150 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M20 178C38 87 94 32 133 13C147 92 112 166 20 178Z" fill="#54873F"/><path d="M20 178C69 123 101 81 133 13M68 115L54 66M93 88L116 97" stroke="#24432A" stroke-width="5" stroke-linecap="round"/></svg>
        </div>
      </section>
      <div class="v17r-wave v17r-wave-ivory" aria-hidden="true"><svg viewBox="0 0 1440 95" preserveAspectRatio="none"><path d="M0 0C130 12 225 82 394 40S750 6 900 46s360 25 540-5v54H0Z" fill="#143929"/></svg></div>

      <section class="v17r-market" aria-labelledby="v17r-market-title">
        <figure class="v17r-market-visual v17r-market-visual--generated">
          <img src={market}
            sizes="(max-width: 760px) 100vw, 72vw"
            width="1672" height="941"
            loading="lazy" decoding="async"
            alt="Illustration générée par IA d’un marché terrestre imaginaire d’inspiration cambodgienne, avec vendeuses, étals, citronnelle, piments et légumes" />
          <figcaption>Marché imaginaire inspiré du Cambodge</figcaption>
        </figure>
        <div class="v17r-market-copy">
          <p class="v17r-kicker">01 — Les produits</p>
          <h2 id="v17r-market-title">TOUT PART DES <em>BONS PRODUITS.</em></h2>
          <p>Les marchés, les épices, les herbes fraîches : autant de parfums à apprivoiser.</p>
          <a class="v17r-pill" href="/ingredients/">Explorer les ingrédients <span aria-hidden="true">↗</span></a>
          <a class="v17r-underlink" href="/glossaire/">Voir aussi le glossaire <span aria-hidden="true">↗</span></a>
        </div>
      </section>
      <div class="v17r-wave v17r-wave-green" aria-hidden="true"><svg viewBox="0 0 1440 95" preserveAspectRatio="none"><path d="M0 36C166 -3 330 66 499 35S848 6 1030 44 1271 85 1440 21v74H0Z" fill="#fff9ec"/></svg></div>

      <section class="v17r-palette" aria-labelledby="v17r-palette-title">
        <p class="v17r-kicker">Des parfums uniques</p>
        <h2 id="v17r-palette-title">UNE PALETTE<br/><em>D’INGRÉDIENTS</em><br/>D’EXCEPTION</h2>
        <p class="v17r-palette-intro">Citronnelle, galanga, combava, piment, poivre de Kampot… Chaque ingrédient a sa place dans cet équilibre de saveurs.</p>
        <div class="v17r-palette-media">
          <img class="v17r-botanic v17r-palette-foliage-left" src="/images/brand/v17-banana-leaves.svg" alt="" aria-hidden="true" width="560" height="690" loading="lazy" decoding="async" />
          <img class="v17r-botanic v17r-palette-foliage-right" src="/images/brand/v17-banana-leaves.svg" alt="" aria-hidden="true" width="560" height="690" loading="lazy" decoding="async" />
          <img class="v17r-botanic v17r-lemongrass" src="/images/brand/v17-lemongrass.svg" alt="" width="670" height="420" />
          <img class="v17r-botanic v17r-palette-lime" src="/images/brand/v17-lime.svg" alt="" width="420" height="360" />
          <img class="v17r-botanic v17r-palette-flower" src="/images/brand/v17-plumeria.svg" alt="" width="340" height="340" />
          <img class="v17r-spice-bowls" src="/images/brand/v17-spice-bowls.svg" alt="" aria-hidden="true" width="840" height="500" loading="lazy" decoding="async" />
          <figure class="v17r-palette-a">
            <img src={galangal} srcset="/images/cuisine/v17-galangal-1000-480.webp 480w, /images/cuisine/v17-galangal-1000.jpg 691w" sizes="(max-width: 760px) 42vw, 24vw" width="1000" height="538" loading="lazy" decoding="async" alt="Rhizomes de galanga, photographie botanique générique" />
            <figcaption>Le galanga</figcaption>
          </figure>
          <img class="v17r-palette-chili" src={chili} srcset="/images/cuisine/v17-chili-450-120.webp 120w, /images/cuisine/v17-chili-450.png 500w" sizes="(max-width:760px) 12vw, 9vw" alt="" aria-hidden="true" width="450" height="474" loading="lazy" decoding="async" />
          <figure class="v17r-palette-b">
            <img src={kampot} srcset="/images/cuisine/kampot-800.webp 800w, /images/cuisine/kampot-1600.webp 1600w" sizes="(max-width: 760px) 42vw, 24vw" width="1600" height="1067" loading="lazy" decoding="async" alt="Poivre de Kampot" />
            <figcaption>Le poivre de Kampot</figcaption>
          </figure>
        </div>
        <a class="v17r-pill" href="/glossaire/">En savoir plus <span aria-hidden="true">↗</span></a>
      </section>

      <div class="v17r-handoff v17r-handoff--aroma" aria-hidden="true"><svg viewBox="0 0 1440 180" preserveAspectRatio="none" focusable="false"><path d="M0 128C206 139 303 53 476 74S755 170 972 94 1298 39 1440 70V180H0Z" fill="#143929"/></svg></div>
      <section class="v17r-gestures v17r-gestures--cinematic" aria-labelledby="v17r-gestures-title" data-v17-mortar-scene>
        <div class="v17r-gestures-visual" data-media-status="photographie-geste-generique">
          <figure class="v17r-gestures-main">
            <img src="/images/cuisine/v17-mortar-hands-1600.jpg" srcset="/images/cuisine/v17-mortar-hands-1600-800.webp 800w, /images/cuisine/v17-mortar-hands-1600-1200.webp 1200w, /images/cuisine/v17-mortar-hands-1600.jpg 1600w" sizes="100vw" width="1600" height="1067" loading="lazy" decoding="async" alt="Mains tenant un pilon au-dessus d’un mortier en pierre, photographie illustrative du geste" />
            <figcaption>Le geste du mortier · photographie d’illustration</figcaption>
          </figure>
          <figure class="v17r-gestures-kroeung">
            <img src="/images/cuisine/v17-kroeung-final.jpg" srcset="/images/cuisine/v17-kroeung-final-360.webp 360w, /images/cuisine/v17-kroeung-final.jpg 522w" sizes="(max-width:760px) 40vw, 24vw" alt="Pâte de kroeung rouge après préparation, photographie distincte" width="800" height="600" loading="lazy" decoding="async" />
            <figcaption>Kroeung préparé · le résultat du geste</figcaption>
          </figure>
          <div class="v17r-gestures-shade" aria-hidden="true"></div>
        </div>
        <div class="v17r-gestures-copy">
          <p class="v17r-kicker">02 — Le savoir-faire</p>
          <h2 id="v17r-gestures-title"><span class="v17r-gesture-word">COUPER.</span><span class="v17r-gesture-word v17r-gesture-word--accent"><em>PILER.</em></span><span class="v17r-gesture-word">SENTIR.</span></h2>
          <p>Au mortier, les aromates s’écrasent, se mêlent et libèrent leurs parfums. Découvrez le geste qui donne vie au kroeung.</p>
          <a class="v17r-pill" href="/apprendre/piler-aromates-au-mortier/">Découvrir le geste <span aria-hidden="true">↗</span></a>
        </div>
        <div class="v17r-gestures-progress" aria-hidden="true"><span></span></div>
      </section>
      <div class="v17r-wave v17r-wave-cream" aria-hidden="true"><svg viewBox="0 0 1440 95" preserveAspectRatio="none"><path d="M0 12C135 89 327 7 495 45S839 65 1010 26 1241 79 1440 38v57H0Z" fill="#69361e"/></svg></div>

      <section class="v17r-table v17r-table--assembled" aria-labelledby="v17r-table-title" data-v17-table-assemble>
        <div class="v17r-table-stage">
          <div class="v17r-table-atmosphere" aria-hidden="true">
            <span class="v17r-table-linen"></span>
            <span class="v17r-table-light"></span>
          </div>
          <div class="v17r-table-copy">
            <p class="v17r-kicker">03 — À table</p>
            <h2 id="v17r-table-title">DES PLATS<br/><em>À PARTAGER.</em></h2>
            <p>Quatre saveurs, mille façons de se retrouver. Composez votre tablée et découvrez les recettes du Cambodge.</p>
            <a class="v17r-pill" href="/recettes/">Explorer toutes les recettes <span aria-hidden="true">↗</span></a>
            <a class="v17r-table-sub" href="/culture/construire-repas-cambodgien/">L’art du repas cambodgien →</a>
          </div>
          <div class="v17r-table-dishes" role="group" aria-label="Découvrez les recettes présentées à table">
            <a class="v17r-table-dish v17r-table-dish--amok" href="/recettes/amok-trey/"
               aria-label="Amok Trey — découvrir la recette">
              <span class="v17r-table-dish-photo">
                <img src="/images/cuisine/v18-home-amok-trey-cutout.webp" width="1448" height="1086" loading="lazy" decoding="async"
                     alt="Amok Trey, curry de poisson cambodgien parfumé au lait de coco"/>
              </span>
              <span class="v17r-table-dish-label">Amok Trey <span aria-hidden="true">↗</span></span>
            </a>
            <a class="v17r-table-dish v17r-table-dish--loklak" href="/recettes/lok-lak/"
               aria-label="Lok Lak — découvrir la recette">
              <span class="v17r-table-dish-photo">
                <img src="/images/cuisine/v18-home-lok-lak-cutout.webp" width="1448" height="1086" loading="lazy" decoding="async"
                     alt="Lok Lak, bœuf sauté accompagné de crudités"/>
              </span>
              <span class="v17r-table-dish-label">Lok Lak <span aria-hidden="true">↗</span></span>
            </a>
            <a class="v17r-table-dish v17r-table-dish--nombanhchok" href="/recettes/num-banh-chok/"
               aria-label="Num Banh Chok — découvrir la recette">
              <span class="v17r-table-dish-photo">
                <img src="/images/cuisine/v18-home-num-banh-chok-cutout.webp" width="1448" height="1086" loading="lazy" decoding="async"
                     alt="Num Banh Chok, nouilles de riz aux herbes et sauce khmère"/>
              </span>
              <span class="v17r-table-dish-label">Num Banh Chok <span aria-hidden="true">↗</span></span>
            </a>
            <a class="v17r-table-dish v17r-table-dish--prahok" href="/recettes/prahok-ktis/"
               aria-label="Prahok Ktis — découvrir la recette">
              <span class="v17r-table-ripple" aria-hidden="true"></span>
              <span class="v17r-table-dish-photo">
                <img src="/images/cuisine/v18-home-prahok-ktis-cutout.webp" width="1448" height="1086" loading="lazy" decoding="async"
                     alt="Prahok Ktis, préparation à partager avec des crudités"/>
              </span>
              <span class="v17r-table-dish-label">Prahok Ktis <span aria-hidden="true">↗</span></span>
            </a>
          </div>
          <p class="v17r-table-recipe-hint">Choisissez un plat pour découvrir sa recette <span aria-hidden="true">↗</span></p>
        </div>
      </section>

      <div class="v17r-handoff v17r-handoff--sweet" aria-hidden="true"><svg viewBox="0 0 1440 180" preserveAspectRatio="none" focusable="false"><path d="M0 88C239 31 409 141 638 100S1025 27 1221 95 1347 131 1440 79V180H0Z" fill="#fff8eb"/></svg></div>
      <section class="v17r-dessert" aria-labelledby="v17r-dessert-title">
        <div class="v17r-dessert-copy">
          <p class="v17r-kicker">04 — Les douceurs</p>
          <h2 id="v17r-dessert-title">DES DESSERTS<br/>TOUT EN FINESSE.</h2>
          <p>Num Plae Ai, Num Kom, Chek Ktis… Riz gluant, coco et douceurs à partager pour prolonger le voyage.</p>
          <a class="v17r-pill" href="/recettes/chek-ktis/">Découvrir le Chek Ktis <span aria-hidden="true">↗</span></a>
        </div>
        <div class="v17r-dessert-art v17r-dessert-art--generated">
          <figure class="v17r-dessert-generated">
            <img src={dessertGenerated} width="1448" height="1086" loading="lazy" decoding="async" alt="Illustration générée de douceurs d’inspiration khmère : riz gluant au lait de coco, mangue, fruits et gâteaux enveloppés de feuilles de bananier" />
            <figcaption>Riz gluant, mangue, coco et feuilles de bananier</figcaption>
          </figure>
        </div>
      </section>

      <div class="v17r-handoff v17r-handoff--journey" aria-hidden="true"><svg viewBox="0 0 1440 180" preserveAspectRatio="none" focusable="false"><path d="M0 134C182 63 335 151 501 102S863 33 1030 90 1297 156 1440 92V180H0Z" fill="#df825c"/></svg></div>
      <section class="v17r-finale" aria-labelledby="v17r-finale-title">
        <div class="v17r-finale-landscape">
          <img src="/images/cuisine/v17-angkor-sunset-1600.jpg" width="1600" height="900" loading="lazy" decoding="async" alt="Angkor Wat éclairé par le soleil couchant et reflété dans l’eau, photographie documentaire" />
        </div>
        <div class="v17r-finale-stamp" aria-hidden="true">
          <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg">
            <circle cx="120" cy="120" r="112" fill="none" stroke="currentColor" stroke-width="3"/>
            <circle cx="120" cy="120" r="91" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 8"/>
            <path d="M58 163h124M72 157v-31h12v-19h16v-17h10V75h20v15h10v17h16v19h12v31M95 158v-22l7-12 7 12v22M131 158v-22l7-12 7 12v22M118 159V99l9-15 9 15v60" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
            <text x="120" y="52" font-size="16" font-weight="800" text-anchor="middle" fill="currentColor" letter-spacing="2">UNE CUISINE</text>
            <text x="120" y="198" font-size="16" font-weight="800" text-anchor="middle" fill="currentColor" letter-spacing="2">UN VOYAGE</text>
          </svg>
        </div>
        <div class="v17r-finale-copy">
          <p class="v17r-kicker">05 — À vous de jouer</p>
          <h2 id="v17r-finale-title">CUISINEZ,<br/>PARTAGEZ,<br/><em>VOYAGEZ.</em></h2>
          <p>Des recettes, des ateliers et des découvertes pour faire entrer les saveurs du Cambodge dans votre quotidien.</p>
          <div class="v17r-finale-actions">
            <a class="v17r-pill" href="/apprendre/">Nos ateliers <span aria-hidden="true">↗</span></a>
            <a class="v17r-pill v17r-pill-outline" href="/recettes/">Toutes les recettes <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

    </main>
    <SiteFooter />
  </div>
  <script>
    import { initV17AccueilMotion } from '../scripts/v17AccueilMotion';
    initV17AccueilMotion();
  </script>
