---
import type { GlossaryEntry } from '../data/glossary';
interface Props { entries: GlossaryEntry[]; }
const { entries } = Astro.props;
---
{entries.length > 0 && (
  <aside class="glossary-strip" aria-labelledby="glossary-title" data-reveal="up">
    <div class="glossary-strip-head">
      <p class="eyebrow">Glossaire express</p>
      <h2 id="glossary-title">Les mots à connaître</h2>
      <p>Un repère rapide pour comprendre ce que l’ingrédient apporte vraiment dans la recette.</p>
      <a class="text-link" href="/glossaire/">Voir tout le glossaire</a>
    </div>
    <div class="glossary-items">
      {entries.map((entry) => (
        <details class="glossary-item">
          <summary>
            <strong>{entry.term}</strong>
            <span aria-hidden="true">+</span>
          </summary>
          <div class="glossary-definition">
            <p>{entry.short}</p>
            {entry.culinaryUse && <p><strong>En cuisine :</strong> {entry.culinaryUse}</p>}
            {entry.cue && <p><strong>Repère :</strong> {entry.cue}</p>}
            {entry.href && <a href={entry.href}>Voir le guide détaillé</a>}
          </div>
        </details>
      ))}
    </div>
  </aside>
)}
