---
import type { GlossaryEntry } from '../data/glossary';
interface Props { entries: GlossaryEntry[]; }
const { entries } = Astro.props;
---
{entries.length > 0 && (
  <aside class="glossary-strip" aria-labelledby="glossary-title" data-reveal="up">
    <div class="glossary-strip-head">
      <p class="eyebrow">Glossaire culinaire</p>
      <h2 id="glossary-title">Les mots à reconnaître en cuisine</h2>
      <p>Pas seulement une définition : à quoi sert le terme, ce qu’il faut chercher au goût et comment l’utiliser.</p>
    </div>
    <div class="glossary-items">
      {entries.map((entry) => (
        <details class="glossary-item">
          <summary>
            <strong>{entry.term}</strong>
            <span aria-hidden="true">+</span>
          </summary>
          <div class="glossary-definition">
            <p>{entry.short}</p>
            {entry.culinaryUse && <p><b>En cuisine.</b> {entry.culinaryUse}</p>}
            {entry.cue && <p><b>Repère.</b> {entry.cue}</p>}
            {entry.href && <a href={entry.href}>Voir le guide détaillé</a>}
          </div>
        </details>
      ))}
    </div>
    <a class="text-link glossary-all-link" href="/glossaire/">Voir tout le glossaire</a>
  </aside>
)}
