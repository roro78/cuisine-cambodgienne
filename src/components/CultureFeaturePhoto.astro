---
import type { CultureFeatureImage } from '../data/culture';
import { imageSrcSet } from '../utils/images';

interface Props {
  photo: CultureFeatureImage;
  class: string;
  sizes: string;
  eager?: boolean;
}
const { photo, class: className, sizes, eager = false } = Astro.props;
---

<figure class:list={['carnet-feature', className]}>
  <img src={photo.image} srcset={photo.widths.length ? imageSrcSet(photo.image, photo.widths) : undefined} sizes={photo.widths.length ? sizes : undefined}
       alt={photo.alt} width={photo.width} height={photo.height}
       loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
  <figcaption>
    <strong>{photo.caption}</strong>
    <span>{photo.detail}</span>
    {photo.generated ? (
      <small>{photo.credit}.</small>
    ) : (
      <small>{photo.credit}{photo.coCredit && <> / <a href={photo.coCredit.href}>{photo.coCredit.label}</a></>}, via <a href={photo.source}>Wikimedia Commons</a> · <a href={photo.license.href}>{photo.license.label}</a> · {photo.assetNote ?? 'WebP redimensionné, cadrage intégral.'}</small>
    )}
    {photo.recipe && <a class="carnet-recipe-link" href={photo.recipe.href}>Recette du {photo.recipe.label} <span aria-hidden="true">→</span></a>}
  </figcaption>
</figure>
