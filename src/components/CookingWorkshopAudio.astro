---
interface Chapter { id:string; title:string; startSec:number; endSec:number }
interface Manifest { atelier:string; status:string; audioUrl:string; durationSec:number; chapters:Chapter[]; review?:{acousticListening:boolean;mobile:boolean;desktop:boolean} }
interface Props { manifest:Manifest; scripts:string[] }
const { manifest, scripts }=Astro.props;
if(manifest.chapters.length!==7 || scripts.length!==7)throw Error('Lecteur atelier : intro et six chapitres exigés.');
const chapters=manifest.chapters.map((chapter,i)=>({...chapter,text:scripts[i]}));
const displayTime=(s:number)=>Math.floor(s/60)+':'+String(Math.floor(s%60)).padStart(2,'0');
const acousticReviewComplete=manifest.review?.acousticListening===true && manifest.review?.mobile===true && manifest.review?.desktop===true;
const acousticListeningApproved=manifest.review?.acousticListening===true;
---
<section class="guided-cooking-audio" data-cooking-chapters={JSON.stringify(chapters)} aria-labelledby="guided-cooking-title">
  <div class="guided-cooking-audio-head">
    <div>
      <p class="guided-cooking-eyebrow">La cuisine à écouter</p>
      <h2 id="guided-cooking-title">Votre guide audio en sept chapitres.</h2>
      <p>{displayTime(manifest.durationSec)} · une introduction puis six phases de cuisine, à votre rythme.</p>
    </div>
    <small class="guided-cooking-review">{acousticReviewComplete ? 'Guide vocal et navigation validés' : acousticListeningApproved ? 'Narration approuvée · tests mobile/ordinateur à terminer' : 'En préécoute · validation sonore à terminer'}</small>
  </div>
  <audio src={manifest.audioUrl} controls preload="metadata" data-cooking-audio aria-label="Guide vocal de l’atelier">
    Ce navigateur ne prend pas en charge la lecture du guide audio.
  </audio>
  <ol class="guided-cooking-chapter-list" aria-label="Chapitres de l’atelier guidé">
    {chapters.map((chapter,i)=>(
      <li>
        <button type="button" data-cooking-chapter={i} aria-current={i===0?'true':undefined}>
          <span>{i===0?'Intro':String(i).padStart(2,'0')}</span>
          <strong>{chapter.title}</strong>
          <small>{displayTime(chapter.startSec)}</small>
        </button>
      </li>
    ))}
  </ol>
  <details class="guided-cooking-transcript">
    <summary>Lire les paroles du chapitre sélectionné</summary>
    <p data-cooking-transcript>{scripts[0]}</p>
  </details>
  <p class="guided-cooking-live" data-cooking-status aria-live="polite">Introduction sélectionnée.</p>
  <div class="guided-cooking-follow-row">
    <button type="button" data-cooking-follow aria-pressed="false" aria-label="Activer le suivi des grandes étapes de la recette">◉ Suivre la narration : désactivé</button>
    <p>Le suivi est facultatif : la page avance seulement aux grandes phases. Faites défiler librement pour le désactiver sans interrompre le son.</p>
  </div>
  <p class="guided-cooking-tip">Pendant les gestes, vous pouvez mettre le guide en pause et reprendre à votre rythme. Les instructions écrites restent disponibles sans audio.</p>
  <div class="guided-cooking-mobile-dock" data-cooking-mobile-dock data-visible="true" data-cooking-duration={manifest.durationSec} role="region" aria-label="Mini-lecteur du guide vocal">
    <button type="button" data-cooking-mobile-play aria-label="Mettre le guide en pause">Ⅱ</button>
    <div class="guided-cooking-mobile-caption">
      <span data-cooking-mobile-phase>Introduction</span>
      <strong data-cooking-mobile-title>{chapters[0].title}</strong>
      <div class="guided-cooking-mobile-progress">
        <progress data-cooking-mobile-progress value="0" max={manifest.durationSec} aria-label="Avancement de l'audio"></progress>
        <small data-cooking-mobile-clock>0:00 / {displayTime(manifest.durationSec)}</small>
      </div>
    </div>
    <button type="button" data-cooking-mobile-steps aria-expanded="false" aria-controls="guided-cooking-mobile-chapters" aria-label="Ouvrir le guide audio et ses chapitres">Chapitres ↑</button>
  </div>
  <div id="guided-cooking-mobile-chapters" class="guided-cooking-mobile-sheet" data-cooking-mobile-sheet role="dialog" aria-modal="false" aria-label="Guide audio et chapitres" hidden>
    <div class="guided-cooking-mobile-grip" aria-hidden="true"></div>
    <div class="guided-cooking-mobile-sheet-head">
      <div><small>La cuisine à écouter</small><strong>Votre guide audio</strong></div>
      <button type="button" data-cooking-mobile-close aria-label="Refermer le guide audio">✕</button>
    </div>
    <div class="guided-cooking-mobile-playing">
      <button type="button" data-cooking-sheet-play aria-label="Démarrer la narration">▶</button>
      <div><strong data-cooking-sheet-title>{chapters[0].title}</strong><small data-cooking-sheet-clock>0:00 / {displayTime(manifest.durationSec)}</small></div>
    </div>
    <div class="guided-cooking-mobile-tabs" role="group" aria-label="Informations du guide audio">
      <button type="button" data-cooking-mobile-tab="chapters" aria-pressed="true">Chapitres</button>
      <button type="button" data-cooking-mobile-tab="transcript" aria-pressed="false">Paroles</button>
    </div>
    <div data-cooking-mobile-view="chapters">
      <ol aria-label="Les sept chapitres disponibles">
        {chapters.map((chapter,i)=>(<li><button type="button" data-cooking-mobile-chapter={i}><span>{i===0?'Introduction':'Phase '+i+' / 6'}</span><strong>{chapter.title}</strong><small>{displayTime(chapter.startSec)}</small></button></li>))}
      </ol>
    </div>
    <div data-cooking-mobile-view="transcript" hidden>
      <div class="guided-cooking-mobile-transcript-toolbar">
        <button type="button" data-cooking-mobile-transcript-follow aria-pressed="true" aria-label="Activer ou arrêter le défilement automatique du texte">Défilement du texte : activé</button>
        <small>Suivi indicatif du chapitre, sans minutage mot à mot.</small>
      </div>
      <div class="guided-cooking-mobile-transcript" data-cooking-mobile-transcript-scroll tabindex="0" aria-label="Texte de la narration : défilement libre possible">
        <p data-cooking-mobile-transcript>{scripts[0]}</p>
      </div>
    </div>
    <div class="guided-cooking-mobile-actions">
      <button type="button" data-cooking-mobile-follow aria-pressed="false" aria-label="Activer le suivi automatique des étapes de la recette">Suivre la narration</button>
      <button type="button" data-cooking-mobile-stop aria-label="Arrêter le guide et revenir au début">■ Arrêter</button>
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-cooking-chapters]').forEach((root)=>{
    type Chapter={id:string;title:string;startSec:number;endSec:number;text:string};
    const chapters=JSON.parse(root.dataset.cookingChapters||'[]') as Chapter[];
    const audio=root.querySelector<HTMLAudioElement>('[data-cooking-audio]');
    const buttons=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cooking-chapter]'));
    const status=root.querySelector<HTMLElement>('[data-cooking-status]');
    const transcript=root.querySelector<HTMLElement>('[data-cooking-transcript]');
    let active=0;
    let following=false;
    let programmaticScrollUntil=0;
    const followButton=root.querySelector<HTMLButtonElement>('[data-cooking-follow]');
    const mobileDock=root.querySelector<HTMLElement>('[data-cooking-mobile-dock]');
    const mobilePlay=root.querySelector<HTMLButtonElement>('[data-cooking-mobile-play]');
    const mobileTitle=root.querySelector<HTMLElement>('[data-cooking-mobile-title]');
    const mobilePhase=root.querySelector<HTMLElement>('[data-cooking-mobile-phase]');
    const mobileFollow=root.querySelector<HTMLButtonElement>('[data-cooking-mobile-follow]');
    const mobileStop=root.querySelector<HTMLButtonElement>('[data-cooking-mobile-stop]');
    const mobileSteps=root.querySelector<HTMLButtonElement>('[data-cooking-mobile-steps]');
    const mobileSheet=root.querySelector<HTMLElement>('[data-cooking-mobile-sheet]');
    const mobileClose=root.querySelector<HTMLButtonElement>('[data-cooking-mobile-close]');
    const mobileChapterButtons=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cooking-mobile-chapter]'));
    const mobileViewport=window.matchMedia('(max-width: 760px)');
    const sheetPlay=root.querySelector<HTMLButtonElement>('[data-cooking-sheet-play]');
    const sheetTitle=root.querySelector<HTMLElement>('[data-cooking-sheet-title]');
    const clock=root.querySelector<HTMLElement>('[data-cooking-mobile-clock]');
    const sheetClock=root.querySelector<HTMLElement>('[data-cooking-sheet-clock]');
    const progress=root.querySelector<HTMLProgressElement>('[data-cooking-mobile-progress]');
    const sheetTranscript=root.querySelector<HTMLElement>('[data-cooking-mobile-transcript]');
    const transcriptScroll=root.querySelector<HTMLElement>('[data-cooking-mobile-transcript-scroll]');
    const transcriptFollowButton=root.querySelector<HTMLButtonElement>('[data-cooking-mobile-transcript-follow]');
    const mobileChapterView=root.querySelector<HTMLElement>('[data-cooking-mobile-view="chapters"]');
    let transcriptFollowing=true;
    const mobileTabs=Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cooking-mobile-tab]'));
    const mobileViews=Array.from(root.querySelectorAll<HTMLElement>('[data-cooking-mobile-view]'));
    const formatTime=(seconds:number)=>Math.floor(seconds/60)+':'+String(Math.floor(seconds%60)).padStart(2,'0');
    let audioStarted=false;
    const closeMobileSheet=()=>{
      if(mobileSheet)mobileSheet.hidden=true;
      mobileSteps?.setAttribute('aria-expanded','false');
    };
    const updateMobileDock=()=>{
      if(!mobileDock || !audio)return;
      if(!mobileViewport.matches)closeMobileSheet();
      mobileDock.dataset.visible=String(mobileViewport.matches);
      // Always present on mobile, including before Play and after Stop.
      for(const control of [mobilePlay,sheetPlay]){
        if(!control)continue;
        control.textContent=audio.paused?'▶':'Ⅱ';
        control.setAttribute('aria-label',audio.paused?'Démarrer ou reprendre le guide vocal':'Mettre le guide en pause');
      }
      if(mobileTitle)mobileTitle.textContent=chapters[active].title;
      if(sheetTitle)sheetTitle.textContent=chapters[active].title;
      if(mobilePhase)mobilePhase.textContent=active===0?'Introduction':'Phase '+active+'/6';
      const total=Number.isFinite(audio.duration)&&audio.duration>0?audio.duration:Number(mobileDock.dataset.cookingDuration)||1;
      const elapsed=Number.isFinite(audio.currentTime)?audio.currentTime:0;
      const timeLabel=formatTime(elapsed)+' / '+formatTime(total);
      if(clock)clock.textContent=timeLabel;
      if(sheetClock)sheetClock.textContent=timeLabel;
      if(progress){progress.max=total;progress.value=Math.min(elapsed,total);}
    };
    mobileViewport.addEventListener('change',updateMobileDock);
    mobileSteps?.addEventListener('click',()=>{
      if(!mobileSheet)return;
      const opening=mobileSheet.hidden;
      mobileSheet.hidden=!opening;
      mobileSteps.setAttribute('aria-expanded',String(opening));
      if(opening)mobileChapterButtons[active]?.focus({preventScroll:true});
    });
    mobileClose?.addEventListener('click',()=>{closeMobileSheet();mobileSteps?.focus({preventScroll:true});});
    mobileTabs.forEach(tab=>tab.addEventListener('click',()=>{
      const target=tab.dataset.cookingMobileTab;
      mobileTabs.forEach(button=>button.setAttribute('aria-pressed',String(button===tab)));
      mobileViews.forEach(view=>{view.hidden=view.dataset.cookingMobileView!==target;});
      if(target==='transcript')updateTranscriptScroll();
      if(target==='chapters')revealCurrentChapter();
    }));
    // Native vertical swipe opens/closes the slide-up navigation.
    let touchOrigin:number|null=null;
    mobileDock?.addEventListener('touchstart',event=>{touchOrigin=event.touches[0]?.clientY??null;},{passive:true});
    mobileDock?.addEventListener('touchend',event=>{
      if(touchOrigin!==null&&touchOrigin-(event.changedTouches[0]?.clientY??touchOrigin)>55){
        if(mobileSheet)mobileSheet.hidden=false;
        mobileSteps?.setAttribute('aria-expanded','true');
      }
      touchOrigin=null;
    },{passive:true});
    const sheetHead=mobileSheet?.querySelector<HTMLElement>('.guided-cooking-mobile-sheet-head');
    sheetHead?.addEventListener('touchstart',event=>{touchOrigin=event.touches[0]?.clientY??null;},{passive:true});
    sheetHead?.addEventListener('touchend',event=>{
      if(touchOrigin!==null&&(event.changedTouches[0]?.clientY??touchOrigin)-touchOrigin>55)closeMobileSheet();
      touchOrigin=null;
    },{passive:true});
    window.addEventListener('keydown',event=>{if(event.key==='Escape'&&mobileSheet&&!mobileSheet.hidden){closeMobileSheet();mobileSteps?.focus({preventScroll:true});}});
    document.addEventListener('pointerdown',event=>{
      if(!mobileSheet||mobileSheet.hidden)return;
      if(event.target instanceof Element&&!event.target.closest('[data-cooking-mobile-sheet],[data-cooking-mobile-steps]'))closeMobileSheet();
    });
    const togglePlayback=()=>{
      if(!audio)return;
      if(audio.paused)void audio.play().catch(()=>{if(status)status.textContent='Impossible de démarrer le son.';});
      else audio.pause();
    };
    mobilePlay?.addEventListener('click',togglePlayback);
    sheetPlay?.addEventListener('click',togglePlayback);
    mobileStop?.addEventListener('click',()=>{
      if(!audio)return;
      audio.pause();
      audio.currentTime=0;
      audioStarted=false;
      following=false;
      closeMobileSheet();
      renderFollow();
      updateMobileDock();
    });
    audio?.addEventListener('play',()=>{audioStarted=true;updateMobileDock();});
    audio?.addEventListener('pause',updateMobileDock);
    audio?.addEventListener('loadedmetadata',updateMobileDock);
    audio?.addEventListener('seeked',updateMobileDock);
    audio?.addEventListener('ended',()=>{audioStarted=false;updateMobileDock();});
    const prefersReducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
    const renderFollow=()=>{
      if(followButton){
        followButton.setAttribute('aria-pressed',String(following));
        followButton.textContent=following?'◉ Suivre la narration : activé':'◉ Suivre la narration : désactivé';
      }
      if(mobileFollow){
        mobileFollow.setAttribute('aria-pressed',String(following));
        mobileFollow.textContent=following?'Suivi de la page : actif':'Suivre la narration';
        mobileFollow.setAttribute('aria-label',following?'Désactiver le suivi de la page':'Activer le suivi de la page au rythme des étapes');
      }
    };
    const scrollToChapter=(index:number)=>{
      const target=index===0?root:document.getElementById('phase-'+chapters[index].id);
      if(!target)return;
      programmaticScrollUntil=Date.now()+2200;
      target.scrollIntoView({behavior:prefersReducedMotion.matches?'auto':'smooth',block:'start'});
    };
    const stopFollowing=()=>{
      if(!following)return;
      following=false;
      renderFollow();
      if(status)status.textContent='Défilement libre : le suivi est désactivé, mais la narration continue.';
    };
    const toggleFollow=()=>{
      following=!following;
      renderFollow();
      if(following)scrollToChapter(active);
    };
    followButton?.addEventListener('click',toggleFollow);
    mobileFollow?.addEventListener('click',()=>{
      toggleFollow();
      // The recipe must remain readable during synchronized page following.
      if(following&&mobileViewport.matches)closeMobileSheet();
    });
    // Manual scrolling always wins over automatic navigation. Playback is never paused.
    window.addEventListener('wheel',stopFollowing,{passive:true});
    window.addEventListener('touchmove',(event)=>{
      if(event.target instanceof Element&&event.target.closest('[data-cooking-mobile-dock] button,[data-cooking-mobile-sheet] button'))return;
      stopFollowing();
    },{passive:true});
    window.addEventListener('scroll',()=>{
      if(following&&Date.now()>programmaticScrollUntil)stopFollowing();
    },{passive:true});
    window.addEventListener('keydown',(event)=>{
      if(!['PageDown','PageUp','ArrowDown','ArrowUp','Home','End',' '].includes(event.key))return;
      if(event.target instanceof Element&&event.target.closest('button,input,select,textarea,summary,a,[contenteditable]'))return;
      stopFollowing();
    });
    // Chapter positions come from the approved MP3 manifests. The transcript
    // has no word timestamps, so its intra-chapter scroll is proportional rather
    // than pretending to be karaoke-style word synchronization.
    const updateTranscriptFollowLabel=()=>{
      if(!transcriptFollowButton)return;
      transcriptFollowButton.setAttribute('aria-pressed',String(transcriptFollowing));
      transcriptFollowButton.textContent=transcriptFollowing
        ? 'Défilement du texte : activé'
        : 'Reprendre le défilement du texte';
    };
    const updateTranscriptScroll=()=>{
      if(!audio||!mobileViewport.matches||!transcriptFollowing||!transcriptScroll
          ||!mobileSheet||mobileSheet.hidden
          ||mobileViews.find(view=>view.dataset.cookingMobileView==='transcript')?.hidden)return;
      const chapter=chapters[active];
      const duration=Math.max(1,chapter.endSec-chapter.startSec);
      const fraction=Math.max(0,Math.min(1,(audio.currentTime-chapter.startSec)/duration));
      const max=Math.max(0,transcriptScroll.scrollHeight-transcriptScroll.clientHeight);
      transcriptScroll.scrollTop=max*fraction;
    };
    const revealCurrentChapter=()=>{
      if(!mobileChapterView||mobileChapterView.hidden||!mobileSheet||mobileSheet.hidden)return;
      const button=mobileChapterButtons[active];
      if(!button)return;
      const container=mobileChapterView.getBoundingClientRect();
      const rect=button.getBoundingClientRect();
      mobileChapterView.scrollTop+=rect.top-container.top-(container.height-rect.height)/2;
    };
    transcriptFollowButton?.addEventListener('click',()=>{
      transcriptFollowing=!transcriptFollowing;
      updateTranscriptFollowLabel();
      if(transcriptFollowing)updateTranscriptScroll();
    });
    const stopTranscriptFollowing=()=>{
      if(!transcriptFollowing)return;
      transcriptFollowing=false;
      updateTranscriptFollowLabel();
      // Only the text scroll stops; the MP3 and page following continue.
    };
    transcriptScroll?.addEventListener('touchmove',stopTranscriptFollowing,{passive:true});
    transcriptScroll?.addEventListener('wheel',stopTranscriptFollowing,{passive:true});
    transcriptScroll?.addEventListener('keydown',event=>{
      if(['ArrowDown','ArrowUp','PageDown','PageUp','Home','End',' '].includes(event.key))stopTranscriptFollowing();
    });
    const activate=(index:number)=>{
      if(index<0||index>=chapters.length)return;
      active=index;
      buttons.forEach((button,i)=>i===index?button.setAttribute('aria-current','true'):button.removeAttribute('aria-current'));
      mobileChapterButtons.forEach((button,i)=>i===index?button.setAttribute('aria-current','true'):button.removeAttribute('aria-current'));
      if(status)status.textContent='Chapitre '+(index===0?'introduction':index)+' : '+chapters[index].title;
      if(transcript)transcript.textContent=chapters[index].text;
      if(sheetTranscript)sheetTranscript.textContent=chapters[index].text;
      if(transcriptScroll&&transcriptFollowing)transcriptScroll.scrollTop=0;
      revealCurrentChapter();
      updateTranscriptScroll();
      if(following)scrollToChapter(index);
      updateMobileDock();
    };
    const jumpToChapter=(i:number)=>{
      if(!audio)return;
      audio.currentTime=chapters[i].startSec;
      activate(i);
      void audio.play().catch(()=>{
        if(status)status.textContent='Chapitre sélectionné. Appuyez sur Lecture pour démarrer.';
      });
    };
    buttons.forEach((button,i)=>button.addEventListener('click',()=>jumpToChapter(i)));
    mobileChapterButtons.forEach((button,i)=>button.addEventListener('click',()=>{
      jumpToChapter(i);
      closeMobileSheet();
    }));
    audio?.addEventListener('timeupdate',()=>{
      let index=0;
      for(let i=1;i<chapters.length;i++)if(audio.currentTime+0.02>=chapters[i].startSec)index=i;
      if(active!==index)activate(index);
      else updateMobileDock();
      updateTranscriptScroll();
    });
    audio?.addEventListener('error',()=>{
      if(status)status.textContent='Audio momentanément indisponible. Les instructions écrites restent accessibles.';
      audioStarted=false;
      updateMobileDock();
    });
    renderFollow();
    updateTranscriptFollowLabel();
    updateMobileDock();
  });
</script>
<style>
  .guided-cooking-audio{box-sizing:border-box;max-width:100%;margin:35px 0 55px;border:1px solid #dbc9a8;border-radius:14px;background:#fcf8ed;padding:clamp(19px,3vw,36px);color:#322b21}
  .guided-cooking-audio *{box-sizing:border-box}
  .guided-cooking-audio-head{display:flex;align-items:start;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:19px}
  .guided-cooking-eyebrow{font-size:11px;text-transform:uppercase;font-weight:750;letter-spacing:.1em;color:#77501c}
  .guided-cooking-audio h2{font:400 clamp(1.5rem,3vw,2.2rem)/1.18 Georgia,serif;margin:7px 0}
  .guided-cooking-audio-head p{margin:0 0 10px;font-size:14px}
  .guided-cooking-review{color:#685331;font-weight:700}
  .guided-cooking-audio audio{display:block;width:100%;margin:18px 0}
  .guided-cooking-chapter-list{list-style:none;margin:15px 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:9px}
  .guided-cooking-chapter-list button{display:flex;gap:10px;align-items:center;text-align:left;width:100%;min-height:56px;background:#fff;border-radius:9px;border:1px solid #dac8aa;padding:11px;color:#302a20;cursor:pointer}
  .guided-cooking-chapter-list button[aria-current="true"]{border-color:#a77a34;background:#f4e6ce}
  .guided-cooking-chapter-list button strong{font-size:13px;line-height:1.35;flex:1}
  .guided-cooking-chapter-list button span,.guided-cooking-chapter-list button small{font-size:12px;color:#6d5839}
  .guided-cooking-chapter-list button:focus-visible,.guided-cooking-audio summary:focus-visible{outline:3px solid #987030;outline-offset:3px}
  .guided-cooking-transcript{border-top:1px solid #dbc8aa;padding-top:13px;margin-top:14px}
  .guided-cooking-transcript summary{font-weight:700;cursor:pointer;min-height:43px}
  .guided-cooking-transcript p{line-height:1.8}
  .guided-cooking-live{font-weight:750;font-size:13px}
  .guided-cooking-tip{font-size:13px;color:#635b51}
  .guided-cooking-follow-row{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:14px}
  .guided-cooking-follow-row button{min-height:48px;padding:10px 15px;border-radius:24px;border:1px solid #8a632b;background:#fff;color:#443018;cursor:pointer;font-weight:700}
  .guided-cooking-follow-row button[aria-pressed="true"]{background:#f3dfb0;border-color:#77501c}
  .guided-cooking-follow-row button:focus-visible{outline:3px solid #987030;outline-offset:3px}
  .guided-cooking-follow-row p{margin:0;font-size:13px;color:#635b51;flex:1;min-width:200px}
  .guided-cooking-mobile-dock{display:none}
  @media(max-width:760px){
    .guided-cooking-mobile-dock[data-visible="true"]{display:flex;position:fixed;z-index:80;left:0;right:0;bottom:0;align-items:center;gap:9px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));min-height:72px;background:#f9eed9;border-top:1px solid #bda57d;box-shadow:0 -6px 24px #30231333}
    .guided-cooking-mobile-dock button{min-width:44px;min-height:46px;border:1px solid #9f7c4d;border-radius:10px;background:#fff;color:#3f2f1d;font-size:17px;cursor:pointer}
    .guided-cooking-mobile-dock [data-cooking-mobile-play]{background:#f1ca62;font-size:22px;font-weight:bold}
    .guided-cooking-mobile-dock [data-cooking-mobile-follow],.guided-cooking-mobile-dock [data-cooking-mobile-steps]{font-size:11px;padding:5px;max-width:78px;min-width:48px}
    .guided-cooking-mobile-dock [data-cooking-mobile-follow][aria-pressed="true"]{background:#e3c589}
    .guided-cooking-mobile-caption{display:flex;flex:1;min-width:0;flex-direction:column}
    .guided-cooking-mobile-caption span{font-size:11px;color:#755a39}
    .guided-cooking-mobile-caption strong{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:13px;color:#302719}
    .guided-cooking-mobile-dock button:focus-visible{outline:3px solid #856229;outline-offset:2px}
    .guided-cooking-mobile-dock{gap:5px;padding-inline:7px}
