---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout title="Crédits photos | Cuisine du Cambodge" description="Sources, auteurs et licences des photographies utilisées sur Cuisine du Cambodge.">
  <SiteHeader />
  <main class="credits-page">
    <header class="page-intro">
      <p class="eyebrow">Transparence</p>
      <h1>Crédits photos</h1>
      <p>Les photographies de cette première version immersive proviennent de Wikimedia Commons et sont utilisées selon leurs licences Creative Commons.</p>
    </header>
    <div class="credits-list">
      <article><h2>Fish Amok — Khmer specialty</h2><p>Photo : Ben Yapp · CC BY 2.0.</p><a href="https://commons.wikimedia.org/wiki/File:Fish_Amok-_Khmer_specialty.jpg" target="_blank" rel="noreferrer">Source et licence</a></article>
      <article><h2>Fish amok / amok trei</h2><p>Photo : MoonsMoon · CC BY 4.0.</p><a href="https://commons.wikimedia.org/wiki/File:Fish_amok_amok_trei_Khmer_Cambodian_food.jpg" target="_blank" rel="noreferrer">Source et licence</a></article>
      <article><h2>Kep Crab Market</h2><p>Photo : PsamatheM · CC BY-SA 4.0.</p><a href="https://commons.wikimedia.org/wiki/File:06-Kep_Crab_Market_Cambodia-nX-3_(cropped).jpg" target="_blank" rel="noreferrer">Source et licence</a></article>
      <article><h2>Kampot Pepper</h2><p>Photo : Thalias · CC BY-SA 4.0.</p><a href="https://commons.wikimedia.org/wiki/File:Kampot_Pepper.jpg" target="_blank" rel="noreferrer">Source et licence</a></article>
          <article><h2>Cambodian Lok Lak</h2><p>Photo : Stefan Fussan · CC BY-SA 3.0.</p><a href="https://commons.wikimedia.org/wiki/File:Cambodian_Lok_Lak.jpg" target="_blank" rel="noreferrer">Source et licence</a></article>
      <article><h2>Cha kroeung</h2><p>Photo : Thomas Wanhoff · CC BY-SA 2.0.</p><a href="https://commons.wikimedia.org/wiki/File:Cha_kroeung.jpg" target="_blank" rel="noreferrer">Source et licence</a></article>
      <article><h2>Tamarind fruit</h2><p>Photo : Susan Slater · CC BY-SA 4.0.</p><a href="https://commons.wikimedia.org/wiki/File:Tamarind_fruit_(Tamarindus_indica).jpg" target="_blank" rel="noreferrer">Source et licence</a></article>
      <article><h2>Prahok ktis</h2><p>Photo : Thomas Wanhoff · CC BY-SA 2.0.</p><a href="https://commons.wikimedia.org/wiki/File:Prahok_ktis.jpg" target="_blank" rel="noreferrer">Source et licence</a></article>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
