---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { imageSrcSet } from '../../utils/images';
---
<BaseLayout title="Apprendre la cuisine cambodgienne | Cuisine du Cambodge" description="Guides, e-book Fusion Khmère et future masterclass consacrée au kroeung et à l'amok.">
  <SiteHeader />
  <main class="listing-page editorial-listing learn-listing">
    <header class="page-intro page-intro-split" data-reveal="up">
      <p class="eyebrow">Transmission</p>
      <h1>Apprendre en cuisinant</h1>
      <p>Commencer par un bon kroeung, réussir un amok, apprendre à équilibrer coco, acidité, sel et aromates : des formats conçus pour cuisiner davantage, pas pour accumuler de la théorie.</p>
      <div class="page-intro-visual" data-parallax="0.10"><img src="https://commons.wikimedia.org/wiki/Special:FilePath/Fish_amok_amok_trei_Khmer_Cambodian_food.jpg?width=1600" srcset={imageSrcSet('https://commons.wikimedia.org/wiki/Special:FilePath/Fish_amok_amok_trei_Khmer_Cambodian_food.jpg?width=1600', [800, 1200, 1600])} sizes="(max-width: 900px) 100vw, 58vw" alt="Amok trei cambodgien présenté dans des feuilles" fetchpriority="high" decoding="async" /></div>
    </header>
    <section class="learn-path" aria-labelledby="learn-path-title" data-reveal="up">
      <div class="learn-path-head">
        <p class="eyebrow">Commencer ici</p>
        <h2 id="learn-path-title">Trois étapes pour entrer dans la cuisine khmère.</h2>
      </div>
      <div class="learn-path-steps">
        <a href="/ingredients/kroeung/">
          <span>01</span>
          <strong>Comprendre le kroeung</strong>
          <em>Les aromates, le rôle de la pâte et les gestes qui changent tout.</em>
        </a>
        <a href="/recettes/kroeung-jaune/">
          <span>02</span>
          <strong>Préparer une base</strong>
          <em>Citronnelle, galanga, curcuma et combava : passer de la théorie au mortier.</em>
        </a>
        <a href="/recettes/amok-trey/">
          <span>03</span>
          <strong>Cuisiner l’Amok Trey</strong>
          <em>Mettre le kroeung en pratique dans une cuisson douce et parfumée.</em>
        </a>
      </div>
    </section>

    <section class="offer-grid" data-reveal="up">
      <article>
        <p class="card-meta">E-book · en préparation</p>
        <h2>Fusion Khmère</h2>
        <p>Des recettes qui partent des parfums khmers — kroeung, coco, tamarin, poivre — pour créer des assiettes simples, généreuses et modernes.</p>
      </article>
      <article>
        <p class="card-meta">Masterclass · en préparation</p>
        <h2>Kroeung & Amok</h2>
        <p>Préparer un kroeung très parfumé, obtenir une texture d’amok douce et soyeuse, ajuster le coco, le sel et les aromates jusqu’au bon équilibre.</p>
      </article>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
