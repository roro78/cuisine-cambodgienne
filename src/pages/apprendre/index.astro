---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CulinaryIcon from '../../components/CulinaryIcon.astro';
import '../../styles/v16-editorial.css';

const workshops = [
  {
    n:'01', icon:'prep' as const, eyebrow:'Le mortier', title:'Transformer des aromates en parfum',
    duration:'45 min', level:'Débutant',
    objective:'Comprendre ce que le pilage change réellement dans une base aromatique.',
    experiments:[
      'Sentir une tige de citronnelle entière, puis coupée très finement.',
      'Comparer la résistance du galanga et du curcuma sous le pilon.',
      'Piler par petites quantités et observer le moment où les parfums commencent à se fondre.'
    ],
    takeaway:'Vous saurez reconnaître une pâte assez travaillée au toucher et au parfum.',
    link:'/glossaire/#kroeung', linkLabel:'Comprendre le kroeung'
  },
  {
    n:'02', icon:'taste' as const, eyebrow:'L’équilibre', title:'Goûter avant de corriger',
    duration:'30 min', level:'Débutant',
    objective:'Apprendre à identifier ce qui manque vraiment : sel, acidité, douceur ou umami.',
    experiments:[
      'Préparer quatre petites bases identiques et ne modifier qu’un seul axe à la fois.',
      'Ajouter le tamarin goutte à goutte pour sentir le passage de plat à vif.',
      'Comparer une correction au sucre avec une correction au sel sans toucher au reste.'
    ],
    takeaway:'Vous corrigerez une sauce avec une intention plutôt qu’en ajoutant tout à la fois.',
    link:'/glossaire/#tamarin', linkLabel:'Voir le tamarin'
  },
  {
    n:'03', icon:'cook' as const, eyebrow:'Le feu', title:'Saisir sans faire bouillir',
    duration:'35 min', level:'Débutant',
    objective:'Voir pourquoi une poêle chaude, sèche et peu chargée change complètement la texture.',
    experiments:[
      'Comparer une petite quantité et une poêle surchargée.',
      'Observer le bruit, la vapeur et la coloration pendant les trente premières secondes.',
      'Ajouter une sauce seulement après coloration et regarder la différence.'
    ],
    takeaway:'Vous saurez lire une poêle avant même de regarder le minuteur.',
    link:'/recettes/lok-lak/', linkLabel:'Mettre le geste en pratique'
  },
  {
    n:'04', icon:'taste' as const, eyebrow:'Les herbes', title:'Construire la fraîcheur',
    duration:'25 min', level:'Débutant',
    objective:'Comprendre comment herbes, agrumes et crudités peuvent alléger un plat sans le diluer.',
    experiments:[
      'Goûter une même bouchée sans herbe, puis avec coriandre ou menthe.',
      'Comparer zeste, jus et feuille aromatique : trois intensités très différentes.',
      'Ajouter la fraîcheur à la fin pour préserver parfum et croquant.'
    ],
    takeaway:'Vous apprendrez à créer du contraste plutôt qu’à ajouter un nouvel assaisonnement lourd.',
    link:'/glossaire/#combava', linkLabel:'Découvrir le combava'
  },
  {
    n:'05', icon:'cook' as const, eyebrow:'Le bouillon', title:'Donner de la profondeur sans lourdeur',
    duration:'50 min', level:'Intermédiaire',
    objective:'Construire un bouillon clair qui reste léger tout en ayant du relief.',
    experiments:[
      'Goûter le bouillon avant et après réduction pour sentir la concentration.',
      'Ajouter les éléments salés progressivement plutôt qu’en début de cuisson.',
      'Finir avec herbes et agrumes hors du feu pour préserver les notes fraîches.'
    ],
    takeaway:'Vous saurez distinguer intensité et lourdeur.',
    link:'/recettes/kuy-teav/', linkLabel:'Observer le geste dans un bol'
  },
  {
    n:'06', icon:'servings' as const, eyebrow:'La table', title:'Composer un repas qui respire',
    duration:'20 min', level:'Tous niveaux',
    objective:'Penser le repas comme un ensemble de contrastes plutôt que comme une succession entrée-plat-dessert.',
    experiments:[
      'Partir du riz et ajouter un seul élément riche.',
      'Ajouter ensuite une fraîcheur végétale ou acide.',
      'Tester plusieurs bouchées en variant sauce, herbes et condiment.'
    ],
    takeaway:'Vous verrez comment quelques éléments simples peuvent créer beaucoup de combinaisons.',
    link:'/culture/construire-repas-cambodgien/', linkLabel:'Lire le carnet sur la table'
  }
];

const schema = {
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Ateliers de cuisine cambodgienne',
  description:'Six ateliers pratiques pour apprendre les gestes, les équilibres, le feu, les herbes, le bouillon et la composition d’une table cambodgienne.',
  url:'https://www.cuisine-du-cambodge.com/apprendre/',
  inLanguage:'fr-FR'
};
---
<BaseLayout
  title="Ateliers de cuisine cambodgienne : apprendre les gestes"
  description="Six ateliers pratiques pour apprendre la cuisine cambodgienne par les gestes, les sensations, le feu, les herbes, le bouillon et la table."
>
  <SiteHeader />
  <main class="v16-editorial v16-workshops">
    <header class="v16-page-hero v16-page-hero--workshops">
      <p class="v16-page-kicker">Les ateliers</p>
      <h1>On n’apprend pas une cuisine en mémorisant des recettes.</h1>
      <p>On apprend à sentir, regarder, goûter et corriger. Ici, chaque atelier isole un geste ou une sensation pour que vous puissiez vraiment comprendre ce qui se passe dans la casserole.</p>
      <div class="v16-hero-index" aria-label="Principes des ateliers">
        <span>sentir</span><span>goûter</span><span>observer</span><span>recommencer</span>
      </div>
    </header>

    <section class="v16-workshop-intro">
      <div>
        <p class="v16-page-kicker">La méthode</p>
        <h2>Une expérience courte vaut mieux qu’une longue théorie.</h2>
      </div>
      <p>Chaque atelier vous donne un objectif, quelques expériences simples et un repère à mémoriser. Une recette peut ensuite servir de terrain de jeu, mais elle n’est jamais le cours lui-même.</p>
    </section>

    <section class="v16-workshop-list" aria-label="Les six ateliers">
      {workshops.map((workshop, index) => (
        <article class="v16-workshop" id={'atelier-' + workshop.n} data-reveal="up">
          <div class="v16-workshop-number">{workshop.n}</div>
          <div class="v16-workshop-main">
            <div class="v16-workshop-topline">
              <p><CulinaryIcon name={workshop.icon} size={18} /> {workshop.eyebrow}</p>
              <span>{workshop.duration} · {workshop.level}</span>
            </div>
            <h2>{workshop.title}</h2>
            <p class="v16-workshop-objective">{workshop.objective}</p>
            <div class="v16-workshop-experiments">
              <p class="v16-mini-label">À expérimenter</p>
              <ol>{workshop.experiments.map((item) => <li>{item}</li>)}</ol>
            </div>
            <blockquote>
              <span>À retenir</span>
              <p>{workshop.takeaway}</p>
            </blockquote>
            <a href={workshop.link}>{workshop.linkLabel} →</a>
          </div>
          <div class:list={['v16-workshop-mark', 'mark-' + ((index % 4) + 1)]} aria-hidden="true"></div>
        </article>
      ))}
    </section>

    <section class="v16-workshop-rules">
      <article><span>01</span><h2>Une seule variable à la fois.</h2><p>Sinon, impossible de comprendre ce qui a réellement amélioré le goût ou la texture.</p></article>
      <article><span>02</span><h2>Le minuteur ne sait pas tout.</h2><p>La couleur, l’odeur, la vapeur et la résistance sous la cuillère donnent souvent de meilleurs repères.</p></article>
      <article><span>03</span><h2>Recommencer fait partie de l’atelier.</h2><p>La deuxième tentative sert à corriger. La troisième commence à devenir un geste.</p></article>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <SiteFooter />
</BaseLayout>
