---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EditorialSectionHero from '../../components/EditorialSectionHero.astro';
import CulinaryIcon from '../../components/CulinaryIcon.astro';
import { workshops } from '../../data/workshops';
import { releasedCookingWorkshopGuides } from '../../data/cookingWorkshopGuides';
import { recipes } from '../../data/recipes';
const workshopPhotos: Record<string,string> = {
'piler-aromates-au-mortier':'/images/cuisine/v17-mortar-hands-1600.jpg',
'equilibrer-une-sauce':'/images/cuisine/tamarind-1600.webp',
'saisir-viande-poele':'/images/cuisine/v17-lok-lak-genere.webp',
'fraicheur-herbes-agrumes':'/images/cuisine/v17-fruit-market-1920.jpg',
'bouillon-leger-savoureux':'/images/cuisine/v18-kuy-teav.webp',
'composer-repas-cambodgien':'https://upload.wikimedia.org/wikipedia/commons/thumb/c/c8/Cambodia%27s_rice_fields.jpg/1280px-Cambodia%27s_rice_fields.jpg'
};
import '../../styles/v16-editorial.css';
import '../../styles/v19-premium-pages.css';
import '../../styles/editorial-shared-hero.css';

const schema = {
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Ateliers de cuisine cambodgienne',
  description:'Six ateliers pratiques pour apprendre les gestes, les équilibres, le feu, les herbes, le bouillon et la composition d’une table cambodgienne.',
  url:'https://www.cuisine-du-cambodge.com/apprendre/',
  inLanguage:'fr-FR'
};
---
<BaseLayout
  title="Ateliers de cuisine cambodgienne : apprendre les gestes"
  description="Six ateliers pratiques pour apprendre la cuisine cambodgienne par les gestes, les sensations, le feu, les herbes, le bouillon et la table."
>
  <SiteHeader />
  <main class="v16-editorial v16-workshops">
    <EditorialSectionHero
      kicker="Les ateliers"
      title="Les gestes qui donnent du goût."
      description="Un mortier, quelques aromates, une sauce à goûter ou une poêle à surveiller : apprenez les gestes de la cuisine cambodgienne en les essayant vous-même."
      image="/images/cuisine/v17-mortar-hands-1600.jpg"
      imageWidth={1600}
      imageHeight={1067}
    />

    <section class="v19-workshop-steps" aria-labelledby="v19-workshop-steps-title">
      <div class="v19-section-intro"><p class="v16-page-kicker">Les gestes en images</p><h2 id="v19-workshop-steps-title">Apprendre un geste, étape par étape.</h2></div>
      <div class="v19-workshop-steps-grid">
        <article><figure><img src="/images/cuisine/v17-galangal-1000.jpg" width="1000" height="667" alt="Aromates frais avant préparation" loading="lazy" /></figure><span>01 / PRÉPARER</span><h3>Choisir ses aromates</h3><p>Couper, sentir et reconnaître les parfums avant de commencer.</p></article>
        <article><figure><img src="/images/cuisine/v17-mortar-hands-1600.jpg" width="1600" height="1067" alt="Des mains travaillent les aromates au mortier" loading="lazy" /></figure><span>02 / PRATIQUER</span><h3>Travailler la texture</h3><p>Piler progressivement et observer la pâte qui se transforme.</p></article>
        <article><figure><img src="/images/cuisine/v17-table-meal-1600.jpg" width="1600" height="1067" alt="Plusieurs plats réunis pour un repas" loading="lazy" /></figure><span>03 / GOÛTER</span><h3>Trouver l'équilibre</h3><p>Goûter, ajuster et assembler les saveurs avant de servir.</p></article>
      </div>
    </section>
    <section class="v16-workshop-intro">
      <div>
        <p class="v16-page-kicker">La méthode</p>
        <h2>C’est en cuisinant qu’on apprend les bons gestes.</h2>
      </div>
      <p>Dans chaque atelier, vous faites un geste, vous regardez ce qui change, puis vous recommencez. C’est la meilleure façon de le réussir ensuite dans une vraie recette.</p>
    </section>

    {releasedCookingWorkshopGuides.length>0 && (
      <section class="v16-workshop-list" aria-label="Ateliers de cuisine complets">
        <div class="v19-section-intro"><p class="v16-page-kicker">Ateliers complets</p><h2>Préparez une vraie recette, du premier ingrédient au service.</h2></div>
        {releasedCookingWorkshopGuides.map((guide, i) => {
          const recipe=recipes.find(item=>item.slug===guide.sourceRecipeSlug);
          return <article class="v16-workshop" data-reveal="up">
            <div class="v16-workshop-number">{String(i+1).padStart(2,'0')}</div>
            <div class="v16-workshop-main">
              <div class="v16-workshop-topline"><p><CulinaryIcon name="cook" size={18}/> Atelier pratique</p>
                <span>{guide.duration.practicalMinutes} min · {guide.difficulty}</span></div>
              <h2>{guide.title}</h2>
              <p class="v16-workshop-objective">{guide.finalPreparation}</p>
              <a href={guide.sourceRecipeSlug==='kroeung-jaune' ? '/apprendre/pratique/kroeung-jaune/' : '/apprendre/pratique/'+guide.slug+'/'}>Réaliser cet atelier →</a>
            </div>
            {recipe?.image && <figure class="v19-workshop-shot"><img src={guide.media.finishedPreparationImage || recipe.image} alt={guide.finalPreparation} loading="lazy" width={recipe.imageWidth??1200} height={recipe.imageHeight??800}/></figure>}
          </article>;
        })}
      </section>
    )}

    <section class="v16-workshop-list" aria-label="Les six ateliers">
      {workshops.map((workshop) => (
        <article class="v16-workshop" id={'atelier-' + workshop.n} data-reveal="up">
          <div class="v16-workshop-number">{workshop.n}</div>
          <div class="v16-workshop-main">
            <div class="v16-workshop-topline">
              <p><CulinaryIcon name={workshop.icon} size={18} /> {workshop.eyebrow}</p>
              <span>{workshop.duration} · {workshop.level}</span>
            </div>
            <h2>{workshop.title}</h2>
            <p class="v16-workshop-objective">{workshop.objective}</p>
            <div class="v16-workshop-experiments">
              <p class="v16-mini-label">À essayer</p>
              <ol>{workshop.experiments.map((item) => <li>{item}</li>)}</ol>
            </div>
            <blockquote>
              <span>À retenir</span>
              <p>{workshop.takeaway}</p>
            </blockquote>
            <a href={`/apprendre/${workshop.slug}/`}>Commencer l’atelier →</a>
          </div>
          <figure class="v19-workshop-shot"><img src={workshopPhotos[workshop.slug]} alt="" loading="lazy" decoding="async" width="1200" height="800" /></figure>
        </article>
      ))}
    </section>

    <section class="v16-workshop-rules">
      <article><span>01</span><h2>Changez une seule chose à la fois.</h2><p>Vous sentirez beaucoup mieux ce qui améliore vraiment le goût ou la texture.</p></article>
      <article><span>02</span><h2>Regardez, sentez, goûtez.</h2><p>Regardez la couleur, sentez les parfums et observez la texture : c’est ainsi qu’on reconnaît une préparation qui évolue. Respectez toutefois les règles de cuisson des aliments.</p></article>
      <article><span>03</span><h2>Recommencez sans chercher la perfection.</h2><p>Au deuxième essai, vous saurez déjà ce que vous pouvez améliorer.</p></article>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <SiteFooter />
</BaseLayout>
