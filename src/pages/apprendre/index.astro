---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
---
<BaseLayout title="Apprendre la cuisine cambodgienne | Cuisine du Cambodge" description="Guides, e-book Fusion Khmère et future masterclass consacrée au kroeung et à l'amok.">
  <SiteHeader />
  <main class="listing-page">
    <header class="page-intro">
      <p class="eyebrow">Transmission</p>
      <h1>Aller plus loin</h1>
      <p>Des formats plus complets pour comprendre les techniques et devenir autonome en cuisine cambodgienne.</p>
    </header>
    <section class="offer-grid">
      <article>
        <p class="card-meta">E-book · en préparation</p>
        <h2>Fusion Khmère</h2>
        <p>Une approche contemporaine qui part des saveurs et techniques cambodgiennes pour créer sans les dénaturer.</p>
      </article>
      <article>
        <p class="card-meta">Masterclass · en préparation</p>
        <h2>Kroeung & Amok</h2>
        <p>Maîtriser la base aromatique, comprendre les équilibres et construire un amok du début à la fin.</p>
      </article>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
