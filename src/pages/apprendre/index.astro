---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import GlossaryStrip from '../../components/GlossaryStrip.astro';
import CulinaryIcon from '../../components/CulinaryIcon.astro';
import { getGlossaryEntries } from '../../data/glossary';
import { imageSrcSet } from '../../utils/images';

const lessons = [
  {
    n: '01',
    eyebrow: 'Le mortier',
    title: 'Faire un kroeung qui sent vraiment la citronnelle.',
    intro: 'Avant les currys et les sauces, il faut apprendre à transformer des tiges et des racines en une pâte souple, humide et très parfumée.',
    objective: 'Obtenir une pâte où la citronnelle n’est plus fibreuse et où les parfums commencent à se fondre.',
    do: ['Émincer très finement la citronnelle et le galanga.', 'Piler d’abord les fibres dures.', 'Ajouter curcuma, combava, ail et échalote progressivement.'],
    taste: 'À sentir : citronnelle fraîche d’abord, puis galanga, agrume et curcuma qui deviennent un parfum plus unifié.',
    href: '/recettes/kroeung-jaune/',
    cta: 'Faire le kroeung jaune',
    image: '/images/cuisine/kroeung-1600.webp',
    widths: [480, 800, 1200, 1600],
    alt: 'Préparation cambodgienne parfumée au kroeung'
  },
  {
    n: '02',
    eyebrow: 'L’équilibre',
    title: 'Goûter le salé, l’acide, le sucré et l’umami.',
    intro: 'Une sauce réussie ne doit pas seulement être « forte ». Elle doit avoir un point d’équilibre où aucune saveur n’écrase complètement les autres.',
    objective: 'Savoir corriger une sauce en identifiant ce qui manque au lieu d’ajouter des ingrédients au hasard.',
    do: ['Commencer avec une petite quantité de tamarin ou de citron vert.', 'Ajouter sel ou fermentation par petites touches.', 'Arrondir si besoin avec un peu de sucre de palme.'],
    taste: 'À goûter : l’acidité doit réveiller, le sel donner du relief et le sucre arrondir sans rendre la sauce sucrée.',
    href: '/ingredients/tamarin/',
    cta: 'Comprendre le tamarin',
    image: '/images/cuisine/tamarind-1600.webp',
    widths: [480, 800, 1200, 1600],
    alt: 'Gousses de tamarin ouvertes'
  },
  {
    n: '03',
    eyebrow: 'Le feu',
    title: 'Saisir vite ou cuire doucement : choisir le bon geste.',
    intro: 'Le lok lak et l’amok racontent presque l’inverse : l’un demande une poêle très chaude et quelques minutes, l’autre une chaleur douce qui laisse la texture prendre.',
    objective: 'Comprendre que la température est un ingrédient : elle décide de la texture autant que la sauce.',
    do: ['Pour le bœuf, travailler en petites quantités sur feu vif.', 'Pour l’amok, éviter l’ébullition agressive.', 'Observer la texture avant de regarder l’horloge.'],
    taste: 'À chercher : bœuf coloré et juteux d’un côté, poisson tendre et préparation moelleuse de l’autre.',
    href: '/recettes/lok-lak/',
    cta: 'Pratiquer avec le Lok Lak',
    image: '/images/cuisine/lok-lak-800.webp',
    widths: [480, 800],
    alt: 'Lok lak cambodgien au bœuf'
  },
  {
    n: '04',
    eyebrow: 'Assembler',
    title: 'Réussir un Amok Trey sans perdre les parfums.',
    intro: 'C’est l’exercice qui réunit tout : un kroeung fin, une base équilibrée, du coco pour la rondeur et une cuisson douce pour garder le poisson tendre.',
    objective: 'Obtenir un amok pris mais souple, parfumé sans être lourd et suffisamment assaisonné avant même la cuisson.',
    do: ['Goûter la base avant d’ajouter le poisson.', 'Répartir en portions régulières.', 'Cuire doucement puis terminer avec herbes et coco.'],
    taste: 'À chercher : coco soyeux, kroeung net, poisson tendre, finale fraîche de combava et d’herbes.',
    href: '/recettes/amok-trey/',
    cta: 'Cuisiner l’Amok Trey',
    image: '/images/cuisine/amok-1600.webp',
    widths: [480, 800, 1200, 1600],
    alt: 'Amok cambodgien servi avec du riz'
  }
];

const pantry = [
  ['Citronnelle', 'Fraîcheur et structure du kroeung'],
  ['Galanga', 'Chaleur boisée et camphrée'],
  ['Combava', 'Zeste et feuilles très parfumés'],
  ['Tamarin', 'Acidité ronde et fruitée'],
  ['Prahok', 'Sel, fermentation et umami'],
  ['Poivre de Kampot', 'Chaleur et longueur aromatique']
];

const glossary = getGlossaryEntries(['kroeung', 'citronnelle', 'galanga', 'combava', 'tamarin', 'prahok', 'poivre-de-kampot', 'amok']);

const learningSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Parcours pour apprendre la cuisine cambodgienne',
  description: 'Quatre leçons pratiques pour apprendre le kroeung, les équilibres de saveurs, les cuissons et l’amok.',
  itemListElement: lessons.map((lesson, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: lesson.title,
    url: new URL(lesson.href, Astro.site ?? new URL('https://www.cuisine-du-cambodge.com')).href
  }))
};
---
<BaseLayout
  title="Apprendre la cuisine cambodgienne : 4 leçons pratiques"
  description="Apprendre la cuisine cambodgienne en cuisinant : kroeung au mortier, équilibre des saveurs, cuisson du lok lak et amok trei étape par étape."
  image="/images/cuisine/kroeung-1600.webp"
  imageAlt="Kroeung cambodgien et aromates"
>
  <SiteHeader />
  <main class="listing-page editorial-listing learn-listing learn-v12">
    <header class="page-intro page-intro-split" data-reveal="up">
      <p class="eyebrow">Apprendre avec les mains</p>
      <h1>Sentir, goûter, piler, saisir.</h1>
      <p>Pas de cours théorique interminable. On apprend la cuisine khmère en faisant quatre gestes, avec à chaque fois un objectif clair, un repère sensoriel et une recette pour pratiquer.</p>
      <div class="page-intro-visual" data-parallax="0.07">
        <img src="/images/cuisine/kroeung-1600.webp" srcset={imageSrcSet('/images/cuisine/kroeung-1600.webp', [480, 800, 1200, 1600])} sizes="(max-width: 900px) 100vw, 52vw" alt="Préparation cambodgienne à base de kroeung" width="5184" height="3456" fetchpriority="high" decoding="async" />
      </div>
    </header>

    <section class="learning-pantry" aria-labelledby="pantry-title" data-reveal="up">
      <header>
        <p class="eyebrow">Le petit garde-manger</p>
        <h2 id="pantry-title">Six saveurs à reconnaître avant de commencer.</h2>
        <p>Vous n’avez pas besoin de cinquante produits. Commencez par savoir ce que font ces six-là.</p>
      </header>
      <div class="learning-pantry-grid">
        {pantry.map(([name, role], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{name}</strong>
            <p>{role}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="learning-lessons" aria-label="Leçons de cuisine cambodgienne">
      {lessons.map((lesson, index) => (
        <article class:list={['learning-lesson', { 'learning-lesson--reverse': index % 2 === 1 }]} data-reveal="up">
          <figure class="learning-lesson-media" data-parallax="0.06">
            <img src={lesson.image} srcset={imageSrcSet(lesson.image, lesson.widths)} sizes="(max-width: 800px) 100vw, 46vw" alt={lesson.alt} loading="lazy" decoding="async" />
          </figure>
          <div class="learning-lesson-copy">
            <p class="eyebrow">{lesson.n} · {lesson.eyebrow}</p>
            <h2>{lesson.title}</h2>
            <p class="learning-lesson-intro">{lesson.intro}</p>

            <div class="learning-objective">
              <CulinaryIcon name="level" size={20} />
              <div><strong>Objectif</strong><p>{lesson.objective}</p></div>
            </div>

            <div class="learning-do">
              <strong>À faire</strong>
              <ul>{lesson.do.map((item) => <li>{item}</li>)}</ul>
            </div>

            <div class="learning-taste">
              <CulinaryIcon name="taste" size={20} />
              <p>{lesson.taste}</p>
            </div>

            <a class="text-link" href={lesson.href}>{lesson.cta}</a>
          </div>
        </article>
      ))}
    </section>

    <section class="learning-practice" data-reveal="up">
      <div>
        <p class="eyebrow">Votre premier menu d’entraînement</p>
        <h2>Trois préparations, trois compétences.</h2>
      </div>
      <a href="/recettes/kroeung-jaune/"><span>01</span><strong>Kroeung jaune</strong><em>Apprendre le mortier et les fibres.</em></a>
      <a href="/recettes/lok-lak/"><span>02</span><strong>Lok Lak</strong><em>Apprendre la saisie et l’assaisonnement minute.</em></a>
      <a href="/recettes/amok-trey/"><span>03</span><strong>Amok Trey</strong><em>Assembler les parfums et maîtriser la cuisson douce.</em></a>
    </section>

    <GlossaryStrip entries={glossary} />
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(learningSchema)} />
  <SiteFooter />
</BaseLayout>
