---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CulinaryIcon from '../../components/CulinaryIcon.astro';
import { workshops } from '../../data/workshops';
import '../../styles/v16-editorial.css';

const schema = {
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Ateliers de cuisine cambodgienne',
  description:'Six ateliers pratiques pour apprendre les gestes, les équilibres, le feu, les herbes, le bouillon et la composition d’une table cambodgienne.',
  url:'https://www.cuisine-du-cambodge.com/apprendre/',
  inLanguage:'fr-FR'
};
---
<BaseLayout
  title="Ateliers de cuisine cambodgienne : apprendre les gestes"
  description="Six ateliers pratiques pour apprendre la cuisine cambodgienne par les gestes, les sensations, le feu, les herbes, le bouillon et la table."
>
  <SiteHeader />
  <main class="v16-editorial v16-workshops">
    <header class="v16-page-hero v16-page-hero--workshops">
      <p class="v16-page-kicker">Les ateliers</p>
      <h1>Apprendre les bons gestes, simplement.</h1>
      <p>Ces ateliers sont faits pour mettre les mains en cuisine : sentir les aromates, goûter une sauce, observer une cuisson et recommencer jusqu’à trouver le bon geste.</p>
      <div class="v16-hero-index" aria-label="Principes des ateliers">
        <span>sentir</span><span>goûter</span><span>observer</span><span>recommencer</span>
      </div>
    </header>

    <section class="v16-workshop-intro">
      <div>
        <p class="v16-page-kicker">La méthode</p>
        <h2>On progresse surtout en goûtant et en recommençant.</h2>
      </div>
      <p>Chaque atelier propose quelques essais très simples. Pas besoin de préparer un plat complet : l’idée est de comprendre un geste, de voir la différence et de pouvoir le refaire ensuite dans vos recettes.</p>
    </section>

    <section class="v16-workshop-list" aria-label="Les six ateliers">
      {workshops.map((workshop, index) => (
        <article class="v16-workshop" id={'atelier-' + workshop.n} data-reveal="up">
          <div class="v16-workshop-number">{workshop.n}</div>
          <div class="v16-workshop-main">
            <div class="v16-workshop-topline">
              <p><CulinaryIcon name={workshop.icon} size={18} /> {workshop.eyebrow}</p>
              <span>{workshop.duration} · {workshop.level}</span>
            </div>
            <h2>{workshop.title}</h2>
            <p class="v16-workshop-objective">{workshop.objective}</p>
            <div class="v16-workshop-experiments">
              <p class="v16-mini-label">À essayer</p>
              <ol>{workshop.experiments.map((item) => <li>{item}</li>)}</ol>
            </div>
            <blockquote>
              <span>À retenir</span>
              <p>{workshop.takeaway}</p>
            </blockquote>
            <a href={`/apprendre/${workshop.slug}/`}>Commencer l’atelier →</a>
          </div>
          <div class:list={['v16-workshop-mark', 'mark-' + ((index % 4) + 1)]} aria-hidden="true"></div>
        </article>
      ))}
    </section>

    <section class="v16-workshop-rules">
      <article><span>01</span><h2>Changez une seule chose à la fois.</h2><p>Vous sentirez beaucoup mieux ce qui améliore vraiment le goût ou la texture.</p></article>
      <article><span>02</span><h2>Regardez, sentez, goûtez.</h2><p>La couleur, l’odeur, la vapeur et la texture donnent souvent plus d’informations qu’un minuteur.</p></article>
      <article><span>03</span><h2>Recommencez sans chercher la perfection.</h2><p>La deuxième fois, on corrige. La troisième, le geste devient déjà plus naturel.</p></article>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <SiteFooter />
</BaseLayout>
