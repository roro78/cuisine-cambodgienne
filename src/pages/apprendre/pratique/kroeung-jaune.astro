---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import CookingWorkshopAudio from '../../../components/CookingWorkshopAudio.astro';
import workshop from '../../../data/atelier-recette-guides/kroeung-jaune.json';
import { recipes } from '../../../data/recipes';
import type { RecipeIngredient } from '../../../data/recipes';

const recipe = recipes.find((item) => item.slug === workshop.sourceRecipeSlug);
if (!recipe) throw new Error('La recette Kroeung jaune manque : atelier impossible à compiler.');
// Each ingredient is displayed with a live-scaled numeric amount; the canonical source stays untouched.
const totalMinutes = workshop.duration.practicalMinutes + workshop.duration.preparationMinutes + workshop.duration.waitingMinutes;
const heroPicture = workshop.status==='release_ready' && workshop.media.finishedPreparationImage ? workshop.media.finishedPreparationImage : recipe.image;
const heroCaption = workshop.status==='release_ready' ? 'Photographie du kroeung jaune terminé.' : 'Visuel de la recette existante ; photo finale à valider.';
const recorded = import.meta.glob('../../../data/atelier-recette-audio/*.json', { eager:true, import:'default' }) as Record<string,{atelier:string;status:string;audioUrl:string;durationSec:number;chapters:{id:string;title:string;startSec:number;endSec:number}[];review:{acousticListening:boolean;mobile:boolean;desktop:boolean}}>;
const currentAsset=(workshop.audio as {asset?:{audioUrl:string;sha256:string}}).asset;
const guideAudio=workshop.audio.status==='script_only'||!currentAsset ? undefined
  : Object.values(recorded).find((manifest)=>
      manifest.atelier===workshop.slug && manifest.audioUrl===currentAsset.audioUrl && (manifest as {sha256?:string}).sha256===currentAsset.sha256);
const audioTexts=[workshop.audio.intro,...workshop.phases.map((phase)=>phase.audioScript)];
---
<BaseLayout
  title={workshop.title + ' — Atelier de cuisine | Cuisine du Cambodge'}
  description={workshop.learningGoal}
  noindex={workshop.status !== 'release_ready'}
>
  <SiteHeader />
  <main class="cooking-atelier">
    <nav class="atelier-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/apprendre/">← Tous les ateliers</a><span aria-hidden="true">/</span><span>Kroeung jaune au mortier</span>
    </nav>
    <header class="atelier-hero">
      <div class="atelier-hero-copy">
        <p class="eyebrow">Atelier pratique · Le mortier</p>
        <h1>{workshop.title}</h1>
        <p class="atelier-intro">{workshop.finalPreparation}</p>
        <p>{workshop.learningGoal}. Le résultat est une préparation complète, prête à parfumer un plat cuisiné.</p>
        <dl class="atelier-stats">
          <div><dt>Temps de préparation estimé</dt><dd>{totalMinutes} min</dd></div>
          <div><dt>Rendement</dt><dd data-workshop-servings-hero>{recipe.baseServings} petit pot</dd></div>
          <div><dt>Niveau</dt><dd>{workshop.difficulty}</dd></div>
        </dl>
        <div class="atelier-hero-links">
          <a class="atelier-action" href="#ingredients">Préparer les ingrédients <span aria-hidden="true">↘</span></a>
          <a href={'/recettes/' + recipe.slug + '/'}>Lire la fiche recette</a>
        </div>
        <p class="atelier-preview-note">Atelier en préproduction : narration approuvée à l’écoute ; photographie finale et contrôles mobile/ordinateur à valider avant publication.</p>
      </div>
      <figure class="atelier-hero-photo">
        <img src={heroPicture ?? '/images/cuisine/kroeung-1600.webp'} alt={workshop.status==='release_ready'?workshop.finalPreparation:(recipe.imageAlt ?? 'Pâte de kroeung et aromates frais')} width={recipe.imageWidth ?? 1200} height={recipe.imageHeight ?? 800} loading="eager" />
        <figcaption>{heroCaption}</figcaption>
      </figure>
    </header>

    <section class="atelier-goal" aria-labelledby="atelier-goal-title">
      <div><p class="eyebrow">Ce que vous allez préparer</p><h2 id="atelier-goal-title">Une véritable pâte de kroeung jaune.</h2></div>
      <p>Vous préparerez les aromates, apprendrez pourquoi les fibres se coupent finement et découvrirez comment leur texture évolue au mortier. À la fin, vous saurez reconnaître une pâte liée, fine et très parfumée.</p>
    </section>

    <section id="ingredients" class="atelier-section" aria-labelledby="atelier-ingredients-title" data-workshop-servings-root="" data-base-servings={recipe.baseServings} data-workshop-portion-kind="pot">
      <p class="eyebrow">01 · Tout réunir avant de cuisiner</p>
      <h2 id="atelier-ingredients-title">La liste des ingrédients et le matériel.</h2>
      <p>Les quantités sont reprises automatiquement de la <a href={'/recettes/' + recipe.slug + '/'}>recette Kroeung jaune</a>. L’atelier utilise exactement cette base.</p>
      <div class="atelier-servings" aria-label="Choisir le rendement en petits pots">
        <label for="kroeung-pot-count">Je prépare</label>
        <input id="kroeung-pot-count" data-workshop-servings-input type="number" min="1" max="12" step="1" value={recipe.baseServings} />
        <strong data-workshop-servings-summary aria-live="polite">1 petit pot</strong>
        <div>
          {[1,2,4,6].map(n=><button type="button" data-workshop-serving-preset={n} aria-pressed={n===recipe.baseServings?'true':'false'}>{n} pot{n>1?'s':''}</button>)}
        </div>
      </div>
      <div class="atelier-kit-grid">
        <div class="atelier-kit-panel">
          <h3>Ingrédients · quantités pour le rendement choisi</h3>
          <ul class="atelier-checklist">
            {recipe.ingredients.map((item) => (
              <li data-workshop-ingredient><label><input type="checkbox" /><span>
                {item.quantity!==undefined && <span data-workshop-ingredient-quantity="" data-base-quantity={item.quantity} data-unit={item.unit??''}>{item.quantity}</span>}
                {item.unit && ' '+item.unit} {item.name}
                {item.note && <small>{item.note}</small>}
              </span></label></li>
            ))}
          </ul>
        </div>
        <div class="atelier-preflight">
          <section><h3>Matériel</h3><ul>{workshop.equipment.map((item) => <li>{item}</li>)}</ul></section>
          <section><h3>Avant de commencer</h3><ul>{workshop.beforeStarting.map((item) => <li>{item}</li>)}</ul></section>
          {recipe.substitutions && recipe.substitutions.length>0 && (
            <section><h3>Remplacements possibles</h3><ul>{recipe.substitutions.map((item)=><li>{item}</li>)}</ul></section>
          )}
          <section><h3>À respecter</h3><ul>{workshop.safety.map((item) => <li>{item}</li>)}</ul>
            <p class="atelier-small">Allergènes : {workshop.allergens.status === 'none' ? 'aucun identifié dans cette recette ; vérifiez néanmoins les ingrédients utilisés.' : workshop.allergens.items.join(', ')}</p>
          </section>
        </div>
      </div>
    </section>

    <section id="etapes" class="atelier-section" aria-labelledby="atelier-steps-title">
      <p class="eyebrow">02 · Les six étapes de l’atelier</p>
      <h2 id="atelier-steps-title">Cuisinez, observez, rectifiez.</h2>
      <p>Les temps indiqués sont des estimations : poursuivez chaque préparation jusqu’à obtenir la bonne texture, même si vous avez besoin de quelques minutes de plus.</p>
      {guideAudio ? <CookingWorkshopAudio manifest={guideAudio} scripts={audioTexts} /> : <p class="atelier-audio-note">{workshop.review.editorialValidated ? "Textes validés. La nouvelle narration est en préparation : suivez la fiche écrite en attendant." : "La narration en sept chapitres est en préparation. La fiche reste utilisable par écrit."}</p>}
      <nav class="atelier-step-nav" aria-label="Naviguer entre les six étapes">
        {workshop.phases.map((phase, i) => (
          <a href={'#phase-' + phase.id}><span>{String(i + 1).padStart(2, '0')}</span><strong>{phase.title}</strong></a>
        ))}
      </nav>
      <div class="atelier-phases">
        {workshop.phases.map((phase, index) => (
          <article class="atelier-phase" id={'phase-' + phase.id} aria-labelledby={'phase-title-' + phase.id}>
            <div class="atelier-phase-heading">
              <span class="atelier-phase-number">{String(index + 1).padStart(2, '0')}</span>
              <div><p class="eyebrow">Étape {index + 1} sur 6 · environ {phase.minutes} min</p><h3 id={'phase-title-' + phase.id}>{phase.title}</h3></div>
            </div>
            <div class="atelier-phase-columns">
              <div>
                <h4>Ce que vous faites</h4>
                <ol class="atelier-actions">{phase.actions.map((action) => <li>{action}</li>)}</ol>
                {phase.ingredientNames.length > 0 && <p class="atelier-small"><strong>Ingrédients concernés :</strong> {phase.ingredientNames.join(' · ')}</p>}
              </div>
              <aside class="atelier-observe">
                <p class="eyebrow">Ce qu’il faut observer</p>
                <p>{phase.observe}</p>
                <h4>Comment savoir si c’est réussi ?</h4>
                <p>{phase.check}</p>
                <details><summary>Si le résultat n’est pas bon</summary><p><strong>Erreur fréquente :</strong> {phase.mistake}</p><p><strong>Comment corriger :</strong> {phase.recovery}</p></details>
              </aside>
            </div>
            <p class="atelier-learning"><strong>Pourquoi ce geste ?</strong> {phase.learning}</p>
            <p class="atelier-small"><strong>Précaution :</strong> {phase.safety}</p>
            {index < workshop.phases.length - 1 && <a class="atelier-next" href={'#phase-' + workshop.phases[index + 1].id}>Étape suivante <span aria-hidden="true">→</span></a>}
          </article>
        ))}
      </div>
    </section>

    <section class="atelier-finish" id="resultat" aria-labelledby="atelier-result-title">
      <p class="eyebrow">03 · Votre préparation terminée</p>
      <h2 id="atelier-result-title">Un petit pot de kroeung utilisable en cuisine.</h2>
      <p>La pâte se tient et ne comporte presque plus de longues fibres. Transférez-la dans un contenant propre et utilisez-la pour parfumer une préparation cuite. Le kroeung n’est pas un plat à déguster seul.</p>
      <p><strong>À retenir :</strong> couper fin, commencer par les fibres, piler par petites quantités, et juger la texture plutôt que le seul temps passé.</p>
      <a class="atelier-action" href="/recettes/amok-trey/">Utiliser le kroeung dans un Amok Trey <span aria-hidden="true">→</span></a>
    </section>
    <footer class="atelier-sources">
      <h2>Sources de l’atelier</h2>
      <p>Les ingrédients, proportions et gestes de base viennent de la <a href={'/recettes/' + recipe.slug + '/'}>recette Kroeung jaune</a>. Les critères d’observation et les exercices pédagogiques complètent cette préparation.</p>
      <p>Références culinaires et variantes consultées :</p>
      <ul>{workshop.sources.culinaryReferences.map(reference=>(<li><a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.title}</a></li>))}</ul>
      <a href="/apprendre/">← Retour aux ateliers</a>
    </footer>
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  import { initCookingWorkshopServings } from '../../../scripts/cookingWorkshopServings';
  initCookingWorkshopServings();
</script>
<style>
  .atelier-servings{display:flex;align-items:center;flex-wrap:wrap;gap:12px;padding:16px 20px;background:#fffaf0;border:1px solid #decba7;border-radius:12px;margin:20px 0}
  .atelier-servings label{font-weight:700}
  .atelier-servings input{width:76px;min-height:46px;font-size:18px;padding:6px}
  .atelier-servings div{display:flex;gap:7px;flex-wrap:wrap}
  .atelier-servings button{min-height:44px;border:1px solid #a88f64;border-radius:24px;background:white;padding:8px 14px}
  .atelier-servings button[aria-pressed='true']{background:#f1ca62}

  .cooking-atelier{--ink:#302e28;--border:#ddd4c6;--paper:#faf6ef;max-width:1340px;margin:auto;padding:125px clamp(18px,4.2vw,64px) 85px;color:var(--ink);line-height:1.65}
  .cooking-atelier *{box-sizing:border-box}
  .cooking-atelier a{color:#76531d;text-underline-offset:3px}
  .cooking-atelier :is(a,input,summary):focus-visible{outline:3px solid #aa771a;outline-offset:3px}
  .cooking-atelier h1,.cooking-atelier h2,.cooking-atelier h3{font-family:Georgia,serif;line-height:1.13;letter-spacing:-.02em;font-weight:400;color:#302a21}
  .cooking-atelier h1{font-size:clamp(2.6rem,5vw,5.1rem);margin:12px 0 18px}
  .cooking-atelier h2{font-size:clamp(1.8rem,3.3vw,3rem);margin:8px 0 21px}
  .cooking-atelier h3{font-size:clamp(1.3rem,2vw,2rem);margin:0 0 14px}
  .eyebrow{font-size:12px;letter-spacing:.13em;text-transform:uppercase;font-weight:750;color:#785421;margin:0}
  .atelier-breadcrumb{display:flex;gap:12px;margin:8px 0 28px;font-size:14px;color:#676053}
  .atelier-hero{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(22px,4vw,55px);align-items:center;margin-bottom:58px}
  .atelier-intro{font-size:clamp(1.15rem,1.8vw,1.5rem);line-height:1.48}
  .atelier-hero-copy>p:not(.eyebrow):not(.atelier-intro){color:#5f594d}
  .atelier-stats{display:flex;gap:25px;flex-wrap:wrap;margin:27px 0}
  .atelier-stats>div{border-top:1px solid var(--border);padding-top:10px;min-width:115px}
  .atelier-stats dt{font-size:12px;color:#6e665b}.atelier-stats dd{margin:4px 0 0;font-weight:700}
  .atelier-hero-links{display:flex;align-items:center;flex-wrap:wrap;gap:23px;margin:23px 0}
  .atelier-action{display:inline-flex;gap:20px;align-items:center;justify-content:space-between;min-height:48px;border-radius:30px;background:#f1cb68;color:#30291b!important;padding:12px 18px;font-weight:750;text-decoration:none}
  .atelier-preview-note{border-left:3px solid #c6a169;padding:9px 0 9px 15px;font-size:13px}
  .atelier-hero-photo{margin:0}.atelier-hero-photo img{width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:10px}
  .atelier-hero-photo figcaption{margin-top:7px;font-size:12px;color:#635d53}
  .atelier-goal{display:grid;grid-template-columns:.85fr 1.15fr;gap:50px;border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:40px 0;margin-bottom:75px}
  .atelier-goal>p{font-size:clamp(1rem,1.5vw,1.2rem);margin:5px 0}
  .atelier-section{margin:0 0 82px;scroll-margin-top:124px}.atelier-section>p:not(.eyebrow){max-width:760px}
  .atelier-kit-grid{display:grid;grid-template-columns:1fr .9fr;gap:22px;margin-top:34px}
  .atelier-kit-panel{padding:clamp(20px,3vw,36px);background:var(--paper);border:1px solid var(--border);border-radius:12px}
  .atelier-checklist{list-style:none;padding:0;margin:0}
  .atelier-checklist li+li{border-top:1px solid #e5dbca}
  .atelier-checklist label{display:flex;align-items:center;gap:13px;cursor:pointer;padding:12px 0}
  .atelier-checklist input{width:20px;height:20px;flex:none;accent-color:#82612e}
  .atelier-checklist small{display:block;color:#665e52;font-size:12px}
  .atelier-preflight{display:grid;gap:14px}
  .atelier-preflight section{padding:20px 25px;border:1px solid var(--border);border-radius:10px}
  .atelier-preflight h3{font-size:1.4rem}.atelier-preflight ul{margin:0;padding-left:22px}
  .atelier-preflight li{margin:4px 0}
  .atelier-small{font-size:13px;color:#5d554b}
  .atelier-audio-note{background:#faf5ea;border-left:3px solid #bd9759;padding:12px 16px;font-size:14px}
  .atelier-step-nav{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin:28px 0 36px}
  .atelier-step-nav a{display:flex;gap:12px;align-items:center;min-height:66px;border:1px solid var(--border);padding:12px 14px;border-radius:8px;text-decoration:none;color:var(--ink)}
  .atelier-step-nav a:hover{background:#faf5ea}.atelier-step-nav span{font-size:13px;font-weight:700;color:#835f2d}
  .atelier-step-nav strong{font-size:13px;line-height:1.4}
  .atelier-phase{padding:40px 0 46px;border-top:1px solid var(--border);scroll-margin-top:124px}
  .atelier-phase-heading{display:flex;gap:20px;align-items:flex-start;margin-bottom:26px}
  .atelier-phase-number{font:3rem Georgia,serif;color:#aa8549;line-height:1}
  .atelier-phase-heading h3{margin:7px 0 0}
  .atelier-phase-columns{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(25px,4vw,54px)}
  .atelier-phase h4{font-size:1rem;margin:0 0 12px;color:#423d32}
  .atelier-actions{padding-left:26px;margin:0}.atelier-actions li{margin-bottom:17px;padding-left:4px}
  .atelier-observe{padding:24px 26px;background:#f5f0e6;border-radius:10px}
  .atelier-observe p{margin:12px 0 20px}.atelier-observe h4{margin-top:22px}
  .atelier-observe details{border-top:1px solid #d9ccb6;padding-top:15px}
  .atelier-observe summary{font-weight:700;cursor:pointer;min-height:42px}
  .atelier-observe details p{font-size:14px}
  .atelier-learning{margin:26px 0 12px;border-left:3px solid #b69a65;padding:14px 20px;background:#fbf8f2}
  .atelier-next{display:inline-block;margin-top:16px;font-size:14px;font-weight:700}
  .atelier-finish{scroll-margin-top:124px;background:var(--paper);padding:clamp(23px,4vw,48px);border:1px solid var(--border);border-radius:12px;margin-bottom:64px}
  .atelier-finish p{max-width:800px}.atelier-finish .atelier-action{margin-top:15px}
  .atelier-sources{padding-top:24px;border-top:1px solid var(--border);color:#5d584d;font-size:14px}
  .atelier-sources h2{font-size:1.55rem}
  @media(max-width:900px){.atelier-hero,.atelier-goal,.atelier-kit-grid,.atelier-phase-columns{grid-template-columns:1fr}.atelier-hero-photo{order:-1}.atelier-goal{gap:0}.atelier-step-nav{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:570px){.cooking-atelier{padding:101px 17px 60px}.atelier-hero{margin-bottom:38px}.atelier-stats{gap:12px}.atelier-goal{margin-bottom:50px}.atelier-section{margin-bottom:55px}.atelier-step-nav{grid-template-columns:1fr}.atelier-step-nav a{min-height:55px}.atelier-phase{padding:30px 0;scroll-margin-top:100px}.atelier-section,.atelier-finish{scroll-margin-top:100px}.atelier-phase-heading{gap:12px}.atelier-phase-number{font-size:2.5rem}.atelier-observe{padding:18px}}
</style>
