---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import { recipes } from '../../../data/recipes';
import CookingWorkshopAudio from '../../../components/CookingWorkshopAudio.astro';
import type { RecipeIngredient } from '../../../data/recipes';
import lokLak from '../../../data/atelier-recette-guides/lok-lak.json';
import samlorMachu from '../../../data/atelier-recette-guides/samlor-machu.json';
import numBanhChok from '../../../data/atelier-recette-guides/num-banh-chok.json';
import kuyTeav from '../../../data/atelier-recette-guides/kuy-teav.json';
import baiSachChrouk from '../../../data/atelier-recette-guides/bai-sach-chrouk.json';

export function getStaticPaths() {
  // Astro hoists getStaticPaths: local variables in component frontmatter are not available here.
  const guides = [lokLak, samlorMachu, numBanhChok, kuyTeav, baiSachChrouk];
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
type Guide = typeof lokLak | typeof samlorMachu | typeof numBanhChok | typeof kuyTeav | typeof baiSachChrouk;
const { guide } = Astro.props as { guide: Guide };
const recipe = recipes.find((item) => item.slug === guide.sourceRecipeSlug);
if (!recipe) throw new Error('Source de recette manquante pour atelier complet : ' + guide.sourceRecipeSlug);
const minutes = guide.duration.practicalMinutes + guide.duration.preparationMinutes + guide.duration.waitingMinutes;
const flexibleServings = true;
// The historical recipe combines three crudités in one unscalable string. Normalize
// their quantities only for this workshop; never alter the canonical recipe.
// Workshop-only portion normalization: do not touch canonical recipes.ts.
// Legacy compound, non-scalable labels are expanded into measurable components.
const workshopIngredients: RecipeIngredient[] = (() => {
  const items = recipe.ingredients;
  switch (guide.sourceRecipeSlug) {
    case 'lok-lak': return [
      ...items.slice(0,7),
      { quantity:1, name:'tomate' }, { quantity:0.5, name:'concombre' },
      { quantity:4, name:'feuille de salade' },
      { quantity:1, unit:'c. à soupe', name:'huile neutre pour la saisie', note:'Facultative selon la poêle ; ajout pédagogique à la recette historique' }
    ];
    case 'bai-sach-chrouk': return [
      ...items.slice(0,6),
      { quantity:200, unit:'g', name:'pickles égouttés de concombre et de carotte', note:'À préparer à l’avance ou acheter prêts. Quantité à adapter aux convives.' }
    ];
    case 'samlor-machu': return [
      ...items.slice(0,5),
      { quantity:2, name:'tomates en quartiers' },
      { quantity:150, unit:'g', name:'ananas frais en dés', note:'Choix A : ananas.' },
      { quantity:250, unit:'g', name:'courgette en dés', note:'Choix B : à la place de l’ananas, ne pas utiliser les deux.' },
      { quantity:1, unit:'petite poignée', name:'coriandre fraîche ou basilic asiatique', note:'Garniture à doser suivant les convives.' }
    ];
    case 'kuy-teav': return [
      ...items.slice(0,5),
      { quantity:1, unit:'petite botte', name:'coriandre' },
      { quantity:2, name:'ciboules' },
      { quantity:100, unit:'g', name:'pousses de soja' },
      ...items.slice(6)
    ];
    case 'num-banh-chok': return [
      ...items.slice(0,5),
      { quantity:0.5, name:'concombre' },
      { quantity:100, unit:'g', name:'haricots verts fins' },
      { quantity:1, unit:'poignée', name:'menthe ou basilic asiatique' }
    ];
    default: return items;
  }
})();
const ingredientNames = (item: RecipeIngredient) => {
  if (item.name === 'gousse d’ail') return { singular: 'gousse d’ail', plural: 'gousses d’ail' };
  if (item.name === 'citrons verts') return { singular: 'citron vert', plural: 'citrons verts' };
  if (item.name === 'tomate') return { singular: 'tomate', plural: 'tomates' };
  if (item.name === 'concombre') return { singular: 'concombre', plural: 'concombres' };
  if (item.name === 'feuille de salade') return { singular: 'feuille de salade', plural: 'feuilles de salade' };
  return { singular: item.name, plural: item.name };
};
const recipeHref = '/recettes/' + recipe.slug + '/';
const heroPicture=guide.status==='release_ready'&&guide.media.finishedPreparationImage ? guide.media.finishedPreparationImage : recipe.image;
const heroCaption=guide.status==='release_ready' ? 'Photographie de la préparation terminée.' : 'Visuel éditorial de la recette existante ; photographie finale à valider.';
const recorded = import.meta.glob('../../../data/atelier-recette-audio/*.json', { eager:true, import:'default' }) as Record<string,{atelier:string;status:string;audioUrl:string;sha256:string;durationSec:number;chapters:{id:string;title:string;startSec:number;endSec:number}[];review:{acousticListening:boolean;mobile:boolean;desktop:boolean}}>;
// Typed as optional: the V2 script-only Lok Lak deliberately has no current asset.
const currentAudioAsset=(guide.audio as {asset?: {sha256:string; audioUrl:string}}).asset;
// Never display a superseded MP3 with the V2 narration or outdated chapter timestamps.
const guideAudio = guide.audio.status === 'script_only' || !currentAudioAsset
  ? undefined
  : Object.values(recorded).find((manifest)=>
      manifest.atelier===guide.slug
      && manifest.sha256===currentAudioAsset.sha256
      && manifest.audioUrl===currentAudioAsset.audioUrl);
const audioTexts = [guide.audio.intro,...guide.phases.map((phase)=>phase.audioScript)];
---
<BaseLayout
  title={guide.title + ' — Atelier guidé | Cuisine du Cambodge'}
  description={guide.learningGoal}
  noindex={guide.status !== 'release_ready'}
>
  <SiteHeader />
  <main class="full-cooking-atelier">
    <nav class="fca-breadcrumb" aria-label="Fil d’Ariane">
      <a href="/apprendre/">← Ateliers</a><span aria-hidden="true">/</span><span>{guide.title}</span>
    </nav>
    <header class="fca-hero">
      <div class="fca-hero-copy">
        <p class="fca-eyebrow">Les ateliers · Cuisine cambodgienne à réaliser</p>
        <h1>{guide.title}</h1>
        <p class="fca-intro">{guide.finalPreparation}</p>
        <p class="fca-objective">{guide.learningGoal}</p>
        <dl class="fca-facts">
          <div><dt>Durée estimée de l’atelier</dt><dd>{minutes} min indicatives</dd></div>
          <div><dt>Rendement sélectionné</dt><dd data-workshop-servings-hero>{recipe.baseServings} {guide.sourceRecipeSlug==='samlor-machu'||guide.sourceRecipeSlug==='kuy-teav'||guide.sourceRecipeSlug==='num-banh-chok'?'bols':'assiettes'}</dd></div>
          <div><dt>Niveau</dt><dd>{guide.difficulty}</dd></div>
        </dl>
        <a class="fca-primary" href="#ingredients">Préparer vos ingrédients <span aria-hidden="true">↘</span></a>
        {guide.status !== 'release_ready' && <p class="fca-preview">Cet atelier est en préproduction : photographie finale et guide vocal encore soumis à validation.</p>}
      </div>
      <figure class="fca-hero-photo">
        <img src={heroPicture ?? '/images/cuisine/v17-table-meal-1600.jpg'} alt={guide.status==='release_ready'?guide.finalPreparation:(recipe.imageAlt ?? guide.finalPreparation)} loading="eager" width={recipe.imageWidth ?? 1200} height={recipe.imageHeight ?? 800} decoding="async" />
        <figcaption>{heroCaption}</figcaption>
      </figure>
    </header>

    <section class="fca-promise" aria-labelledby="fca-promise-heading">
      <div><p class="fca-eyebrow">Ce que vous allez vraiment cuisiner</p><h2 id="fca-promise-heading">{guide.finalPreparation}</h2></div>
      <p>Ce parcours part d’une recette complète, pas de conseils isolés. À chaque étape, vous cuisinez, observez le résultat, puis apprenez quoi corriger si nécessaire.</p>
    </section>

    <section id="ingredients" class="fca-section" aria-labelledby="fca-ingredients-heading" data-workshop-servings-root="" data-base-servings={recipe.baseServings} data-workshop-portion-kind={guide.sourceRecipeSlug==='samlor-machu'||guide.sourceRecipeSlug==='kuy-teav'||guide.sourceRecipeSlug==='num-banh-chok'?'bol':'assiette'}>
      <p class="fca-eyebrow">01 · Préparer</p>
      <h2 id="fca-ingredients-heading">Les ingrédients et le plan de travail.</h2>
      <p>Quantités issues de la <a href={recipeHref}>recette {recipe.title}</a>{', adaptées au nombre de personnes que vous choisissez.'}{guide.sourceRecipeSlug==='lok-lak' && ' Une petite quantité d’huile neutre facultative est signalée séparément pour la saisie du bœuf mariné.'} Cochez les produits au fur et à mesure.</p>
      {flexibleServings && (
        <div class="fca-servings" aria-label="Choisir le nombre de convives">
          <label for="fca-servings-input">Je cuisine pour</label>
          <input id="fca-servings-input" data-workshop-servings-input type="number" inputmode="numeric" min="1" max="12" step="1" value={recipe.baseServings} />
          <strong data-workshop-servings-summary aria-live="polite">{recipe.baseServings} personnes</strong>
          <div class="fca-servings-presets">
            {[2, 4, 6, 8].map((n) => <button type="button" data-workshop-serving-preset={n} aria-pressed={n===recipe.baseServings?'true':'false'}>{n} pers.</button>)}
          </div>
          <p>Seules les quantités de la liste changent. Les gestes et les repères de cuisson restent les mêmes, mais le nombre de fournées et le temps de cuisson peuvent évoluer.</p>
        </div>
      )}
      <div class="fca-kit">
        <section class="fca-ingredients" aria-labelledby="fca-shopping-heading">
          <h3 id="fca-shopping-heading">Liste des ingrédients</h3>
          <ul class="fca-checks">
            {workshopIngredients.map((ingredient) => (
              <li data-workshop-ingredient>
                <label>
                  <input type="checkbox" aria-label={'Ingrédient préparé : ' + ingredient.name} />
                  <span>
                    {ingredient.quantity !== undefined && <span data-workshop-ingredient-quantity="" data-base-quantity={ingredient.quantity} data-unit={ingredient.unit ?? ''}>{ingredient.quantity}</span>}
                    {ingredient.unit && <span> {ingredient.unit}</span>}
                    {ingredient.quantity !== undefined && ' '}
                    <span data-workshop-ingredient-name="" data-singular-name={ingredientNames(ingredient).singular} data-plural-name={ingredientNames(ingredient).plural}>{ingredient.name}</span>
                    {ingredient.note && <small>{ingredient.note}</small>}
                  </span>
                </label>
              </li>
            ))}
          </ul>
          <a href={recipeHref}>Consulter la fiche recette complète →</a>
        </section>
        <div class="fca-kit-side">
          <section><h3>Matériel nécessaire</h3><ul>{guide.equipment.map((item) => <li>{item}</li>)}</ul></section>
          <section><h3>À préparer avant de démarrer</h3><ul>{guide.beforeStarting.map((item) => <li>{item}</li>)}</ul></section>
          {recipe.substitutions && recipe.substitutions.length>0 && (
            <section><h3>Substitutions possibles</h3><ul>{recipe.substitutions.map((item)=><li>{item}</li>)}</ul></section>
          )}
          <section>
            <h3>Sécurité et allergènes</h3>
            <p><strong>Allergènes à vérifier :</strong> {guide.allergens.items.join(' · ')}</p>
            <ul>{guide.safety.map((item) => <li>{item}</li>)}</ul>
            <details class="fca-safety-sources">
              <summary>Sources des repères de sécurité alimentaire</summary>
              <ul>{guide.sources.safetyReferences.map((reference) => (
                <li><a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.title}</a></li>
              ))}</ul>
            </details>
          </section>
        </div>
      </div>
    </section>

    <section class="fca-section" id="atelier" aria-labelledby="fca-steps-heading">
      <p class="fca-eyebrow">02 · Pratiquer</p>
      <h2 id="fca-steps-heading">La recette, étape par étape.</h2>
      <p><strong>Repère de durée :</strong> {guide.duration.waitingNote}</p>
      <p>Respectez l’ordre des préparations et vérifiez les repères avant de poursuivre. {guide.sourceRecipeSlug==='lok-lak' ? 'Prévoyez environ vingt minutes de marinade au réfrigérateur : profitez-en pour préparer les crudités et le condiment.' : ''} La recette reste entièrement accessible par écrit, même sans MP3.</p>
      {guideAudio ? <CookingWorkshopAudio manifest={guideAudio} scripts={audioTexts} /> : <p class="fca-preview">{guide.review.editorialValidated ? "Textes validés. La nouvelle narration audio est en préparation ; suivez les étapes écrites en attendant." : "La narration sera proposée après validation des textes et enregistrement."}</p>}
      <nav class="fca-steps-nav" aria-label="Aller directement à une étape">
        {guide.phases.map((phase, i) => (
          <a href={'#phase-' + phase.id}><span>{String(i+1).padStart(2,'0')}</span>{phase.title}</a>
        ))}
      </nav>
      <div class="fca-steps">
        {guide.phases.map((phase,i) => (
          <article class="fca-step" id={'phase-' + phase.id} aria-labelledby={'fca-step-'+phase.id}>
            <header class="fca-step-head">
              <span>{String(i+1).padStart(2,'0')}</span>
              <div><p class="fca-eyebrow">Étape {i+1} sur 6 · environ {phase.minutes} min</p><h3 id={'fca-step-'+phase.id}>{phase.title}</h3></div>
            </header>
            <div class="fca-step-grid">
              <div>
                <h4>Ce que vous faites</h4>
                <ol>{phase.actions.map((action) => <li>{action}</li>)}</ol>
                {phase.ingredientNames.length>0 && <p class="fca-used"><strong>Ingrédients de cette étape :</strong> {guide.sourceRecipeSlug==='lok-lak' && phase.id==='assembler' ? 'tomate · concombre · feuilles de salade · citrons verts · poivre de Kampot (quantités ci-dessus)' : phase.ingredientNames.join(' · ')}</p>}
              </div>
              <aside class="fca-observe" aria-label={'Repères : '+phase.title}>
                <p class="fca-eyebrow">À observer</p><p>{phase.observe}</p>
                <h4>Vous avez réussi lorsque…</h4><p>{phase.check}</p>
                <details><summary>Si quelque chose ne fonctionne pas</summary><p><strong>Erreur fréquente :</strong> {phase.mistake}</p><p><strong>Geste correctif :</strong> {phase.recovery}</p></details>
              </aside>
            </div>
            <div class="fca-why"><strong>Ce que vous apprenez</strong><span>{phase.learning}</span></div>
            <p class="fca-safety"><strong>Précaution :</strong> {phase.safety}</p>
            {i < guide.phases.length-1 && <a class="fca-next" href={'#phase-'+guide.phases[i+1].id}>Passer à l’étape suivante →</a>}
          </article>
        ))}
      </div>
    </section>
    <section class="fca-finish" id="degustation" aria-labelledby="fca-finish-heading">
      <p class="fca-eyebrow">03 · Terminer et déguster</p>
      <h2 id="fca-finish-heading">Votre préparation est prête.</h2>
      <p>{guide.finalPreparation}</p>
      <p>À retenir : {guide.phases.at(-1)?.learning} Recommencez cette recette plus tard en vous servant des critères de réussite, pas seulement des durées indiquées.</p>
      <a class="fca-primary" href={recipeHref}>Retrouver la recette complète <span aria-hidden="true">→</span></a>
    </section>
    <footer class="fca-sources">
      <h2>Origine des instructions</h2>
      <p>Ingrédients et proportions : <a href={recipeHref}>fiche {recipe.title}</a>. Les observations, les contrôles et les conseils de correction sont le prolongement pédagogique de Cuisine du Cambodge.</p>
      <p>Recettes et variantes consultées pour préparer cet atelier :</p>
      <ul>{guide.sources.culinaryReferences?.map(reference => (
        <li><a href={reference.url} target="_blank" rel="noopener noreferrer">{reference.title}</a></li>
      ))}</ul>
      <a href="/apprendre/">← Revenir aux ateliers</a>
    </footer>
  </main>
  <SiteFooter />
</BaseLayout>
<script>
  import { initCookingWorkshopServings } from '../../../scripts/cookingWorkshopServings';
  initCookingWorkshopServings();
</script>
<style>
  .fca-servings{display:flex;align-items:center;flex-wrap:wrap;gap:12px;padding:16px 20px;margin:20px 0;border:1px solid #ddc9a5;background:#fffaf0;border-radius:12px}
  .fca-servings label{font-weight:700}
  .fca-servings input{width:76px;min-height:46px;padding:6px;border:1px solid #a58b65;border-radius:6px;font-size:18px}
  .fca-servings-presets{display:flex;gap:7px;flex-wrap:wrap}
  .fca-servings-presets button{min-height:44px;background:white;border:1px solid #bca77f;padding:8px 12px;border-radius:24px;cursor:pointer}
  .fca-servings-presets button[aria-pressed="true"]{background:#f1ca62;border-color:#917139}
  .fca-servings :is(input,button):focus-visible{outline:3px solid #a77918;outline-offset:3px}
  .fca-servings p{flex-basis:100%;margin:0;font-size:13px;color:#635747}
  .full-cooking-atelier{--ink:#302c27;--line:#e0d6c5;--paper:#faf6ed;color:var(--ink);max-width:1350px;margin:auto;padding:120px clamp(18px,4vw,65px) 90px;line-height:1.65}
  .full-cooking-atelier *{box-sizing:border-box}
  .full-cooking-atelier a{color:#735222;text-underline-offset:3px}
  .full-cooking-atelier :is(a,summary,input):focus-visible{outline:3px solid #a77918;outline-offset:4px}
  .full-cooking-atelier :is(h1,h2,h3){font-family:Georgia,serif;font-weight:400;line-height:1.13;letter-spacing:-.025em;color:#312b23}
  .full-cooking-atelier h1{font-size:clamp(2.5rem,5vw,5.1rem);margin:.7rem 0 1.2rem}
  .full-cooking-atelier h2{font-size:clamp(1.9rem,3.5vw,3.15rem);margin:.6rem 0 1.4rem}
  .full-cooking-atelier h3{font-size:clamp(1.25rem,2.2vw,2rem)}
  .fca-eyebrow{text-transform:uppercase;letter-spacing:.11em;color:#785624;font-size:12px;font-weight:750;margin:0}
  .fca-breadcrumb{display:flex;gap:12px;margin:0 0 35px;font-size:13px;flex-wrap:wrap;color:#71685d}
  .fca-hero{display:grid;grid-template-columns:1.02fr .98fr;gap:clamp(23px,4vw,66px);align-items:center;margin:0 0 65px}
  .fca-intro{font-size:clamp(1.15rem,1.8vw,1.5rem);line-height:1.47}
  .fca-objective{color:#5d554b}
  .fca-facts{display:flex;flex-wrap:wrap;gap:20px;margin:25px 0}
  .fca-facts>div{border-top:1px solid var(--line);padding-top:10px;min-width:105px}
  .fca-facts dt{font-size:12px;color:#71675b}.fca-facts dd{margin:4px 0 0;font-weight:700}
  .fca-primary{display:inline-flex;align-items:center;justify-content:space-between;gap:18px;padding:12px 21px;min-height:48px;border-radius:32px;background:#f1ca62;color:#28271f!important;text-decoration:none;font-weight:750}
  .fca-preview{margin-top:20px;border-left:3px solid #b99562;padding:8px 14px;font-size:13px;color:#665d4d}
  .fca-hero-photo{margin:0}
  .fca-hero-photo img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:9px}
  .fca-hero-photo figcaption{font-size:12px;color:#635c50;margin-top:9px}
  .fca-promise{display:grid;grid-template-columns:1fr 1fr;gap:40px;border-block:1px solid var(--line);padding:40px 0;margin-bottom:80px}
  .fca-promise p:last-child{font-size:clamp(1rem,1.6vw,1.22rem)}
  .fca-section{margin:0 0 85px;scroll-margin-top:128px}
  .fca-section>p:not(.fca-eyebrow){max-width:790px}
  .fca-kit{display:grid;grid-template-columns:1.05fr .95fr;gap:24px;margin:34px 0 0}
  .fca-ingredients{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:clamp(20px,3vw,35px)}
  .fca-ingredients h3{margin:0 0 15px}
  .fca-checks{list-style:none;padding:0;margin:0 0 22px}
  .fca-checks li+li{border-top:1px solid #e0d6c6}
  .fca-checks label{display:flex;gap:13px;padding:13px 0;align-items:center;cursor:pointer}
  .fca-checks input{width:20px;height:20px;flex:none;accent-color:#7c5b2d}
  .fca-checks small{display:block;color:#645c4d;font-size:12px}
  .fca-kit-side{display:grid;gap:15px}
  .fca-kit-side section{border:1px solid var(--line);border-radius:10px;padding:20px 25px}
  .fca-kit-side h3{font-size:1.35rem;margin:0 0 14px}
  .fca-kit-side ul{padding-left:21px;margin:0}
  .fca-kit-side li{margin:5px 0}
  .fca-steps-nav{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin:30px 0 39px}
  .fca-steps-nav a{display:flex;align-items:center;gap:12px;min-height:65px;border:1px solid var(--line);border-radius:8px;padding:12px 15px;text-decoration:none;color:var(--ink)}
  .fca-steps-nav a:hover{background:#fcf7ec;border-color:#bd9d61}
  .fca-steps-nav span{font-size:13px;font-weight:700;color:#875d26}
  .fca-step{border-top:1px solid var(--line);padding:43px 0;scroll-margin-top:125px}
  .fca-step-head{display:flex;align-items:flex-start;gap:21px;margin:0 0 27px}
  .fca-step-head>span{font:3rem Georgia,serif;color:#ae8850;line-height:1}
  .fca-step-head h3{margin:6px 0 0}
  .fca-step-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(23px,4vw,57px)}
  .fca-step h4{font-size:1rem;margin:0 0 13px;color:#473b2c}
  .fca-step ol{padding-left:26px;margin:0}
  .fca-step ol li{margin:0 0 18px;padding-left:4px}
  .fca-used{font-size:13px;color:#6b6154;margin:25px 0 0}
  .fca-observe{background:#f4efe4;border-radius:10px;padding:26px}
  .fca-observe p{margin:10px 0 22px}.fca-observe h4{margin:28px 0 10px}
  .fca-observe details{border-top:1px solid #dfcfb9;padding-top:14px}
  .fca-observe summary{font-weight:700;min-height:42px;cursor:pointer}
  .fca-observe details p{font-size:14px}
  .fca-why{display:flex;gap:20px;background:#faf8f3;border-left:3px solid #b9975c;padding:17px 21px;margin:25px 0 10px}
  .fca-why strong{flex:0 0 180px}
  .fca-safety{font-size:13px;color:#655a4d}
  .fca-next{display:inline-block;margin-top:18px;font-weight:700;font-size:14px}
