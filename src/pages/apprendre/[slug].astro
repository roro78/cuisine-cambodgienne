---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CulinaryIcon from '../../components/CulinaryIcon.astro';
import GlossaryStrip from '../../components/GlossaryStrip.astro';
import WorkshopInfographic from '../../components/WorkshopInfographic.astro';
import WorkshopChapterPlayer from '../../components/WorkshopChapterPlayer.astro';
import { getWorkshopAudio } from '../../data/workshop-audio';
import { getWorkshopLearning } from '../../data/workshopLearning';
import { workshops } from '../../data/workshops';
import { completeCookingWorkshopCutoverReady } from '../../data/cookingWorkshopGuides';
import type { Workshop } from '../../data/workshops';
import { recipes } from '../../data/recipes';
import { getGlossaryEntries } from '../../data/glossary';
import '../../styles/v16-editorial.css';
import '../../styles/workshop-mortier-photos.css';
import '../../styles/workshop-experience-v20.css';
import '../../styles/workshop-tutorial-v21.css';
import '../../styles/workshop-shapes-v22.css';

export function getStaticPaths() {
  return (completeCookingWorkshopCutoverReady ? [] : workshops).map((workshop: Workshop) => ({
    params: { slug: workshop.slug },
    props: { workshop }
  }));
}

const { workshop } = Astro.props as { workshop: Workshop };
const index = workshops.findIndex((item) => item.slug === workshop.slug);
const nextWorkshop = workshops[(index + 1) % workshops.length];
const relatedRecipes = recipes.filter((recipe) => workshop.relatedRecipes.includes(recipe.slug));
const glossary = getGlossaryEntries(workshop.glossarySlugs ?? []);
const illustratedMortar = workshop.slug === 'piler-aromates-au-mortier';
const mortarPhotos = [
  '/images/workshops/mortier-etape-01.webp',
  '/images/workshops/mortier-etape-02.webp',
  '/images/workshops/mortier-etape-03.webp',
  '/images/workshops/mortier-etape-04.webp'
];
const mortarAlt = [
  'Citronnelle, galanga et curcuma émincés finement avant le pilage.',
  'Aromates travaillés avec un pilon dans un mortier en pierre.',
  'Pâte de kroeung en cours de pilage, texture encore irrégulière.',
  'Pâte aromatique de kroeung plus fine et homogène après le pilage.'
];

const workshopExperiences: Record<string, { image: string; imageAlt: string; question: string; answer: string; focus: string }> = {
  'piler-aromates-au-mortier': {
    image: '/images/cuisine/v19-mortier-kroeung-1440.webp',
    imageAlt: 'Mortier en pierre et pâte de kroeung cambodgienne, aux aromates frais.',
    question: 'À quel moment des morceaux deviennent-ils une vraie pâte ?',
    answer: 'La pâte se tient, les fibres longues disparaissent et le parfum devient plus intense.',
    focus: 'Texture · Parfum · Transformation'
  },
  'equilibrer-une-sauce': {
    image: '/images/cuisine/tamarind-1600.webp',
    imageAlt: 'Tamarin, ingrédient acidulé employé pour équilibrer une sauce cambodgienne.',
    question: 'Comment savoir ce qui manque, sans tout ajouter ?',
    answer: 'Modifiez un seul goût à la fois, puis comparez systématiquement avec la base initiale.',
    focus: 'Goûter · Comparer · Ajuster'
  },
  'saisir-viande-poele': {
    image: '/images/cuisine/v19-lok-lak-1440.webp',
    imageAlt: 'Lok lak cambodgien, viande dorée et accompagnement, pour évoquer la saisie.',
    question: 'Pourquoi une petite fournée dore-t-elle mieux ?',
    answer: 'Une poêle moins chargée garde mieux sa chaleur et laisse moins de liquide s’accumuler.',
    focus: 'Chaleur · Son · Coloration'
  },
  'fraicheur-herbes-agrumes': {
    image: '/images/cuisine/v19-num-banh-chok-1440.webp',
    imageAlt: 'Num banh chok servi avec des herbes fraîches et des légumes.',
    question: 'Comment réveiller une bouchée sans masquer le plat ?',
    answer: 'Testez séparément herbes, jus et zeste ; cherchez le contraste, pas la domination.',
    focus: 'Parfum · Acidité · Contraste'
  },
  'bouillon-leger-savoureux': {
    image: '/images/cuisine/v18-kuy-teav.webp',
    imageAlt: 'Bol de kuy teav cambodgien, bouillon et garnitures aromatiques.',
    question: 'Comment gagner en goût sans rendre le bouillon trop salé ?',
    answer: 'Comparez le goût avant et après réduction, puis ajustez l’assaisonnement progressivement.',
    focus: 'Réduction · Équilibre · Fraîcheur'
  },
  'composer-repas-cambodgien': {
    image: 'https://upload.wikimedia.org/wikipedia/commons/thumb/c/c8/Cambodia%27s_rice_fields.jpg/1280px-Cambodia%27s_rice_fields.jpg',
    imageAlt: 'Rizières verdoyantes près de Siem Reap, au Cambodge.',
    question: 'Pourquoi le riz est-il le point de départ du repas cambodgien ?',
    answer: 'Associez une base, un plat chaud, un contraste frais et un condiment à part.',
    focus: 'Riz · Partage · Équilibre'
  }
};
const workshopExperience = workshopExperiences[workshop.slug];
const learning = getWorkshopLearning(workshop.slug);
const workshopAudio = getWorkshopAudio(workshop.slug);
const brothGuideHref = workshop.slug === 'bouillon-leger-savoureux' ? '/techniques/bouillon-leger-maison/' : undefined;
if (!learning) throw new Error(`Missing instructional module: ${workshop.slug}`);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.cuisine-du-cambodge.com/' },
    { '@type': 'ListItem', position: 2, name: 'Ateliers', item: 'https://www.cuisine-du-cambodge.com/apprendre/' },
    { '@type': 'ListItem', position: 3, name: workshop.title, item: `https://www.cuisine-du-cambodge.com/apprendre/${workshop.slug}/` }
  ]
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: workshop.title,
  description: workshop.objective,
  totalTime: `PT${Number(workshop.duration.match(/\d+/)?.[0] ?? 0)}M`,
  step: workshop.steps.map((step, stepIndex) => ({
    '@type': 'HowToStep',
    position: stepIndex + 1,
    name: step.title,
    text: step.action
  })),
  inLanguage: 'fr-FR',
  url: `https://www.cuisine-du-cambodge.com/apprendre/${workshop.slug}/`
};
---
<BaseLayout
  title={`${workshop.title} — Atelier | Cuisine du Cambodge`}
  description={workshop.objective}
>
  <SiteHeader />

  <main class="v16-editorial workshop-detail">
    <section class="workshop-detail-hero workshop-experience-hero" aria-labelledby="workshop-title">
      <div class="workshop-detail-hero-copy" data-reveal="up">
        <a class="workshop-detail-back" href="/apprendre/">← Tous les ateliers</a>
        <p class="v16-page-kicker"><CulinaryIcon name={workshop.icon} size={18} /> Atelier cuisine {workshop.n}</p>
        <h1 id="workshop-title">{workshop.title}</h1>
        <p class="workshop-experience-promise">{workshop.objective}</p>
        <div class="workshop-experience-actions">
          <a class="workshop-experience-button" href="#experience-atelier">Découvrir l’atelier <span aria-hidden="true">↘</span></a>
          <span class="workshop-experience-focus">{workshopExperience.focus}</span>
        </div>
        <dl class="workshop-detail-facts">
          <div><dt>Durée</dt><dd>{workshop.duration}</dd></div>
          <div><dt>Niveau</dt><dd>{workshop.level}</dd></div>
          <div><dt>Expériences</dt><dd>{workshop.experiments.length}</dd></div>
        </dl>
      </div>
      <div class="workshop-experience-visual">
        <figure class="workshop-experience-photo">
          <img
            src={workshopExperience.image}
            alt={workshopExperience.imageAlt}
            width={workshop.slug === 'composer-repas-cambodgien' ? 1280 : 1440}
            height={workshop.slug === 'composer-repas-cambodgien' ? 720 : 1080}
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption>
            <span>À explorer</span><strong>{workshop.eyebrow}</strong>
            {workshop.slug === 'composer-repas-cambodgien' && (
              <small class="workshop-rice-credit">Dmitry A. Mottl · CC BY-SA 4.0 · <a href="https://commons.wikimedia.org/wiki/File:Cambodia%27s_rice_fields.jpg" target="_blank" rel="noreferrer">Photo des rizières, Siem Reap</a></small>
            )}
          </figcaption>
        </figure>
        <aside class="workshop-experience-question" aria-label="Question de départ">
          <span>La question de l’atelier</span>
          <p>{workshopExperience.question}</p>
        </aside>
      </div>
    </section>

    {workshop.slug === 'composer-repas-cambodgien' && (
      <section class="workshop-rice-story" aria-labelledby="atelier-riz-title">
        <div class="workshop-rice-story-head">
          <p class="v16-page-kicker">Avant l’atelier · Un aliment essentiel</p>
          <h2 id="atelier-riz-title">Le riz, bien plus qu’un accompagnement.</h2>
          <p>Au Cambodge, le riz fait partie du quotidien, dans les campagnes comme dans les villes et à toutes les tables. Il accompagne le poisson, les soupes, les currys et les légumes. Il devient aussi bouillie de riz au petit déjeuner, riz sauté, nouilles de riz ou préparation sucrée.</p>
          <p>Le Cambodge cultive différentes variétés, dont le riz parfumé Phka Rumduol. Commercialisé notamment sous le nom Malys Angkor, il a reçu en novembre 2025 le titre de meilleur riz du monde lors de la World Rice Conference, pour la septième fois pour un riz cambodgien.</p>
          <p>Ce riz raconte aussi les rizières, les saisons et le travail des agriculteurs. Pour découvrir cette histoire, les variétés et les plats en détail, lisez notre carnet dédié.</p>
          <a class="workshop-rice-story-link" href="/culture/le-riz-symbole-de-vie-au-cambodge/">Lire le carnet complet sur le riz cambodgien →</a>
        </div>
        <div class="workshop-rice-story-photos">
          <figure>
            <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/d/d1/Cambodian_farmers_planting_rice.jpg/1280px-Cambodian_farmers_planting_rice.jpg" width="1280" height="851" alt="Agriculteurs cambodgiens repiquant du riz dans une rizière" loading="lazy" decoding="async" />
            <figcaption>Le riz commence dans les champs. <a href="https://commons.wikimedia.org/wiki/File:Cambodian_farmers_planting_rice.jpg" target="_blank" rel="noreferrer">Brad Collis · CC BY 2.0</a></figcaption>
          </figure>
          <figure>
            <img src="https://thumb.wikimedia.org/wikipedia/commons/thumb/e/e4/Fried_Prahok_meal.jpg/1280px-Fried_Prahok_meal.jpg" width="1280" height="1029" alt="Repas cambodgien composé de riz cuit, prahok dans une feuille de bananier et légumes frais" loading="lazy" decoding="async" />
            <figcaption>À table : riz, prahok et légumes frais. Photo de Paxse, recadrée à l’affichage · <a href="https://commons.wikimedia.org/wiki/File:Fried_Prahok_meal.jpg" target="_blank" rel="noreferrer">CC BY-SA 3.0</a>.</figcaption>
          </figure>
        </div>
      </section>
    )}

    <section class="workshop-learning-lab" id="experience-atelier" aria-labelledby="workshop-lab-title">
      <div class="workshop-lab-introduction">
        <p class="v16-page-kicker">Avant de commencer</p>
        <h2 id="workshop-lab-title">Essayez le geste, puis comparez.</h2>
        <p class="workshop-lab-lede">{learning.insight}</p>
        <div class="workshop-lab-result">
          <span>Ce que vous allez apprendre</span>
          <p>{workshop.objective}</p>
        </div>
        <a class="workshop-lab-start" href="#tutoriel-atelier">Passer aux étapes <span aria-hidden="true">→</span></a>
      </div>
      <div class="workshop-lab-activities">
        <div class="workshop-lab-activities-heading">
          <span class="workshop-lab-count">{String(learning.experiments.length).padStart(2, '0')}</span>
          <div>
            <p class="v16-page-kicker">À essayer chez vous</p>
            <h3>Faites le test vous-même.</h3>
          </div>
        </div>
        <ol class="workshop-lab-experiments">
          {learning.experiments.map((experiment, experimentIndex) => (
            <li><span aria-hidden="true">{String(experimentIndex + 1).padStart(2, '0')}</span><p>{experiment}</p></li>
          ))}
        </ol>
        <details class="workshop-lab-kit">
          <summary>Le matériel à préparer ({workshop.prepare.length}) <span aria-hidden="true">+</span></summary>
          <ul>{workshop.prepare.map((item) => <li>{item}</li>)}</ul>
          {brothGuideHref && (
            <p class="workshop-lab-preparation-guide">
              Vous partez de zéro ? <a href={brothGuideHref}>Préparer un bouillon léger maison : ingrédients, quantités et cuisson →</a>
            </p>
          )}
        </details>
      </div>
    </section>

    <section class="workshop-tutorial" id="tutoriel-atelier" aria-labelledby="workshop-tutorial-title" data-workshop-tutorial>
      <header class="workshop-tutorial-heading">
        <div>
          <p class="v16-page-kicker">L’atelier, étape par étape</p>
          <h2 id="workshop-tutorial-title">À vous de cuisiner !</h2>
        </div>
        <p>Suivez les étapes dans l’ordre. Essayez chaque geste, puis découvrez comment vérifier le résultat.</p>
      </header>
      {workshopAudio && <WorkshopChapterPlayer info={workshopAudio} />}
      <nav class="workshop-progress" aria-label="Choisir une étape de l’atelier" data-workshop-progress>
        {workshop.steps.map((step, stepIndex) => (
          <a href={`#etape-${stepIndex + 1}`} data-workshop-progress-link={stepIndex + 1} aria-controls={`etape-${stepIndex + 1}`}>
            <span>{String(stepIndex + 1).padStart(2, '0')}</span>
            <em>{step.title}</em>
          </a>
        ))}
      </nav>
      <div class="workshop-tutorial-steps">
        {workshop.steps.map((step, stepIndex) => (
          <article class="workshop-tutorial-step" id={`etape-${stepIndex + 1}`} data-tutorial-step={stepIndex + 1} aria-labelledby={`atelier-etape-titre-${stepIndex + 1}`}>
            <div class="workshop-tutorial-media">
              {illustratedMortar ? (
                <figure class="workshop-tutorial-photo">
                  {stepIndex === 3 ? (
                    <div class="workshop-step-compare">
                      <div><img src={mortarPhotos[1]} width="1240" height="930" loading="lazy" decoding="async" alt="Pâte à mi-parcours : fibres encore visibles" /><span>Mi-parcours</span></div>
                      <div><img src={mortarPhotos[3]} width="1240" height="930" loading="lazy" decoding="async" alt="Pâte finale : texture plus fine et liée" /><span>Pâte finale</span></div>
                    </div>
                  ) : (
                    <img src={mortarPhotos[stepIndex]} width="1240" height={stepIndex === 0 ? 827 : 930} loading={stepIndex === 0 ? "eager" : "lazy"} decoding="async" alt={mortarAlt[stepIndex]} />
                  )}
                  <figcaption>Étape {stepIndex + 1} · Comparez les repères avec votre propre préparation.</figcaption>
                </figure>
              ) : (
                <WorkshopInfographic learning={learning} stageIndex={stepIndex} />
              )}
              {illustratedMortar && (
                <p class="workshop-tutorial-visual-note"><span>À regarder</span>{learning.stages[stepIndex].criterion}</p>
              )}
            </div>
            <div class="workshop-tutorial-instructions">
              <p class="workshop-tutorial-step-number">Geste {String(stepIndex + 1).padStart(2, '0')} <span>sur {String(workshop.steps.length).padStart(2, '0')}</span></p>
              <h3 id={`atelier-etape-titre-${stepIndex + 1}`} tabindex="-1">{step.title}</h3>
              <div class="workshop-tutorial-do">
                <span>À vous de jouer</span>
                <p>{learning.stages[stepIndex].mission}</p>
              </div>
              <div class="workshop-tutorial-question">
                <span>Ce qu’il faut regarder</span>
                <p>{learning.stages[stepIndex].question}</p>
              </div>
              <details class="workshop-tutorial-answer">
                <summary>Voir les conseils <span aria-hidden="true">+</span></summary>
                <div>
                  <p><strong>À observer :</strong> {step.observe}</p>
                  <p><strong>Comment reconnaître le bon résultat :</strong> {learning.stages[stepIndex].criterion}</p>
                  {step.mistake && <p><strong>À éviter :</strong> {step.mistake}</p>}
                  <p><strong>Vous avez réussi si…</strong> {step.success}</p>
                </div>
              </details>
            </div>
          </article>
        ))}
      </div>
      <div class="workshop-tutorial-controls" aria-label="Parcours du tutoriel">
        <button type="button" data-tutorial-previous aria-label="Étape précédente">← Précédent</button>
        <span data-tutorial-counter aria-live="polite">Étape 1 sur {workshop.steps.length}</span>
        <button type="button" data-tutorial-next>Suivant →</button>
      </div>
    </section>

    <section class="workshop-tutorial-recap" aria-labelledby="workshop-recap-title">
      <div>
        <p class="v16-page-kicker">À refaire chez vous</p>
        <h2 id="workshop-recap-title">Vous saurez refaire ce geste.</h2>
        <p>{learning.transfer}</p>
      </div>
      <div class="workshop-tutorial-recap-list">
        <p>Ce que vous avez appris</p>
        <ul>{workshop.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
      </div>
    </section>

    <section class="workshop-takeaway">
      <p class="v16-page-kicker">À retenir</p>
      <blockquote>{workshop.takeaway}</blockquote>
    </section>

    {relatedRecipes.length > 0 && (
      <section class="workshop-practice">
        <header>
          <p class="v16-page-kicker">Passer à la pratique</p>
          <h2>Utilisez maintenant ce geste dans une vraie recette.</h2>
          <p>L’atelier vous donne le repère. La recette vous donne les quantités et l’enchaînement complet.</p>
        </header>
        <div class="workshop-practice-grid">
          {relatedRecipes.map((recipe) => (
            <a href={`/recettes/${recipe.slug}/`}>
              <span>Recette</span>
              <strong>{recipe.title}</strong>
              <p>{recipe.intro}</p>
              <em>Préparer cette recette →</em>
            </a>
          ))}
        </div>
      </section>
    )}

    <GlossaryStrip entries={glossary} alwaysVisible />

    <section class="workshop-next">
      <p class="v16-page-kicker">Continuer</p>
      <a href={`/apprendre/${nextWorkshop.slug}/`}>
        <span>Atelier {nextWorkshop.n}</span>
        <strong>{nextWorkshop.title}</strong>
        <em>Atelier suivant →</em>
      </a>
    </section>
  </main>

  <script>
    // Progressive enhancement: without JavaScript, all four steps remain readable.
    const tutorial = document.querySelector<HTMLElement>('[data-workshop-tutorial]');
    if (tutorial) {
      const stages = Array.from(tutorial.querySelectorAll<HTMLElement>('[data-tutorial-step]'));
      const links = Array.from(tutorial.querySelectorAll<HTMLAnchorElement>('[data-workshop-progress-link]'));
      const previous = tutorial.querySelector<HTMLButtonElement>('[data-tutorial-previous]');
      const next = tutorial.querySelector<HTMLButtonElement>('[data-tutorial-next]');
      const counter = tutorial.querySelector<HTMLElement>('[data-tutorial-counter]');
      const stepNavigation = tutorial.querySelector<HTMLElement>('[data-workshop-progress]');
      let active = 0;

      function showStage(index: number, moveFocus = false) {
        if (index < 0 || index >= stages.length) return;
        active = index;
        stages.forEach((stage, stageIndex) => {
          stage.hidden = stageIndex !== active;
        });
        links.forEach((link, linkIndex) => {
          if (linkIndex === active) link.setAttribute('aria-current', 'step');
          else link.removeAttribute('aria-current');
        });
        // Load media for the selected stage even when it was previously hidden.
        stages[active].querySelectorAll<HTMLImageElement>('img').forEach((img) => {
          if (img.loading === 'lazy') img.loading = 'eager';
        });
        // Keep the active tab visible in the horizontal mobile stage navigation.
        const activeLink = links[active];
        if (stepNavigation && activeLink && stepNavigation.scrollWidth > stepNavigation.clientWidth) {
          const navBox = stepNavigation.getBoundingClientRect();
          const linkBox = activeLink.getBoundingClientRect();
          const left = stepNavigation.scrollLeft + linkBox.left - navBox.left - (navBox.width - linkBox.width) / 2;
          stepNavigation.scrollTo({ left: Math.max(0, left), behavior: 'auto' });
        }
        if (previous) previous.disabled = active === 0;
        if (next) {
          next.textContent = active === stages.length - 1 ? 'Revoir depuis le début ↺' : 'Suivant →';
          next.setAttribute('aria-label', active === stages.length - 1 ? 'Revenir à la première étape' : 'Étape suivante');
        }
        if (counter) counter.textContent = `Étape ${active + 1} sur ${stages.length}`;
        if (moveFocus) {
          history.replaceState(null, '', `#etape-${active + 1}`);
          stages[active].querySelector<HTMLElement>('h3')?.focus({ preventScroll: true });
          tutorial?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        }
      }

      function getHashStage() {
        const match = location.hash.match(/^#etape-(\d+)$/);
        if (!match) return 0;
        const number = Number(match[1]);
        return Number.isInteger(number) && number > 0 && number <= stages.length ? number - 1 : 0;
      }

      if (stages.length) {
        tutorial.dataset.enhanced = 'true';
        showStage(getHashStage());
        window.addEventListener('workshop:audio-chapter', (event: Event) => {
          const index = (event as CustomEvent<{ index: number }>).detail?.index;
          if (Number.isInteger(index) && index >= 0 && index < stages.length) showStage(index);
        });
        const notifyAudio = (index: number) => window.dispatchEvent(new CustomEvent('workshop:stage-selected', { detail: { index } }));
        links.forEach((link, index) => link.addEventListener('click', (event) => {
          event.preventDefault();
          showStage(index, true);
          notifyAudio(index);
        }));
        previous?.addEventListener('click', () => { const selected = active - 1; showStage(selected, true); notifyAudio(selected); });
        next?.addEventListener('click', () => { const selected = active === stages.length - 1 ? 0 : active + 1; showStage(selected, true); notifyAudio(selected); });
        window.addEventListener('hashchange', () => {
          if (/^#etape-\d+$/.test(location.hash)) { const selected = getHashStage(); showStage(selected); notifyAudio(selected); }
        });
      }
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SiteFooter />
</BaseLayout>

<style>
  .workshop-experience-photo figcaption .workshop-rice-credit{display:block;max-width:15rem;margin-top:.2rem;font:400 .7rem/1.35 sans-serif;color:#493d30;letter-spacing:normal;text-transform:none}
  .workshop-rice-credit a{color:inherit;text-decoration:underline;text-underline-offset:.2em}
  .workshop-rice-story{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:clamp(1.25rem,4vw,3.5rem);max-width:1280px;margin:clamp(2rem,6vw,5rem) auto;padding:clamp(1.2rem,3.5vw,2.8rem);border:1px solid #d8c7ae;border-radius:1.3rem;background:#f3eadc;color:#322b23}
