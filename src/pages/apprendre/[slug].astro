---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import CulinaryIcon from '../../components/CulinaryIcon.astro';
import GlossaryStrip from '../../components/GlossaryStrip.astro';
import { workshops } from '../../data/workshops';
import { workshopNarration, mortarStepImages, mortarImagePackReady } from '../../data/workshopAudio';
import type { Workshop } from '../../data/workshops';
import { recipes } from '../../data/recipes';
import { getGlossaryEntries } from '../../data/glossary';
import '../../styles/v16-editorial.css';
import '../../styles/workshop-immersive.css';

export function getStaticPaths() {
  return workshops.map((workshop: Workshop) => ({
    params: { slug: workshop.slug },
    props: { workshop }
  }));
}

const { workshop } = Astro.props as { workshop: Workshop };
const index = workshops.findIndex((item) => item.slug === workshop.slug);
const nextWorkshop = workshops[(index + 1) % workshops.length];
const relatedRecipes = recipes.filter((recipe) => workshop.relatedRecipes.includes(recipe.slug));
const glossary = getGlossaryEntries(workshop.glossarySlugs ?? []);
const narration = workshopNarration(workshop);
const audioPrefix = `/audio/workshops/${workshop.slug}/`;
const trackPaths = ['intro.mp3', ...workshop.steps.map((_, i) => `etape-${String(i + 1).padStart(2, '0')}.mp3`)].map((name) => audioPrefix + name);
const audioReady = trackPaths.every((url) => {
  try { return fs.statSync(path.join(process.cwd(), 'public', url.slice(1))).size > 1024; }
  catch { return false; }
});
const narrationPayload = { ...narration, audio: audioReady ? trackPaths : [] };
const hasPilotPhotos = workshop.slug === 'piler-aromates-au-mortier' && mortarImagePackReady;
const pilotAlt = [
  'Aromates cambodgiens émincés avant le travail au mortier.',
  'Les ingrédients fermes commencent à être pilés dans un mortier en pierre.',
  'La pâte aromatique se transforme progressivement en mélange plus homogène.',
  'La pâte de kroeung liée et parfumée après le pilage.'
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.cuisine-du-cambodge.com/' },
    { '@type': 'ListItem', position: 2, name: 'Ateliers', item: 'https://www.cuisine-du-cambodge.com/apprendre/' },
    { '@type': 'ListItem', position: 3, name: workshop.title, item: `https://www.cuisine-du-cambodge.com/apprendre/${workshop.slug}/` }
  ]
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: workshop.title,
  description: workshop.objective,
  totalTime: `PT${Number(workshop.duration.match(/\d+/)?.[0] ?? 0)}M`,
  step: workshop.steps.map((step, stepIndex) => ({
    '@type': 'HowToStep',
    position: stepIndex + 1,
    name: step.title,
    text: step.action
  })),
  inLanguage: 'fr-FR',
  url: `https://www.cuisine-du-cambodge.com/apprendre/${workshop.slug}/`
};
---
<BaseLayout
  title={`${workshop.title} — Atelier | Cuisine du Cambodge`}
  description={workshop.objective}
>
  <SiteHeader />

  <main class="v16-editorial workshop-detail">
    <section class="workshop-detail-hero">
      <div class="workshop-detail-hero-copy" data-reveal="up">
        <a class="workshop-detail-back" href="/apprendre/">← Tous les ateliers</a>
        <p class="v16-page-kicker"><CulinaryIcon name={workshop.icon} size={18} /> Atelier {workshop.n} · {workshop.eyebrow}</p>
        <h1>{workshop.title}</h1>
        <p class="workshop-detail-intro">{workshop.intro}</p>
        <dl class="workshop-detail-facts">
          <div><dt>Durée</dt><dd>{workshop.duration}</dd></div>
          <div><dt>Niveau</dt><dd>{workshop.level}</dd></div>
          <div><dt>Étapes</dt><dd>{workshop.steps.length}</dd></div>
        </dl>
        <section class="workshop-voice" data-workshop-voice aria-label="Guide audio de l’atelier">
          <div class="workshop-voice-title"><span class="workshop-voice-icon" aria-hidden="true">♫</span><strong>Écouter le guide de cuisine</strong></div>
          <p>Un récit à une seule voix pour accompagner vos gestes, étape après étape.</p>
          <div class="workshop-voice-controls" role="group" aria-label="Commandes audio">
            <button data-voice-play type="button">▶ Écouter</button>
            <button data-voice-pause type="button" disabled>Ⅱ Pause</button>
            <button data-voice-next type="button">Étape suivante →</button>
            <button data-voice-stop type="button" disabled>■ Arrêter</button>
          </div>
          <p data-voice-status role="status" aria-live="polite">Présentation — prêt à écouter (voix de votre appareil)</p>
          <details><summary>Lire la transcription de la narration</summary><p data-voice-transcript>{narration.intro}</p></details>
          <small>{audioReady ? 'Narration préenregistrée et générée par IA. Elle ne représente pas la voix d’une véritable cuisinière.' : 'Prévisualisation gratuite avec la voix française de votre appareil. La voix signature reste à enregistrer et à valider.'}</small>
        </section>
      </div>
      <div class="workshop-detail-orbit" aria-hidden="true">
        <span>{workshop.n}</span>
        <i></i>
        <b>{workshop.eyebrow}</b>
      </div>
    </section>

    <aside class="workshop-voice-dock" data-voice-dock hidden aria-label="Lecture vocale en cours"><span data-voice-dock-label>Guide audio</span><button type="button" data-voice-dock-pause aria-label="Mettre en pause">Ⅱ</button><button type="button" data-voice-dock-stop aria-label="Arrêter la narration">■</button></aside>

    <nav class="workshop-progress" aria-label="Progression de l’atelier" data-workshop-progress>
      {workshop.steps.map((step, stepIndex) => (
        <a href={`#etape-${stepIndex + 1}`} data-workshop-progress-link={stepIndex + 1}>
          <span>{String(stepIndex + 1).padStart(2, '0')}</span>
          <em>{step.title}</em>
        </a>
      ))}
    </nav>

    <section class="workshop-detail-opening">
      <div>
        <p class="v16-page-kicker">Ce que vous allez apprendre</p>
        <h2>Un geste à comprendre, pas une recette à recopier.</h2>
      </div>
      <ul class="workshop-outcomes">
        {workshop.outcomes.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <section class="workshop-prepare">
      <div>
        <p class="v16-page-kicker">Avant de commencer</p>
        <h2>Préparez juste ce qu’il faut pour observer.</h2>
      </div>
      <ul>{workshop.prepare.map((item) => <li>{item}</li>)}</ul>
    </section>

    <section class="workshop-step-list" aria-label="Étapes de l’atelier">
      {workshop.steps.map((step, stepIndex) => (
        <article id={`etape-${stepIndex + 1}`} class:list={["workshop-step", { "workshop-step--illustrated": hasPilotPhotos }]} data-workshop-step={stepIndex + 1} data-reveal="up">
          <div class="workshop-step-index">{String(stepIndex + 1).padStart(2, '0')}</div>
          {hasPilotPhotos && (
            <figure class="workshop-step-media">
              {stepIndex === 3 ? (
                <div class="workshop-texture-compare">
                  <div><img src={mortarStepImages[1]} alt="La pâte aromatique encore grossière en cours de pilage" width="1240" height="930" loading="lazy" decoding="async" /><span>Avant</span></div>
                  <div><img src={mortarStepImages[3]} alt="La pâte plus fine et homogène après le pilage" width="1240" height="930" loading="lazy" decoding="async" /><span>Après</span></div>
                </div>
              ) : (
                <img src={mortarStepImages[stepIndex]} alt={pilotAlt[stepIndex]} width="1240" height="930" loading="lazy" decoding="async" />
              )}
              <figcaption>Illustrations pédagogiques générées par IA · Étape {stepIndex + 1}</figcaption>
            </figure>
          )}
          <div class="workshop-step-copy">
            <p class="v16-mini-label">Étape {stepIndex + 1}</p>
            <h2>{step.title}</h2>
            <p class="workshop-step-action">{step.action}</p>
            <button type="button" class="workshop-step-listen" data-voice-step={stepIndex} aria-pressed="false">♫ Écouter cette étape</button>

            <div class="workshop-learning-grid">
              <section>
                <span>À observer</span>
                <p>{step.observe}</p>
              </section>
              <section>
                <span>Le bon repère</span>
                <p>{step.cue}</p>
              </section>
              {step.mistake && (
                <section>
                  <span>À éviter</span>
                  <p>{step.mistake}</p>
                </section>
              )}
              <section class="workshop-success">
                <span>Vous avez réussi si…</span>
                <p>{step.success}</p>
              </section>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="workshop-takeaway" data-reveal="up">
      <p class="v16-page-kicker">À retenir</p>
      <blockquote>{workshop.takeaway}</blockquote>
    </section>

    {relatedRecipes.length > 0 && (
      <section class="workshop-practice" data-reveal="up">
        <header>
          <p class="v16-page-kicker">Passer à la pratique</p>
          <h2>Utilisez maintenant ce geste dans une vraie recette.</h2>
          <p>L’atelier vous donne le repère. La recette vous donne les quantités et l’enchaînement complet.</p>
        </header>
        <div class="workshop-practice-grid">
          {relatedRecipes.map((recipe) => (
            <a href={`/recettes/${recipe.slug}/`}>
              <span>Recette</span>
              <strong>{recipe.title}</strong>
              <p>{recipe.intro}</p>
              <em>Préparer cette recette →</em>
            </a>
          ))}
        </div>
      </section>
    )}

    <GlossaryStrip entries={glossary} />

    <section class="workshop-next" data-reveal="up">
      <p class="v16-page-kicker">Continuer</p>
      <a href={`/apprendre/${nextWorkshop.slug}/`}>
        <span>Atelier {nextWorkshop.n}</span>
        <strong>{nextWorkshop.title}</strong>
        <em>Atelier suivant →</em>
      </a>
    </section>
  </main>

  <script type="application/json" data-workshop-narration set:html={JSON.stringify(narrationPayload).replace(/</g, "\\u003c")} />
  <script>
    import { initWorkshopAudio } from "../../scripts/workshopAudio";
    initWorkshopAudio();
    const progress = document.querySelector('[data-workshop-progress]');
    const links = Array.from(document.querySelectorAll('[data-workshop-progress-link]'));
    const steps = Array.from(document.querySelectorAll('[data-workshop-step]'));

    if (progress && links.length && steps.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (!visible) return;
        const active = visible.target.getAttribute('data-workshop-step');
        links.forEach((link) => {
          if (link.getAttribute('data-workshop-progress-link') === active) {
            link.setAttribute('aria-current', 'step');
          } else {
            link.removeAttribute('aria-current');
          }
        });
      }, { rootMargin: '-30% 0px -55% 0px', threshold: [0, 0.25, 0.6] });

      steps.forEach((step) => observer.observe(step));
    }
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SiteFooter />
</BaseLayout>
