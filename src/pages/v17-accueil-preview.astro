---
/**
 * D2 — Reconstruction indépendante de la maquette V17 approuvée.
 * Preview seulement. Ne jamais remplacer / avant validation graphique et médias.
 * La référence canonique est enregistrée dans docs/v17-plan-directeur-accueil.md.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/v17-accueil-rebuild.css';
import '../styles/v17-generated-media.css';
const hero = '/images/cuisine/v17-hero-amok-genere.webp';
const market = '/images/cuisine/v17-market-live-1800.jpg';
const kampot = '/images/cuisine/kampot-1600.webp';
const table = '/images/cuisine/v17-tablee-khmere-generee.webp';
const dessertGenerated = '/images/cuisine/v17-desserts-khmers-generes.webp';
const galangal = '/images/cuisine/v17-galangal-1000.jpg';
const chili = '/images/cuisine/v17-chili-450.png';
---
<BaseLayout
  title="V17 — Prévisualisation du nouvel accueil | Cuisine du Cambodge"
  description="Prévisualisation non publiée de la page d'accueil : recettes, ingrédients, gestes, repas et desserts cambodgiens."
  image={hero}
  imageAlt="Illustration éditoriale générée d’un Amok de poisson"
  noindex
>
  <a class="v17r-skip" href="#v17r-main">Aller au contenu</a>
  <div class="v17r-wrap" data-v17r-preview>
    <SiteHeader />
    <main class="v17r" id="v17r-main">
      <section class="v17r-hero v17r-hero--generated" aria-labelledby="v17r-hero-title">
        <div class="v17r-hero-art" aria-hidden="true">
          <svg class="v17r-temple-illustration" viewBox="0 0 900 430" xmlns="http://www.w3.org/2000/svg" fill="none">
            <g fill="#b58c50" opacity=".38"><path d="M50 430V311h105v-61h35v-69h25v-38h26v38h26v69h37v61h78V252h25v-43h25v-52h23v-40h25v40h22v52h27v43h95v58h59V248h32v-48h28v-50h23v50h28v48h32v63h89v119H50Z"/><path d="M427 157l15-74 17-40 17 40 18 74z"/></g>
            <g stroke="#b58c50" stroke-width="5" opacity=".25"><path d="M17 430L84 360M748 430l84-120M660 430l25-120M206 430l19-100"/></g>
          </svg>
          <img class="v17r-botanic v17r-hero-green-corner" src="/images/brand/v17-banana-leaves.svg" alt="" width="560" height="690" />
          <img class="v17r-botanic v17r-hero-bloom-left" src="/images/brand/v17-plumeria.svg" alt="" width="340" height="340" />
          <span class="v17r-calligraphy v17r-hero-sidebar" aria-hidden="true">Des saveurs vraies,<br/>un voyage gourmand.</span>
        </div>
        <div class="v17r-hero-copy">
          <p class="v17r-eyebrow">Des saveurs vraies, un voyage gourmand.</p>
          <h1 id="v17r-hero-title">LE CAMBODGE<br/>DANS VOTRE <span>ASSIETTE</span></h1>
          <p>Des recettes parfumées, des ingrédients à découvrir et des gestes pour cuisiner le Cambodge chez soi.</p>
          <a class="v17r-pill" href="/recettes/">Découvrir les recettes <span aria-hidden="true">↗</span></a>
        </div>
        <div class="v17r-hero-media">
          <figure class="v17r-hero-dish">
            <img src={hero} sizes="(max-width: 760px) 96vw, 54vw" width="1448" height="1086" fetchpriority="high" decoding="async" alt="Illustration générée d’un Amok Trey au poisson, à la noix de coco, aux aromates et aux piments, dans des feuilles de bananier" />
            <figcaption>Amok Trey <span>Poisson, coco et aromates</span></figcaption>
          </figure>
          <span class="v17r-label" aria-hidden="true">DES SAVEURS<br/>VRAIES ✳</span>
          <span class="v17r-handnote v17r-note-amok" aria-hidden="true">Amok Trey ↘</span>
          <img class="v17r-botanic v17r-hero-flower-dish" src="/images/brand/v17-plumeria.svg" alt="" width="340" height="340" />
          <img class="v17r-botanic v17r-hero-lime" src="/images/brand/v17-lime.svg" alt="" width="420" height="360" />
          <span class="v17r-calligraphy v17r-hero-aromatics" aria-hidden="true">Coco<br/>Citronnelle<br/>Piment<br/>Poivre…<br/>et bien plus !</span>
          <svg class="v17r-decoration v17r-leaf" viewBox="0 0 150 200" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M20 178C38 87 94 32 133 13C147 92 112 166 20 178Z" fill="#54873F"/><path d="M20 178C69 123 101 81 133 13M68 115L54 66M93 88L116 97" stroke="#24432A" stroke-width="5" stroke-linecap="round"/></svg>
        </div>
      </section>
      <div class="v17r-wave v17r-wave-ivory" aria-hidden="true"><svg viewBox="0 0 1440 95" preserveAspectRatio="none"><path d="M0 0C130 12 225 82 394 40S750 6 900 46s360 25 540-5v54H0Z" fill="#143929"/></svg></div>

      <section class="v17r-market" aria-labelledby="v17r-market-title">
        <figure class="v17r-market-visual">
          <img src={market} sizes="(max-width: 760px) 100vw, 72vw" width="1800" height="1350" loading="lazy" decoding="async" alt="Étals et visiteurs d’un marché alimentaire à Phnom Penh au Cambodge" />
          <div class="v17r-market-postcard">
            <img src="/images/cuisine/v17-fruit-market-960.jpg" width="960" height="640" loading="lazy" decoding="async" alt="Fruits présentés sur un étal de marché au Cambodge, autre photographie documentaire" />
            <span aria-hidden="true">Un marché, mille couleurs</span>
          </div>
          <figcaption>Marché alimentaire de Phnom Penh · Radosław Botev</figcaption>
        </figure>
        <div class="v17r-market-copy">
          <img class="v17r-botanic v17r-market-flower" src="/images/brand/v17-plumeria.svg" alt="" width="340" height="340" />
          <span class="v17r-handnote v17r-market-note" aria-hidden="true">Des marchés<br/>pleins de vie ↙</span>
          <p class="v17r-kicker">01 — Les produits</p>
          <h2 id="v17r-market-title">TOUT PART DES <em>BONS PRODUITS.</em></h2>
          <p>Les marchés, les épices, les herbes fraîches : autant de parfums à apprivoiser.</p>
          <a class="v17r-pill" href="/ingredients/">Explorer les ingrédients <span aria-hidden="true">↗</span></a>
          <a class="v17r-underlink" href="/glossaire/">Voir aussi le glossaire <span aria-hidden="true">↗</span></a>
        </div>
      </section>
      <div class="v17r-wave v17r-wave-green" aria-hidden="true"><svg viewBox="0 0 1440 95" preserveAspectRatio="none"><path d="M0 36C166 -3 330 66 499 35S848 6 1030 44 1271 85 1440 21v74H0Z" fill="#fff9ec"/></svg></div>

      <section class="v17r-palette" aria-labelledby="v17r-palette-title">
        <p class="v17r-kicker">Des parfums uniques</p>
        <h2 id="v17r-palette-title">UNE PALETTE<br/><em>D’INGRÉDIENTS</em><br/>D’EXCEPTION</h2>
        <p class="v17r-palette-intro">Citronnelle, galanga, combava, piment, poivre de Kampot… Chaque ingrédient a sa place dans cet équilibre de saveurs.</p>
        <div class="v17r-palette-media">
          <img class="v17r-botanic v17r-lemongrass" src="/images/brand/v17-lemongrass.svg" alt="" width="670" height="420" />
          <img class="v17r-botanic v17r-palette-lime" src="/images/brand/v17-lime.svg" alt="" width="420" height="360" />
          <img class="v17r-botanic v17r-palette-flower" src="/images/brand/v17-plumeria.svg" alt="" width="340" height="340" />
          <img class="v17r-spice-bowls" src="/images/brand/v17-spice-bowls.svg" alt="" aria-hidden="true" width="840" height="500" loading="lazy" decoding="async" />
          <span class="v17r-calligraphy v17r-palette-spice-label" aria-hidden="true">Poivre de Kampot<br/>et curcuma</span>
          <figure class="v17r-palette-a">
            <img src={galangal} sizes="(max-width: 760px) 42vw, 24vw" width="1000" height="538" loading="lazy" decoding="async" alt="Rhizomes de galanga, photographie botanique générique" />
            <figcaption>Le galanga</figcaption>
          </figure>
          <img class="v17r-palette-chili" src={chili} alt="" aria-hidden="true" width="450" height="474" loading="lazy" decoding="async" />
          <figure class="v17r-palette-b">
            <img src={kampot} srcset="/images/cuisine/kampot-800.webp 800w, /images/cuisine/kampot-1600.webp 1600w" sizes="(max-width: 760px) 42vw, 24vw" width="1600" height="1067" loading="lazy" decoding="async" alt="Poivre de Kampot" />
            <figcaption>Le poivre de Kampot</figcaption>
          </figure>
        </div>
        <a class="v17r-pill" href="/glossaire/">En savoir plus <span aria-hidden="true">↗</span></a>
      </section>

      <section class="v17r-gestures" aria-labelledby="v17r-gestures-title">
        <div class="v17r-gestures-visual" data-media-status="photographie-geste-generique">
          <figure class="v17r-gestures-main">
            <img src="/images/cuisine/v17-mortar-hands-1600.jpg" width="1600" height="1067" loading="lazy" decoding="async" alt="Mains utilisant un mortier en pierre pour broyer des aromates, photographie illustrative du geste" />
            <figcaption>Le pilage au mortier · photo d’illustration</figcaption>
          </figure>
          <figure class="v17r-gestures-kroeung">
            <img src="/images/cuisine/v17-kroeung-final.jpg" alt="Pâte de kroeung rouge après préparation, photographie distincte" width="800" height="600" loading="lazy" decoding="async" />
            <figcaption>Texture du kroeung préparé</figcaption>
          </figure>
          <img class="v17r-botanic v17r-gestures-flower" src="/images/brand/v17-plumeria.svg" alt="" width="340" height="340" />
          <span class="v17r-calligraphy v17r-gestures-handnote" aria-hidden="true">Le geste et<br/>les arômes</span>
          <span class="v17r-image-warning">Geste photographié à titre d’illustration, non documenté comme une préparation khmère.</span>
        </div>
        <div class="v17r-gestures-copy">
          <p class="v17r-kicker">02 — Les gestes</p>
          <h2 id="v17r-gestures-title">COUPER.<br/><em>PILER.</em><br/>SENTIR.</h2>
          <p>Des gestes simples pour libérer les arômes : la préparation compte autant que les ingrédients.</p>
          <a class="v17r-pill" href="/apprendre/piler-aromates-au-mortier/">Voir les étapes <span aria-hidden="true">↗</span></a>
        </div>
        <ol class="v17r-gestures-steps" aria-label="Les trois gestes">
          <li><span aria-hidden="true">✎</span><div><strong>COUPER</strong><small>Préparer les aromates</small></div></li>
          <li><span aria-hidden="true">◉</span><div><strong>PILER</strong><small>Travailler la texture</small></div></li>
          <li><span aria-hidden="true">✳</span><div><strong>SENTIR</strong><small>Reconnaître les parfums</small></div></li>
        </ol>
      </section>
      <div class="v17r-wave v17r-wave-cream" aria-hidden="true"><svg viewBox="0 0 1440 95" preserveAspectRatio="none"><path d="M0 12C135 89 327 7 495 45S839 65 1010 26 1241 79 1440 38v57H0Z" fill="#69361e"/></svg></div>

      <section class="v17r-table v17r-table--generated" aria-labelledby="v17r-table-title">
        <div class="v17r-table-media">
          <figure class="v17r-table-amok"><img src={table} width="1600" height="900" loading="lazy" decoding="async" alt="Illustration éditoriale générée d’une table conviviale d’inspiration cambodgienne, avec différents plats, currys, nouilles, riz et aromates" /></figure>
        </div>
        <div class="v17r-table-copy">
          <img class="v17r-botanic v17r-table-flower" src="/images/brand/v17-plumeria.svg" alt="" width="340" height="340" />
          <p class="v17r-kicker">03 — À table</p>
          <h2 id="v17r-table-title">DES PLATS<br/><em>QUI RASSEMBLENT.</em></h2>
          <p>Poissons, currys, salades, soupes… Des plats généreux que l’on aime retrouver et partager.</p>
          <a class="v17r-pill" href="/recettes/">Découvrir les recettes <span aria-hidden="true">↗</span></a>
          <a class="v17r-table-sub" href="/culture/construire-repas-cambodgien/">Comprendre le repas cambodgien →</a>
        </div>
        <span class="v17r-calligraphy v17r-table-handnote" aria-hidden="true">Frais<br/>Coloré<br/>Généreux</span>
        <p class="v17r-table-clarity">Illustration culinaire générée par IA : composition éditoriale d’un repas inspiré de la cuisine cambodgienne.</p>
      </section>

      <section class="v17r-dessert" aria-labelledby="v17r-dessert-title">
        <div class="v17r-dessert-copy">
          <p class="v17r-kicker">04 — Les douceurs</p>
          <h2 id="v17r-dessert-title">DES DESSERTS<br/>TOUT EN FINESSE.</h2>
          <p>Num Plae Ai, Num Kom, Chek Ktis… Riz gluant, coco et douceurs à partager pour prolonger le voyage.</p>
          <a class="v17r-pill" href="/recettes/chek-ktis/">Découvrir le Chek Ktis <span aria-hidden="true">↗</span></a>
        </div>
        <div class="v17r-dessert-art v17r-dessert-art--generated">
          <figure class="v17r-dessert-generated">
            <img src={dessertGenerated} width="1448" height="1086" loading="lazy" decoding="async" alt="Illustration générée de douceurs d’inspiration khmère : riz gluant au lait de coco, mangue, fruits et gâteaux enveloppés de feuilles de bananier" />
            <figcaption>Riz gluant, mangue, coco et feuilles de bananier · illustration culinaire IA</figcaption>
          </figure>
        </div>
      </section>

      <section class="v17r-finale" aria-labelledby="v17r-finale-title">
        <div class="v17r-finale-landscape">
          <img src="/images/cuisine/v17-angkor-dusk-1800.jpg" width="1800" height="1013" loading="lazy" decoding="async" alt="Angkor Wat au crépuscule, photographie documentaire" />
        </div>
        <div class="v17r-finale-stamp" aria-hidden="true">
          <svg viewBox="0 0 240 240" xmlns="http://www.w3.org/2000/svg">
            <circle cx="120" cy="120" r="112" fill="none" stroke="currentColor" stroke-width="3"/>
            <circle cx="120" cy="120" r="91" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 8"/>
            <path d="M58 163h124M72 157v-31h12v-19h16v-17h10V75h20v15h10v17h16v19h12v31M95 158v-22l7-12 7 12v22M131 158v-22l7-12 7 12v22M118 159V99l9-15 9 15v60" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round"/>
            <text x="120" y="52" font-size="16" font-weight="800" text-anchor="middle" fill="currentColor" letter-spacing="2">UNE CUISINE</text>
            <text x="120" y="198" font-size="16" font-weight="800" text-anchor="middle" fill="currentColor" letter-spacing="2">UN VOYAGE</text>
          </svg>
        </div>
        <div class="v17r-finale-copy">
          <p class="v17r-kicker">05 — À vous de jouer</p>
          <h2 id="v17r-finale-title">CUISINEZ,<br/>PARTAGEZ,<br/><em>VOYAGEZ.</em></h2>
          <p>Des recettes, des ateliers et des découvertes pour faire entrer les saveurs du Cambodge dans votre quotidien.</p>
          <div class="v17r-finale-actions">
            <a class="v17r-pill" href="/apprendre/">Nos ateliers <span aria-hidden="true">↗</span></a>
            <a class="v17r-pill v17r-pill-outline" href="/recettes/">Toutes les recettes <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <p class="v17r-finale-credit">Angkor au crépuscule : photo <a href="https://commons.wikimedia.org/wiki/File:Angkor_Wat_at_dusk,_Siem_Reap,_Cambodia.jpg" target="_blank" rel="noopener noreferrer">Eric Hossinger</a>, <a href="https://creativecommons.org/licenses/by/2.0/" target="_blank" rel="noopener noreferrer">CC BY 2.0</a> ; redimensionnement et cadrage CSS.</p>
      </section>

      <aside class="v17r-preview-notice" aria-label="Statut et sources du prototype">
        <details><summary>Sources photographiques et état de la prévisualisation</summary>
        <p><strong>Prévisualisation technique V17 — non publiée.</strong> Ce parcours reprend la structure et les liens de la maquette validée. Le pilage est illustré par une photographie de mains au mortier, sans allégation de provenance cambodgienne ; le kroeung est représenté par une photo distincte. La finale emploie un cliché réel d'Angkor au crépuscule. Les illustrations du hero Amok, de la tablée et des desserts sont générées par IA et ne sont pas des photographies documentaires. Les autres photographies d’ingrédients, de marché et de gestes restent créditées selon leurs sources ; aucune recette n’est présentée comme réalisée par l’équipe. <a href="/credits-photos/">Crédits des photographies existantes</a>. Nouvelles sources :
        
        <a href="https://commons.wikimedia.org/wiki/File:Market_in_Phnom_Penh.jpg" target="_blank" rel="noopener noreferrer">marché — Radosław Botev / Fundacja Nomos, CC BY 3.0 PL, redimensionné</a> ;
        <a href="https://www.pexels.com/photo/woman-hands-holding-mortar-21937648/" target="_blank" rel="noopener noreferrer">mortier — Filipp Romanovski, Pexels License, illustration générique</a> ;
        
        <a href="https://commons.wikimedia.org/wiki/File:Angkor_Wat_at_dusk,_Siem_Reap,_Cambodia.jpg" target="_blank" rel="noopener noreferrer">Angkor — Eric Hossinger, CC BY 2.0, redimensionné</a> ;
        <a href="https://commons.wikimedia.org/wiki/File:Fish_Amok_with_Rice.jpg" target="_blank" rel="noopener noreferrer">Amok — sharonang, CC0</a> ;
        <a href="https://commons.wikimedia.org/wiki/File:Cambodia_08_-_038_-_fruit_at_the_market_(3198828515).jpg" target="_blank" rel="noopener noreferrer">marché — McKay Savage, CC BY 2.0</a> ;
        
        <a href="https://commons.wikimedia.org/wiki/File:Chek_ktis.jpg" target="_blank" rel="noopener noreferrer">Chek Ktis — Marie, CC BY-SA 2.0</a> ;
        <a href="https://commons.wikimedia.org/wiki/File:Num_kom_sticky_rice_cake_Khmer_Cambodian_dessert.jpg" target="_blank" rel="noopener noreferrer">Num Kom — MoonsMoon, CC BY 4.0</a> ;
        <a href="https://commons.wikimedia.org/wiki/File:Galangal.jpg" target="_blank" rel="noopener noreferrer">galanga — Liza Daly, domaine public</a> ;
        <a href="https://commons.wikimedia.org/wiki/File:Red_Kroeung_Paste.jpg" target="_blank" rel="noopener noreferrer">texture de kroeung rouge — Trilinguist, CC BY-SA 3.0</a> ;
        <a href="https://commons.wikimedia.org/wiki/File:Red_Chili_Pepper_PNG.png" target="_blank" rel="noopener noreferrer">piment — Spicy Anonymous, CC0</a>.</p></details>
      </aside>
    </main>
    <SiteFooter />
  </div>
  <script>
    import { initV17AccueilMotion } from '../scripts/v17AccueilMotion';
    initV17AccueilMotion();
  </script>
</BaseLayout>
