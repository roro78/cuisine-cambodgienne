---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { recipes } from '../../data/recipes';
import type { Recipe } from '../../data/recipes';
import { ingredientGuides } from '../../data/ingredients';
import GlossaryStrip from '../../components/GlossaryStrip.astro';
import { getGlossaryEntries } from '../../data/glossary';
import { imageSrcSet } from '../../utils/images';
import CulinaryIcon from '../../components/CulinaryIcon.astro';

export function getStaticPaths() {
  return recipes.map((recipe: Recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe }
  }));
}

const { recipe } = Astro.props;
const notes = recipe.notes ?? [];
const keyPoints = recipe.keyPoints ?? [];
const relatedIngredients = ingredientGuides.filter((item) => (recipe.relatedIngredients ?? []).includes(item.slug));

const glossarySlugs = [
  ...(recipe.slug === 'amok-trey' ? ['amok', 'kroeung', 'combava', 'lait-de-coco', 'sucre-de-palme'] : []),
  ...(recipe.slug === 'lok-lak' ? ['poivre-de-kampot'] : []),
  ...(recipe.slug === 'kroeung-jaune' ? ['kroeung', 'citronnelle', 'combava', 'galanga', 'curcuma'] : [])
];
const glossary = getGlossaryEntries(glossarySlugs);

const recipeFaqs = recipe.slug === 'amok-trey'
  ? [
      {
        question: 'Pourquoi mon amok devient-il sec ?',
        answer: 'La cuisson est probablement trop forte ou trop longue. L’amok doit être juste pris et encore souple : une vapeur douce et un arrêt de cuisson dès que la texture se tient donnent un meilleur résultat.'
      },
      {
        question: 'Peut-on préparer le kroeung à l’avance ?',
        answer: 'Oui. Le kroeung peut être préparé à l’avance et conservé au réfrigérateur dans un récipient hermétique. Son parfum reste meilleur quand il est utilisé assez rapidement.'
      },
      {
        question: 'Comment savoir si l’assaisonnement est juste avant cuisson ?',
        answer: 'Goûtez la base coco-kroeung avant d’ajouter le poisson. Elle doit être parfumée, salée sans excès et légèrement arrondie par le sucre.'
      }
    ]
  : recipe.slug === 'lok-lak'
    ? [
        {
          question: 'Pourquoi le bœuf rend-il de l’eau au lieu de colorer ?',
          answer: 'La poêle n’est pas assez chaude ou elle est trop chargée. Saisissez le bœuf en petites quantités et laissez l’humidité s’évaporer rapidement pour obtenir une vraie coloration.'
        },
        {
          question: 'Quand ajouter la sauce du lok lak ?',
          answer: 'Ajoutez-la en fin de cuisson, une fois la viande bien colorée. Elle doit juste enrober les morceaux sans les faire bouillir.'
        },
        {
          question: 'Comment utiliser le poivre de Kampot dans le lok lak ?',
          answer: 'Moulez-le au dernier moment dans le condiment au citron vert ou juste avant le service pour conserver sa fraîcheur aromatique.'
        }
      ]
    : [
        {
          question: 'Pourquoi mon kroeung reste-t-il fibreux ?',
          answer: 'Les aromates ont probablement été coupés trop gros. Émincez très finement citronnelle et galanga avant de piler, puis travaillez les ingrédients les plus durs en premier.'
        },
        {
          question: 'Peut-on faire un kroeung au mixeur ?',
          answer: 'Oui, mais ajoutez le moins de liquide possible. Trop d’eau dilue les parfums et donne une texture moins concentrée.'
        },
        {
          question: 'Comment savoir si le kroeung est assez travaillé ?',
          answer: 'La pâte doit devenir homogène, humide et très parfumée, sans gros morceaux fibreux perceptibles.'
        }
      ];
const totalMinutes = (value: string) => {
  const match = value.match(/(\d+)/);
  return match ? Number(match[1]) : 0;
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.cuisine-du-cambodge.com/' },
    { '@type': 'ListItem', position: 2, name: 'Recettes', item: 'https://www.cuisine-du-cambodge.com/recettes/' },
    { '@type': 'ListItem', position: 3, name: recipe.title, item: `https://www.cuisine-du-cambodge.com/recettes/${recipe.slug}/` }
  ]
};

const recipeFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: recipeFaqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
};

const recipeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: recipe.title,
  description: recipe.description,
  recipeYield: recipe.servings,
  prepTime: `PT${totalMinutes(recipe.prepTime)}M`,
  cookTime: `PT${totalMinutes(recipe.cookTime)}M`,
  totalTime: `PT${totalMinutes(recipe.prepTime) + totalMinutes(recipe.cookTime)}M`,
  recipeIngredient: recipe.ingredients,
  recipeInstructions: recipe.steps.map((text: string, index: number) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: `Étape ${index + 1}`,
    text
  })),
  recipeCategory: recipe.category,
  recipeCuisine: 'Cambodgienne',
  author: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  publisher: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  keywords: recipe.tags.join(', '),
  inLanguage: 'fr-FR',
  url: `https://www.cuisine-du-cambodge.com/recettes/${recipe.slug}/`,
  image: new URL(recipe.image, Astro.site ?? new URL('https://www.cuisine-du-cambodge.com')).href
};
---
<BaseLayout title={`${recipe.title} — Recette cambodgienne | Cuisine du Cambodge`} description={recipe.description} image={recipe.image} imageAlt={recipe.imageAlt}>
  <SiteHeader />
  <main class="recipe-page editorial-detail recipe-detail">
    <section class="recipe-hero-shell">
      <header class="recipe-hero" data-reveal="up">
        <p class="eyebrow">Recette cambodgienne</p>
        <h1>{recipe.title}</h1>
        {recipe.khmerName && <p class="khmer-name">{recipe.khmerName}</p>}
        <p class="recipe-intro">{recipe.intro}</p>
        <p class="recipe-context">{recipe.context}</p>

        <dl class="recipe-facts" aria-label="Informations de la recette">
          <div>
            <CulinaryIcon name="servings" />
            <dt>Pour</dt>
            <dd>{recipe.servings}</dd>
          </div>
          <div>
            <CulinaryIcon name="prep" />
            <dt>Préparation</dt>
            <dd>{recipe.prepTime}</dd>
          </div>
          <div>
            <CulinaryIcon name="cook" />
            <dt>Cuisson</dt>
            <dd>{recipe.cookTime}</dd>
          </div>
          <div>
            <CulinaryIcon name="level" />
            <dt>Niveau</dt>
            <dd>{recipe.difficulty}</dd>
          </div>
        </dl>
      </header>

      <figure class="recipe-cover" data-parallax="0.07">
        <img src={recipe.image} srcset={imageSrcSet(recipe.image, recipe.imageWidths)} sizes="(max-width: 900px) 100vw, 52vw" alt={recipe.imageAlt} width={recipe.imageWidth} height={recipe.imageHeight} decoding="async" />
        <figcaption>Photographie illustrative · voir les crédits en bas de page.</figcaption>
      </figure>
    </section>

    <section class="recipe-layout" data-reveal="up">
      <aside class="ingredients-panel">
        <p class="eyebrow recipe-section-label"><CulinaryIcon name="servings" size={17} /> Ingrédients</p>
        <ul>
          {recipe.ingredients.map((ingredient: string) => <li>{ingredient}</li>)}
        </ul>
      </aside>

      <article class="method-panel">
        <p class="eyebrow recipe-section-label"><CulinaryIcon name="cook" size={17} /> Méthode</p>
        <ol>
          {recipe.steps.map((step: string) => <li data-recipe-step>{step}</li>)}
        </ol>
        {keyPoints.length > 0 && (
          <div class="recipe-keypoints">
            <p class="eyebrow">Les points clés</p>
            <ul>{keyPoints.map((point: string) => <li>{point}</li>)}</ul>
          </div>
        )}
        {notes.length > 0 && (
          <div class="recipe-notes">
            <h2>À retenir</h2>
            <ul>{notes.map((note: string) => <li>{note}</li>)}</ul>
          </div>
        )}
      </article>
    </section>

    <section class="recipe-faq" aria-labelledby="recipe-faq-title" data-reveal="up">
      <header>
        <p class="eyebrow">Questions de cuisine</p>
        <h2 id="recipe-faq-title">Les réponses qui évitent de rater la recette.</h2>
      </header>
      <div>
        {recipeFaqs.map((item) => (
          <details>
            <summary>{item.question}<span aria-hidden="true">+</span></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <GlossaryStrip entries={glossary} />

    {relatedIngredients.length > 0 && (
      <section class="recipe-related" data-reveal="up">
        <p class="eyebrow">Pour comprendre le plat</p>
        <h2>Les ingrédients à connaître</h2>
        <div class="related-links">
          {relatedIngredients.map((item) => (
            <a href={`/ingredients/${item.slug}/`}>
              <strong>{item.title}</strong>
              <span>{item.intro}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="recipe-back">
      <a class="text-link" href="/recettes/">← Toutes les recettes</a>
    </nav>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(recipeSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(recipeFaqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SiteFooter />
</BaseLayout>
