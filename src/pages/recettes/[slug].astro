---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { recipes, ingredientText, getServingsLabel } from '../../data/recipes';
import type { Recipe, RecipeIngredient } from '../../data/recipes';
import { ingredientGuides } from '../../data/ingredients';
import GlossaryStrip from '../../components/GlossaryStrip.astro';
import { getGlossaryEntries } from '../../data/glossary';
import { imageSrcSet } from '../../utils/images';
import '../../styles/recipe-v15.css';

export function getStaticPaths() {
  return recipes.map((recipe: Recipe) => ({
    params: { slug: recipe.slug },
    props: { recipe }
  }));
}

const { recipe } = Astro.props as { recipe: Recipe };
const notes = recipe.notes ?? [];
const keyPoints = recipe.keyPoints ?? [];
const substitutions = recipe.substitutions ?? [];
const equipment = recipe.equipment ?? [];
const faqs = recipe.faqs ?? [];
const relatedIngredients = ingredientGuides.filter((item) => (recipe.relatedIngredients ?? []).includes(item.slug));
const glossary = getGlossaryEntries((recipe.relatedIngredients ?? []).filter((slug) => ['kroeung','poivre-de-kampot','tamarin','prahok'].includes(slug)));

const groupedIngredients = recipe.ingredients.reduce<Record<string, RecipeIngredient[]>>((groups, ingredient) => {
  const key = ingredient.group ?? 'Ingrédients';
  groups[key] ??= [];
  groups[key].push(ingredient);
  return groups;
}, {});

const totalMinutes = (value: string) => {
  const match = value.match(/(\d+)/);
  return match ? Number(match[1]) : 0;
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.cuisine-du-cambodge.com/' },
    { '@type': 'ListItem', position: 2, name: 'Recettes', item: 'https://www.cuisine-du-cambodge.com/recettes/' },
    { '@type': 'ListItem', position: 3, name: recipe.title, item: `https://www.cuisine-du-cambodge.com/recettes/${recipe.slug}/` }
  ]
};

const recipeFaqSchema = faqs.length ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer }
  }))
} : null;

const recipeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: recipe.title,
  description: recipe.description,
  recipeYield: getServingsLabel(recipe),
  prepTime: `PT${totalMinutes(recipe.prepTime)}M`,
  cookTime: `PT${totalMinutes(recipe.cookTime)}M`,
  totalTime: `PT${totalMinutes(recipe.prepTime) + totalMinutes(recipe.cookTime)}M`,
  recipeIngredient: recipe.ingredients.map(ingredientText),
  recipeInstructions: recipe.steps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.title,
    text: step.text
  })),
  recipeCategory: recipe.category,
  recipeCuisine: 'Cambodgienne',
  author: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  publisher: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  keywords: recipe.tags.join(', '),
  inLanguage: 'fr-FR',
  url: `https://www.cuisine-du-cambodge.com/recettes/${recipe.slug}/`,
  ...(recipe.image ? { image: new URL(recipe.image, Astro.site ?? new URL('https://www.cuisine-du-cambodge.com')).href } : {})
};
---
<BaseLayout title={`${recipe.title} — Recette cambodgienne | Cuisine du Cambodge`} description={recipe.description} image={recipe.image} imageAlt={recipe.imageAlt}>
  <SiteHeader />

  <main class="recipe-v15">
    <section class="recipe-v15-hero">
      <div class="recipe-v15-hero-copy" data-reveal="up">
        <p class="eyebrow">Recette cambodgienne · {recipe.category}</p>
        <h1>{recipe.title}</h1>
        {recipe.khmerName && <p class="khmer-name">{recipe.khmerName}</p>}
        <p class="recipe-intro">{recipe.intro}</p>
        <p class="recipe-context">{recipe.context}</p>

        <dl class="recipe-v15-facts" aria-label="Informations de la recette">
          <div><dt>Pour</dt><dd>{getServingsLabel(recipe)}</dd></div>
          <div><dt>Préparation</dt><dd>{recipe.prepTime}</dd></div>
          <div><dt>Cuisson</dt><dd>{recipe.cookTime}</dd></div>
          <div><dt>Niveau</dt><dd>{recipe.difficulty}</dd></div>
        </dl>
      </div>

      {recipe.image ? (
        <figure class="recipe-v15-cover" data-parallax="0.045">
          <img
            src={recipe.image}
            srcset={imageSrcSet(recipe.image, recipe.imageWidths ?? [480,800,1200,1600])}
            sizes="(max-width: 900px) 100vw, 52vw"
            alt={recipe.imageAlt ?? recipe.title}
            width={recipe.imageWidth ?? 1600}
            height={recipe.imageHeight ?? 1067}
            decoding="async"
          />
        </figure>
      ) : (
        <div class="recipe-v15-cover recipe-v15-cover-fallback" aria-label={`Illustration typographique de ${recipe.title}`}>
          <span>{recipe.moment ?? 'Cuisine cambodgienne'}</span>
          <strong>{recipe.title}</strong>
        </div>
      )}
    </section>

    <section class="recipe-v15-kitchen">
      <aside class="recipe-v15-sidebar">
        <div
          class="recipe-servings-card"
          data-recipe-servings-root
          data-base-servings={recipe.baseServings}
          data-min-servings={recipe.servingsLabel ? recipe.baseServings : 1}
          data-max-servings={recipe.servingsLabel ? recipe.baseServings : 12}
        >
          <div class="recipe-serving-title">
            <h2>Ingrédients</h2>
            {!recipe.servingsLabel && (
              <span class="recipe-serving-current"><strong data-serving-current>{recipe.baseServings}</strong> <span data-serving-label>personnes</span></span>
            )}
          </div>

          {!recipe.servingsLabel && (
            <>
              <div class="recipe-serving-controls" aria-label="Ajuster le nombre de personnes">
                <button type="button" data-serving-action="decrease" aria-label="Retirer une personne">−</button>
                <strong data-serving-current>{recipe.baseServings}</strong>
                <button type="button" data-serving-action="increase" aria-label="Ajouter une personne">+</button>
              </div>
              <div class="recipe-serving-presets" aria-label="Portions rapides">
                {[2,4,6,8].map((value) => (
                  <button type="button" data-serving-value={value} aria-pressed={value === recipe.baseServings ? 'true' : 'false'}>{value} pers.</button>
                ))}
              </div>
            </>
          )}

          {Object.entries(groupedIngredients).map(([group, ingredients]) => (
            <section class="recipe-ingredient-group" aria-label={group}>
              <h3>{group}</h3>
              <ul class="recipe-ingredient-list">
                {ingredients.map((ingredient) => (
                  <li>
                    <input type="checkbox" data-ingredient-check aria-label={`Cocher ${ingredient.name}`} />
                    <label>
                      <span>
                        {ingredient.quantity !== undefined && (
                          <>
                            <span
                              class="qty"
                              data-ingredient-quantity
                              data-base-quantity={ingredient.quantity}
                              data-unit={ingredient.unit ?? ''}
                              data-scalable={ingredient.scalable === false ? 'false' : 'true'}
                            >{ingredient.quantity}</span>
                            {ingredient.unit && <span class="unit"> {ingredient.unit}</span>}
                          </>
                        )}
                      </span>
                      <span>{ingredient.name}{ingredient.note ? ` — ${ingredient.note}` : ''}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </section>
          ))}

          {equipment.length > 0 && (
            <section class="recipe-equipment">
              <h3>Matériel</h3>
              <ul>{equipment.map((item) => <li>{item}</li>)}</ul>
            </section>
          )}

          {substitutions.length > 0 && (
            <section class="recipe-substitutions">
              <h3>Si vous cuisinez en France</h3>
              <ul>{substitutions.map((item) => <li>{item}</li>)}</ul>
            </section>
          )}
        </div>
      </aside>

      <article class="recipe-guided-method">
        <header>
          <p class="eyebrow">Cuisine guidée</p>
          <h2>Faites la recette étape par étape.</h2>
          <p>Chaque étape vous dit quoi faire, quoi regarder et quelle erreur éviter. Cochez au fur et à mesure.</p>
        </header>

        <div class="recipe-guided-steps">
          {recipe.steps.map((step, index) => (
            <section class="recipe-guided-step" data-guided-step>
              <div class="recipe-step-number">{String(index + 1).padStart(2,'0')}</div>
              <div>
                <div class="recipe-step-topline">
                  <h3>{step.title}</h3>
                  {step.duration && <span class="recipe-step-duration">{step.duration}</span>}
                </div>
                <p>{step.text}</p>
                {step.cue && <div class="recipe-step-cue"><strong>Le bon repère</strong>{step.cue}</div>}
                {step.mistake && <div class="recipe-step-mistake"><strong>À éviter</strong>{step.mistake}</div>}
                <button type="button" class="recipe-step-toggle" data-step-toggle aria-pressed="false">Marquer comme faite</button>
              </div>
            </section>
          ))}
        </div>
      </article>
    </section>

    {(keyPoints.length > 0 || notes.length > 0) && (
      <div class="recipe-v15-after">
        {keyPoints.length > 0 && (
          <section>
            <p class="eyebrow">Les points clés</p>
            <h2>Ce qu’il faut retenir.</h2>
            <ul>{keyPoints.map((point) => <li>{point}</li>)}</ul>
          </section>
        )}
        {notes.length > 0 && (
          <section>
            <p class="eyebrow">Mémo</p>
            <h2>Pour la prochaine fois.</h2>
            <ul>{notes.map((note) => <li>{note}</li>)}</ul>
          </section>
        )}
      </div>
    )}

    {faqs.length > 0 && (
      <section class="recipe-v15-faq" aria-labelledby="recipe-faq-title">
        <header>
          <p class="eyebrow">Questions de cuisine</p>
          <h2 id="recipe-faq-title">Les réponses qui évitent de rater la recette.</h2>
        </header>
        <div>
          {faqs.map((item) => (
            <details>
              <summary>{item.question}<span aria-hidden="true">+</span></summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <GlossaryStrip entries={glossary} />

    {relatedIngredients.length > 0 && (
      <section class="recipe-related" data-reveal="up">
        <p class="eyebrow">Pour comprendre le plat</p>
        <h2>Les ingrédients à connaître</h2>
        <div class="related-links">
          {relatedIngredients.map((item) => (
            <a href={`/ingredients/${item.slug}/`}>
              <strong>{item.title}</strong>
              <span>{item.intro}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="recipe-back">
      <a class="text-link" href="/recettes/">← Toutes les recettes</a>
    </nav>
  </main>

  <script>
    import { initRecipeServings, initRecipeChecklist, initRecipeSteps } from '../../scripts/recipeServings';
    initRecipeServings();
    initRecipeChecklist();
    initRecipeSteps();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(recipeSchema)} />
  {recipeFaqSchema && <script type="application/ld+json" set:html={JSON.stringify(recipeFaqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SiteFooter />
</BaseLayout>
