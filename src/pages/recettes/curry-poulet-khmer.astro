---
import RestoredRecipe from '../../components/RestoredRecipe.astro';
import { restoredRecipes } from '../../data/restoredRecipes';
const recipe = restoredRecipes.find((item) => item.slug === 'curry-poulet-khmer');
if (!recipe) throw new Error('Missing restored recipe: curry-poulet-khmer');
---
<RestoredRecipe recipe={recipe} />
