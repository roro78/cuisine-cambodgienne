---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { recipes } from '../../data/recipes';
import { imageSrcSet } from '../../utils/images';
import '../../styles/recipe-v15.css';
import '../../styles/v16-editorial.css';

const minutes = (value: string) => Number(value.match(/\d+/)?.[0] ?? 0);
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Recettes cambodgiennes',
  description: 'Recettes cambodgiennes guidées, ajustables et pensées pour cuisiner chez soi.',
  url: 'https://www.cuisine-du-cambodge.com/recettes/',
  inLanguage: 'fr-FR',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: recipes.map((recipe, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: recipe.title,
      url: `https://www.cuisine-du-cambodge.com/recettes/${recipe.slug}/`
    }))
  }
};

const toneMap: Record<string,string> = {
  river: '--tone-a:#24465a;--tone-b:#8fb6b5',
  market: '--tone-a:#7a3f2f;--tone-b:#d7a24e',
  pepper: '--tone-a:#302f24;--tone-b:#82915f',
  coconut: '--tone-a:#6f5a43;--tone-b:#e0c79e',
  herbs: '--tone-a:#31533b;--tone-b:#9cb96d',
  fire: '--tone-a:#6c2f22;--tone-b:#dc8a44',
  rice: '--tone-a:#7a6849;--tone-b:#d9c9a0',
  sunset: '--tone-a:#884d38;--tone-b:#e0a05f'
};
---
<BaseLayout
  title="Recettes cambodgiennes guidées | Cuisine du Cambodge"
  description="Découvrez des recettes cambodgiennes guidées pas à pas : portions ajustables, repères de cuisson, substitutions et conseils pour cuisiner chez soi."
>
  <SiteHeader />

  <main class="recipes-v15 recipes-v16">
    <section class="recipes-journey-hero">
      <div class="recipes-journey-copy" data-reveal="up">
        <p class="eyebrow">Cuisiner le Cambodge</p>
        <h1>Choisir un plat. Puis suivre le geste.</h1>
        <p>Des recettes faites pour donner faim d’abord, puis guider vraiment : quantités ajustables, repères de texture et conseils utiles quand vient le moment de cuisiner.</p>
        <div class="recipes-journey-stamp" aria-label="Atouts des recettes">
          <span>{recipes.length} recettes</span>
          <span>Portions ajustables</span>
          <span>Étapes guidées</span>
          <span>Substitutions en France</span>
        </div>
      </div>

      <div class="recipes-journey-visual" aria-hidden="true">
        <figure><img src="/images/cuisine/kep-market-1600.webp" srcset={imageSrcSet('/images/cuisine/kep-market-1600.webp',[480,800,1200,1600])} sizes="(max-width: 900px) 100vw, 55vw" alt="" width="1600" height="1067" decoding="async" /></figure>
      </div>
    </section>

    <section class="recipe-filter-bar" aria-label="Filtrer les recettes" data-reveal="up">
      <button type="button" class="is-active" data-recipe-filter="all" aria-pressed="true">Toutes</button>
      <button type="button" data-recipe-filter="rapide" aria-pressed="false">≤ 30 min</button>
      <button type="button" data-recipe-filter="facile" aria-pressed="false">Faciles</button>
      <button type="button" data-recipe-filter="poisson" aria-pressed="false">Poisson</button>
      <button type="button" data-recipe-filter="bœuf" aria-pressed="false">Bœuf</button>
      <button type="button" data-recipe-filter="porc" aria-pressed="false">Porc</button>
      <button type="button" data-recipe-filter="soupe" aria-pressed="false">Soupes</button>
      <button type="button" data-recipe-filter="street" aria-pressed="false">Street food</button>
      <button type="button" data-recipe-filter="dessert" aria-pressed="false">Desserts</button>
    </section>

    <p class="recipe-filter-status" aria-live="polite" data-filter-status>{recipes.length} recettes</p>

    <section class="recipe-v15-grid" aria-label="Recettes" data-recipe-grid>
      {recipes.map((recipe) => (
        <a
          class="recipe-v15-card"
          href={`/recettes/${recipe.slug}/`}
          data-recipe-card
          data-difficulty={recipe.difficulty.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')}
          data-tags={`${recipe.tags.join(' ')} ${recipe.category}`.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')}
          data-total-minutes={minutes(recipe.prepTime) + minutes(recipe.cookTime)}
          data-reveal="up"
        >
          {recipe.image ? (
            <figure class="recipe-v15-card-media">
              <img
                src={recipe.image}
                srcset={imageSrcSet(recipe.image, recipe.imageWidths ?? [480,800,1200,1600])}
                sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 34vw"
                alt={recipe.imageAlt ?? recipe.title}
                width={recipe.imageWidth ?? 1600}
                height={recipe.imageHeight ?? 1067}
                loading="lazy"
                decoding="async"
              />
            </figure>
          ) : (
            <div class="recipe-v15-card-fallback" style={toneMap[recipe.visualTone ?? 'market']}>
              <strong>{recipe.title}</strong>
            </div>
          )}

          <div class="recipe-v15-card-copy">
            <div class="recipe-v15-card-meta">
              <span>{recipe.category}</span>
              <span>{recipe.prepTime} + {recipe.cookTime}</span>
              <span>{recipe.difficulty}</span>
            </div>
            <h2>{recipe.title}</h2>
            <p>{recipe.intro}</p>
            <span class="recipe-v15-card-cta">Cuisiner cette recette</span>
          </div>
        </a>
      ))}
    </section>
  </main>

  <script>
    import { initRecipeFilters } from '../../scripts/recipeFilters';
    initRecipeFilters();
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <SiteFooter />
</BaseLayout>
