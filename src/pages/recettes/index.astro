---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { recipes } from '../../data/recipes';
---
<BaseLayout title="Recettes cambodgiennes | Cuisine du Cambodge" description="Découvrez les recettes cambodgiennes et les techniques qui permettent de retrouver les saveurs de la cuisine khmère.">
  <SiteHeader />
  <main class="listing-page editorial-listing recipes-listing">
    <header class="page-intro page-intro-split" data-reveal="up">
      <p class="eyebrow">Cuisiner</p>
      <h1>Recettes cambodgiennes</h1>
      <p>Des plats à faire pour de vrai : amok crémeux, bœuf saisi, kroeung très parfumé, sauces fraîches et riz chaud. Des recettes pensées pour donner envie de passer en cuisine.</p>
      <div class="page-intro-visual" data-parallax="0.10"><img src={recipes[0].image} alt={recipes[0].imageAlt} /></div>
    </header>

    <section class="card-grid" aria-label="Recettes" data-reveal="up">
      {recipes.map((recipe) => (
        <a class="content-card-link" href={`/recettes/${recipe.slug}/`}>
          <article class="content-card">
            <div class="card-visual"><img src={recipe.image} alt={recipe.imageAlt} loading="lazy" /></div>
            <p class="card-meta">{recipe.difficulty} · {recipe.prepTime}</p>
            <h2>{recipe.title}</h2>
            <p>{recipe.intro}</p>
            <span class="text-link">Voir la recette</span>
          </article>
        </a>
      ))}
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
