---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EditorialSectionHero from '../../components/EditorialSectionHero.astro';
import { recipes } from '../../data/recipes';
import { recipeTechniqueGuides } from '../../data/recipeTechniques';
import '../../styles/recipe-techniques.css';
import { imageSrcSet } from '../../utils/images';
import '../../styles/recipe-v15.css';
import '../../styles/v16-editorial.css';
import '../../styles/v17-generated-recipes.css';
import '../../styles/v19-premium-pages.css';
import '../../styles/editorial-shared-hero.css';

const minutes = (value: string) => Number(value.match(/\d+/)?.[0] ?? 0);
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Recettes cambodgiennes',
  description: 'Des recettes cambodgiennes à préparer chez soi, de l’amok de poisson aux soupes parfumées.',
  url: 'https://www.cuisine-du-cambodge.com/recettes/',
  inLanguage: 'fr-FR',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: recipes.map((recipe, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: recipe.title,
      url: `https://www.cuisine-du-cambodge.com/recettes/${recipe.slug}/`
    }))
  }
};

const toneMap: Record<string,string> = {
  river: '--tone-a:#24465a;--tone-b:#8fb6b5',
  market: '--tone-a:#7a3f2f;--tone-b:#d7a24e',
  pepper: '--tone-a:#302f24;--tone-b:#82915f',
  coconut: '--tone-a:#6f5a43;--tone-b:#e0c79e',
  herbs: '--tone-a:#31533b;--tone-b:#9cb96d',
  fire: '--tone-a:#6c2f22;--tone-b:#dc8a44',
  rice: '--tone-a:#7a6849;--tone-b:#d9c9a0',
  sunset: '--tone-a:#884d38;--tone-b:#e0a05f'
};
---
<BaseLayout
  title="Recettes cambodgiennes à cuisiner chez soi | Cuisine du Cambodge"
  description="Découvrez la cuisine cambodgienne chez vous : les ingrédients, les quantités et chaque étape pour réussir vos plats."
>
  <SiteHeader />

  <main class="recipes-v15 recipes-v16 v16-editorial">
    <EditorialSectionHero
      kicker="Cuisiner le Cambodge"
      title="Les saveurs du Cambodge, chez vous."
      description="Amok de poisson, lok lak au bœuf, soupes parfumées, nouilles et desserts… Retrouvez les plats cambodgiens à cuisiner chez vous. Chaque recette explique les ingrédients, les quantités et les gestes, de la préparation jusqu’au service."
      image="/images/cuisine/kroeung-1600.webp"
      imageWidth={1600}
      imageHeight={1067}
      imageSrcSet={imageSrcSet('/images/cuisine/kroeung-1600.webp',[480,800,1200,1600])}
      imageSizes="(max-width: 900px) 100vw, 52vw"
    />

    <section class="recipe-filter-bar" aria-label="Filtrer les recettes">
      <button type="button" class="is-active" data-recipe-filter="all" aria-pressed="true">Toutes</button>
      <button type="button" data-recipe-filter="rapide" aria-pressed="false">≤ 30 min</button>
      <button type="button" data-recipe-filter="facile" aria-pressed="false">Faciles</button>
      <button type="button" data-recipe-filter="poisson" aria-pressed="false">Poisson</button>
      <button type="button" data-recipe-filter="bœuf" aria-pressed="false">Bœuf</button>
      <button type="button" data-recipe-filter="porc" aria-pressed="false">Porc</button>
      <button type="button" data-recipe-filter="soupe" aria-pressed="false">Soupes</button>
      <button type="button" data-recipe-filter="street" aria-pressed="false">Street food</button>
      <button type="button" data-recipe-filter="dessert" aria-pressed="false">Desserts</button>
    </section>

    <p class="recipe-filter-status" aria-live="polite" data-filter-status>{recipes.length} recettes</p>

    <section class="recipe-v15-grid" aria-label="Recettes" data-recipe-grid>
      {recipes.map((recipe) => (
        <a
          class="recipe-v15-card"
          href={`/recettes/${recipe.slug}/`}
          data-recipe-card
          data-difficulty={recipe.difficulty.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')}
          data-tags={`${recipe.tags.join(' ')} ${recipe.category}`.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')}
          data-total-minutes={minutes(recipe.prepTime) + minutes(recipe.cookTime)}
          data-reveal="up"
        >
          {recipe.image ? (
            <figure class="recipe-v15-card-media">
              <img
                src={recipe.image}
                srcset={recipe.imageWidths?.length ? imageSrcSet(recipe.image, recipe.imageWidths) : undefined}
                sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 34vw"
                alt={recipe.imageAlt ?? recipe.title}
                width={recipe.imageWidth ?? 1600}
                height={recipe.imageHeight ?? 1067}
                loading="lazy"
                decoding="async"
              />
            </figure>
          ) : (
            <div class="recipe-v15-card-fallback" style={toneMap[recipe.visualTone ?? 'market']}>
              <strong>{recipe.title}</strong>
            </div>
          )}

          <div class="recipe-v15-card-copy">
            <div class="recipe-v15-card-meta">
              <span>{recipe.category}</span>
              <span>{minutes(recipe.cookTime) > 0 ? `${recipe.prepTime} de préparation · ${recipe.cookTime} de cuisson` : `${recipe.prepTime} de préparation`}</span>
              <span>{recipe.difficulty}</span>
            </div>
            <h2>{recipe.title}</h2>
            <p>{recipe.intro}</p>
            <span class="recipe-v15-card-cta">Voir la recette</span>
          </div>
        </a>
      ))}
    </section>

    <section class="recipe-technique-explore" aria-labelledby="recipe-technique-explore-title">
      <p class="eyebrow">Pour ne plus cuisiner à l’aveugle</p>
      <h2 id="recipe-technique-explore-title">Les préparations expliquées pas à pas</h2>
      <p>Quand une recette parle de bouillon ou de pickles, les proportions et la méthode comptent. Retrouvez les bases avant de vous lancer.</p>
      <div>
        {recipeTechniqueGuides.map((guide) => (
          <a href={`/techniques/${guide.slug}/`}>
            <strong>{guide.slug === 'bouillon-leger-maison' ? 'Préparer un bouillon léger' : 'Faire des pickles carotte-concombre'}</strong>
            <span>{guide.preparation}</span>
            <em>Suivre la méthode →</em>
          </a>
        ))}
      </div>
    </section>
  </main>

  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <SiteFooter />
</BaseLayout>
