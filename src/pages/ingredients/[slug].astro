---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { ingredientGuides } from '../../data/ingredients';
import type { IngredientGuide } from '../../data/ingredients';
import GlossaryStrip from '../../components/GlossaryStrip.astro';
import { getGlossaryEntries } from '../../data/glossary';
import { recipes } from '../../data/recipes';
import { cultureArticles } from '../../data/culture';
import { imageSrcSet } from '../../utils/images';
import CulinaryIcon from '../../components/CulinaryIcon.astro';

export function getStaticPaths() {
  return ingredientGuides.map((ingredient: IngredientGuide) => ({
    params: { slug: ingredient.slug },
    props: { ingredient }
  }));
}

const { ingredient } = Astro.props;
const glossary = getGlossaryEntries([
  ingredient.slug,
  ...(ingredient.slug === 'kroeung' ? ['combava', 'galanga', 'citronnelle', 'curcuma'] : []),
  ...(ingredient.slug === 'poivre-de-kampot' ? ['sauce-de-poisson'] : []),
  ...(ingredient.slug === 'tamarin' ? ['sucre-de-palme', 'sauce-de-poisson'] : []),
  ...(ingredient.slug === 'prahok' ? ['kroeung', 'sauce-de-poisson', 'citronnelle'] : [])
]);

const relatedContent = ingredient.slug === 'kroeung'
  ? [
      recipes.find((item) => item.slug === 'amok-trey'),
      recipes.find((item) => item.slug === 'kroeung-jaune'),
      cultureArticles.find((item) => item.slug === 'comprendre-le-kroeung')
    ].filter(Boolean)
  : ingredient.slug === 'poivre-de-kampot'
    ? [
        recipes.find((item) => item.slug === 'lok-lak'),
        cultureArticles.find((item) => item.slug === 'poivre-de-kampot'),
      cultureArticles.find((item) => item.slug === 'kep-crabe-poivre')
      ].filter(Boolean)
    : ingredient.slug === 'tamarin'
      ? [
          cultureArticles.find((item) => item.slug === 'marches-herbes-cuisine-khmere')
        ].filter(Boolean)
      : ingredient.slug === 'prahok'
        ? [
            cultureArticles.find((item) => item.slug === 'prahok-fermentation'),
            cultureArticles.find((item) => item.slug === 'marches-herbes-cuisine-khmere')
          ].filter(Boolean)
        : [];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: ingredient.title,
  description: ingredient.seoDescription,
  image: new URL(ingredient.image, Astro.site ?? new URL('https://www.cuisine-du-cambodge.com')).href,
  inLanguage: 'fr-FR',
  author: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  publisher: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  mainEntityOfPage: `https://www.cuisine-du-cambodge.com/ingredients/${ingredient.slug}/`,
  about: { '@type': 'Thing', name: ingredient.title },
  keywords: [ingredient.title, 'cuisine cambodgienne', 'cuisine khmère', ...ingredient.profile].join(', ')
};

const ingredientFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `Comment utiliser ${ingredient.title} en cuisine ?`,
      acceptedAnswer: { '@type': 'Answer', text: ingredient.uses.join(' · ') }
    },
    {
      '@type': 'Question',
      name: `Comment choisir ${ingredient.title} ?`,
      acceptedAnswer: { '@type': 'Answer', text: ingredient.buying.join(' ') }
    },
    {
      '@type': 'Question',
      name: `Comment conserver ${ingredient.title} ?`,
      acceptedAnswer: { '@type': 'Answer', text: ingredient.storage.join(' ') }
    }
  ]
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.cuisine-du-cambodge.com/' },
    { '@type': 'ListItem', position: 2, name: 'Ingrédients', item: 'https://www.cuisine-du-cambodge.com/ingredients/' },
    { '@type': 'ListItem', position: 3, name: ingredient.title, item: `https://www.cuisine-du-cambodge.com/ingredients/${ingredient.slug}/` }
  ]
};
---
<BaseLayout title={`${ingredient.title} : goût, usages et conseils | Cuisine du Cambodge`} description={ingredient.seoDescription} image={ingredient.image} imageAlt={ingredient.imageAlt}>
  <SiteHeader />
  <main class="guide-page editorial-detail ingredient-detail">
    <section class="detail-hero-shell detail-hero-shell--ingredient">
      <header class="guide-hero" data-reveal="up">
        <p class="eyebrow">Ingrédient khmer</p>
        <h1>{ingredient.title}</h1>
        <p>{ingredient.intro}</p>
      </header>

      <figure class="guide-visual" data-parallax="0.07">
        <img src={ingredient.image} srcset={imageSrcSet(ingredient.image, ingredient.imageWidths)} sizes="(max-width: 900px) 100vw, 52vw" alt={ingredient.imageAlt} width={ingredient.imageWidth} height={ingredient.imageHeight} decoding="async" />
        <figcaption>Photographie illustrative · crédits et licence en bas de page.</figcaption>
      </figure>
    </section>

    <section class="ingredient-deep-dive" data-reveal="up">
      <div class="ingredient-deep-heading">
        <p class="eyebrow">Comprendre avant de cuisiner</p>
        <h2>Ce qu’il apporte vraiment dans l’assiette</h2>
      </div>
      <div class="ingredient-deep-copy">
        {ingredient.deepDive.map((paragraph: string) => <p>{paragraph}</p>)}
      </div>
    </section>

    <section class="guide-body" data-reveal="up">
      <div class="guide-main">
        <p class="eyebrow">Comprendre</p>
        <p class="guide-lead">{ingredient.role}</p>
      </div>
      <div class="guide-lists">
        <article>
          <h2><CulinaryIcon name="taste" size={22} />Quel goût&nbsp;?</h2>
          <ul>{ingredient.profile.map((item: string) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <h2><CulinaryIcon name="use" size={22} />Comment l’utiliser&nbsp;?</h2>
          <ul>{ingredient.uses.map((item: string) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <h2><CulinaryIcon name="tip" size={22} />Bien le travailler</h2>
          <ul>{ingredient.tips.map((item: string) => <li>{item}</li>)}</ul>
        </article>
      </div>
    </section>

    <section class="ingredient-practical" aria-labelledby="ingredient-practical-title" data-reveal="up">
      <header class="ingredient-practical-head">
        <p class="eyebrow">En pratique</p>
        <h2 id="ingredient-practical-title">Bien choisir, conserver et utiliser {ingredient.title}</h2>
        <p>Les détails qui évitent d’acheter au hasard, de perdre les arômes ou de déséquilibrer le plat.</p>
      </header>

      <div class="ingredient-practical-grid">
        <article>
          <h3><CulinaryIcon name="taste" size={20} /> Bien choisir</h3>
          <ul>{ingredient.choose.map((item: string) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <h3><CulinaryIcon name="tip" size={20} /> Conservation</h3>
          <ul>{ingredient.keep.map((item: string) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <h3><CulinaryIcon name="use" size={20} /> Bons accords</h3>
          <ul>{ingredient.pairings.map((item: string) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <h3><CulinaryIcon name="level" size={20} /> Erreurs à éviter</h3>
          <ul>{ingredient.mistakes.map((item: string) => <li>{item}</li>)}</ul>
        </article>
      </div>
    </section>

    <section class="ingredient-practical" data-reveal="up">
      <article>
        <p class="eyebrow">À l’achat</p>
        <h2>Bien le choisir</h2>
        <ul>{ingredient.buying.map((item: string) => <li>{item}</li>)}</ul>
      </article>
      <article>
        <p class="eyebrow">Après ouverture</p>
        <h2>Le conserver</h2>
        <ul>{ingredient.storage.map((item: string) => <li>{item}</li>)}</ul>
      </article>
      <article>
        <p class="eyebrow">Avec quoi&nbsp;?</p>
        <h2>Les bons accords</h2>
        <div class="ingredient-pairings">
          {ingredient.pairings.map((item: string) => <span>{item}</span>)}
        </div>
      </article>
      <article class="ingredient-practical--avoid">
        <p class="eyebrow">À éviter</p>
        <h2>Les erreurs fréquentes</h2>
        <ul>{ingredient.avoid.map((item: string) => <li>{item}</li>)}</ul>
      </article>
    </section>

    <GlossaryStrip entries={glossary} />

    {relatedContent.length > 0 && (
      <section class="editorial-related" data-reveal="up">
        <p class="eyebrow">Dans quels plats&nbsp;?</p>
        <h2>Voir cet ingrédient en cuisine</h2>
        <div class="editorial-related-links">
          {relatedContent.map((item: any) => {
            const isRecipe = 'prepTime' in item;
            const href = isRecipe
              ? `/recettes/${item.slug}/`
              : `/culture/${item.slug}/`;
            return (
              <a href={href}>
                <span>{isRecipe ? 'Recette' : 'Culture'}</span>
                <strong>{item.title}</strong>
                <em>{item.intro}</em>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <a class="text-link" href="/ingredients/">← Tous les ingrédients</a>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(ingredientFaqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SiteFooter />
</BaseLayout>
