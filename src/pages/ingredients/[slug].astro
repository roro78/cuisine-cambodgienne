---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { ingredientGuides } from '../../data/ingredients';
import type { IngredientGuide } from '../../data/ingredients';
import GlossaryStrip from '../../components/GlossaryStrip.astro';
import { getGlossaryEntries } from '../../data/glossary';
import { recipes } from '../../data/recipes';
import { cultureArticles } from '../../data/culture';
import { imageSrcSet } from '../../utils/images';

export function getStaticPaths() {
  return ingredientGuides.map((ingredient: IngredientGuide) => ({
    params: { slug: ingredient.slug },
    props: { ingredient }
  }));
}

const { ingredient } = Astro.props;
const glossary = getGlossaryEntries([
  ingredient.slug,
  ...(ingredient.slug === 'kroeung' ? ['combava', 'galanga'] : []),
  ...(ingredient.slug === 'prahok' ? ['kroeung'] : [])
]);

const relatedContent = ingredient.slug === 'kroeung'
  ? [
      recipes.find((item) => item.slug === 'amok-trey'),
      recipes.find((item) => item.slug === 'kroeung-jaune'),
      cultureArticles.find((item) => item.slug === 'comprendre-le-kroeung')
    ].filter(Boolean)
  : ingredient.slug === 'poivre-de-kampot'
    ? [
        recipes.find((item) => item.slug === 'lok-lak'),
        cultureArticles.find((item) => item.slug === 'poivre-de-kampot')
      ].filter(Boolean)
    : [];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: ingredient.title,
  description: ingredient.intro,
  image: ingredient.image,
  inLanguage: 'fr-FR',
  author: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  publisher: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  mainEntityOfPage: `https://www.cuisine-du-cambodge.com/ingredients/${ingredient.slug}/`
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.cuisine-du-cambodge.com/' },
    { '@type': 'ListItem', position: 2, name: 'Ingrédients', item: 'https://www.cuisine-du-cambodge.com/ingredients/' },
    { '@type': 'ListItem', position: 3, name: ingredient.title, item: `https://www.cuisine-du-cambodge.com/ingredients/${ingredient.slug}/` }
  ]
};
---
<BaseLayout title={`${ingredient.title} — Guide ingrédient | Cuisine du Cambodge`} description={ingredient.intro} image={ingredient.image} imageAlt={ingredient.imageAlt}>
  <SiteHeader />
  <main class="guide-page editorial-detail ingredient-detail">
    <header class="guide-hero" data-reveal="up">
      <p class="eyebrow">Ingrédient khmer</p>
      <h1>{ingredient.title}</h1>
      <p>{ingredient.intro}</p>
    </header>

    <figure class="guide-visual" data-parallax="0.10"><img src={ingredient.image} srcset={imageSrcSet(ingredient.image, [800, 1200, 1600])} sizes="100vw" alt={ingredient.imageAlt} width={ingredient.imageWidth} height={ingredient.imageHeight} decoding="async" /><figcaption>Photographie illustrative · crédits et licence en bas de page.</figcaption></figure>

    <section class="guide-body" data-reveal="up">
      <div class="guide-main">
        <p class="eyebrow">Comprendre</p>
        <p class="guide-lead">{ingredient.role}</p>
      </div>
      <div class="guide-lists">
        <article>
          <h2>Profil</h2>
          <ul>{ingredient.profile.map((item: string) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <h2>Usages</h2>
          <ul>{ingredient.uses.map((item: string) => <li>{item}</li>)}</ul>
        </article>
        <article>
          <h2>Conseils</h2>
          <ul>{ingredient.tips.map((item: string) => <li>{item}</li>)}</ul>
        </article>
      </div>
    </section>

    <GlossaryStrip entries={glossary} />

    {relatedContent.length > 0 && (
      <section class="editorial-related" data-reveal="up">
        <p class="eyebrow">À cuisiner ensuite</p>
        <h2>Voir cet ingrédient dans son contexte</h2>
        <div class="editorial-related-links">
          {relatedContent.map((item: any) => {
            const isRecipe = 'prepTime' in item;
            const href = isRecipe
              ? `/recettes/${item.slug}/`
              : `/culture/${item.slug}/`;
            return (
              <a href={href}>
                <span>{isRecipe ? 'Recette' : 'Culture'}</span>
                <strong>{item.title}</strong>
                <em>{item.intro}</em>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <a class="text-link" href="/ingredients/">← Tous les ingrédients</a>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SiteFooter />
</BaseLayout>
