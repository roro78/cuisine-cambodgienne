---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { ingredientGuides } from '../../data/ingredients';
import { imageSrcSet } from '../../utils/images';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Ingrédients de la cuisine cambodgienne',
  description: 'Kroeung, poivre de Kampot, tamarin, prahok et ingrédients de la cuisine khmère.',
  url: 'https://www.cuisine-du-cambodge.com/ingredients/',
  inLanguage: 'fr-FR',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: ingredientGuides.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: `https://www.cuisine-du-cambodge.com/ingredients/${item.slug}/`
    }))
  }
};
---
<BaseLayout title="Ingrédients khmers | Cuisine du Cambodge" description="Kroeung, poivre de Kampot, tamarin, prahok et aromates : comprendre les ingrédients de la cuisine cambodgienne.">
  <SiteHeader />
  <main class="listing-page editorial-listing ingredients-listing">
    <header class="page-intro page-intro-split" data-reveal="up">
      <p class="eyebrow">Les saveurs</p>
      <h1>Ingrédients & bases</h1>
      <p>Citronnelle fraîche, tamarin acidulé, poivre de Kampot, prahok, coco : ici, on découvre surtout ce que chaque ingrédient apporte dans la bouche et comment l’utiliser en cuisine.</p>
      <div class="page-intro-visual" data-parallax="0.10"><img src={ingredientGuides[0].image} srcset={imageSrcSet(ingredientGuides[0].image, [800, 1200, 1600])} sizes="100vw" alt={ingredientGuides[0].imageAlt} fetchpriority="high" decoding="async" /></div>
    </header>
    <section class="text-grid" data-reveal="up">
      {ingredientGuides.map((item) => (
        <a class="guide-link" href={`/ingredients/${item.slug}/`}>
          <article>
            <div class="guide-card-image"><img src={item.image} srcset={imageSrcSet(item.image, [480, 800, 1200])} sizes="(max-width: 720px) 100vw, 50vw" alt={item.imageAlt} loading="lazy" decoding="async" /></div>
            <p class="card-meta">Guide ingrédient</p>
            <h2>{item.title}</h2>
            <p>{item.intro}</p>
            <span class="text-link">Découvrir</span>
          </article>
        </a>
      ))}
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <SiteFooter />
</BaseLayout>
