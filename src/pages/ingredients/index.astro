---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { ingredientGuides } from '../../data/ingredients';
import { imageSrcSet } from '../../utils/images';
import { getGlossaryEntries } from '../../data/glossary';

const pantryEntries = getGlossaryEntries([
  'citronnelle',
  'galanga',
  'curcuma',
  'combava',
  'sauce-poisson',
  'sucre-de-palme',
  'lait-de-coco',
  'riz-jasmin'
]);

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Ingrédients de la cuisine cambodgienne',
  description: 'Kroeung, poivre de Kampot, tamarin, prahok et ingrédients de la cuisine khmère.',
  url: 'https://www.cuisine-du-cambodge.com/ingredients/',
  inLanguage: 'fr-FR',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: ingredientGuides.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.title,
      url: `https://www.cuisine-du-cambodge.com/ingredients/${item.slug}/`
    }))
  }
};
---
<BaseLayout title="Ingrédients cuisine cambodgienne : kroeung, prahok, Kampot…" description="Kroeung, prahok, poivre de Kampot, tamarin, citronnelle, galanga, combava : comprendre le goût, l’usage et les accords des ingrédients de la cuisine cambodgienne.">
  <SiteHeader />
  <main class="listing-page editorial-listing ingredients-listing">
    <header class="page-intro page-intro-split" data-reveal="up">
      <p class="eyebrow">Les saveurs</p>
      <h1>Ingrédients & bases</h1>
      <p>Citronnelle fraîche, tamarin acidulé, poivre de Kampot, prahok, coco : ici, on découvre surtout ce que chaque ingrédient apporte dans la bouche et comment l’utiliser en cuisine.</p>
      <div class="page-intro-visual" data-parallax="0.10"><img src={ingredientGuides[0].image} srcset={imageSrcSet(ingredientGuides[0].image, ingredientGuides[0].imageWidths)} sizes="(max-width: 900px) 100vw, 58vw" alt={ingredientGuides[0].imageAlt} width={ingredientGuides[0].imageWidth} height={ingredientGuides[0].imageHeight} fetchpriority="high" decoding="async" /></div>
    </header>

    <section class="ingredient-editorial-list" aria-label="Guides ingrédients">
      {ingredientGuides.map((item, index) => (
        <a class:list={['ingredient-feature', `ingredient-feature--v${index + 1}`]} href={`/ingredients/${item.slug}/`} data-reveal="up">
          <figure class="ingredient-feature-media" data-parallax={index % 2 === 0 ? '0.08' : '0.12'}>
            <img src={item.image} srcset={imageSrcSet(item.image, item.imageWidths)} sizes={index === 2 ? '100vw' : '(max-width: 800px) 100vw, 58vw'} alt={item.imageAlt} width={item.imageWidth} height={item.imageHeight} loading="lazy" decoding="async" />
          </figure>
          <div class="ingredient-feature-copy">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <p class="card-meta">Guide ingrédient</p>
            <h2>{item.title}</h2>
            <p>{item.intro}</p>
            <span class="text-link">Découvrir</span>
          </div>
        </a>
      ))}
    </section>

    <section class="ingredient-pantry" aria-labelledby="pantry-title" data-reveal="up">
      <header>
        <p class="eyebrow">Le garde-manger khmer</p>
        <h2 id="pantry-title">Huit autres saveurs à reconnaître.</h2>
        <p>Pas besoin d’une fiche longue pour commencer : voici les aromates et condiments que vous croiserez le plus souvent dans les recettes et les gestes de base.</p>
      </header>
      <div class="ingredient-pantry-grid">
        {pantryEntries.map((entry, index) => (
          <a href={`/glossaire/#${entry.slug}`} data-reveal="up" data-reveal-delay={Math.min(index * .03, .15)}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{entry.term}</strong>
            <p>{entry.short}</p>
          </a>
        ))}
      </div>
      <a class="text-link" href="/glossaire/">Voir tout le glossaire</a>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <SiteFooter />
</BaseLayout>
