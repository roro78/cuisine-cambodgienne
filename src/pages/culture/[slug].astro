---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { cultureArticles } from '../../data/culture';
import type { CultureArticle } from '../../data/culture';
import GlossaryStrip from '../../components/GlossaryStrip.astro';
import { getGlossaryEntries } from '../../data/glossary';
import { imageSrcSet } from '../../utils/images';
import CulinaryIcon from '../../components/CulinaryIcon.astro';

export function getStaticPaths() {
  return cultureArticles.map((article: CultureArticle) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;

const glossaryByArticle: Record<string, string[]> = {
  'le-riz-symbole-de-vie-au-cambodge': ['riz-jasmin'],
  'poivre-de-kampot': ['poivre-de-kampot'],
  'comprendre-le-kroeung': ['kroeung'],
  'comprendre-amok': ['amok'],
  'kep-marche-crabe-poivre': ['poivre-de-kampot'],
  'prahok-fermentation-umami': ['prahok'],
  'construire-repas-cambodgien': ['riz-jasmin']
};
const glossary = getGlossaryEntries(glossaryByArticle[article.slug] ?? []);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.seoDescription,
  image: new URL(article.image, Astro.site ?? new URL('https://www.cuisine-du-cambodge.com')).href,
  inLanguage: 'fr-FR',
  author: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  publisher: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  mainEntityOfPage: `https://www.cuisine-du-cambodge.com/culture/${article.slug}/`,
  about: { '@type': 'Thing', name: article.eyebrow },
  keywords: [article.eyebrow, 'cuisine cambodgienne', 'culture culinaire khmère'].join(', ')
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.cuisine-du-cambodge.com/' },
    { '@type': 'ListItem', position: 2, name: 'Carnets', item: 'https://www.cuisine-du-cambodge.com/culture/' },
    { '@type': 'ListItem', position: 3, name: article.title, item: `https://www.cuisine-du-cambodge.com/culture/${article.slug}/` }
  ]
};
---
<BaseLayout title={`${article.title} | Culture culinaire cambodgienne`} description={article.seoDescription} image={article.image} imageAlt={article.imageAlt}>
  <SiteHeader />
  <main class="culture-article editorial-detail culture-detail">
    <section class="detail-hero-shell detail-hero-shell--culture">
      <header class="culture-article-hero" data-reveal="up">
        <p class="eyebrow"><CulinaryIcon name="story" size={17} /> {article.eyebrow} · {article.readingTime}</p>
        <h1>{article.title}</h1>
        <p>{article.intro}</p>
      </header>

      <figure class="culture-visual" data-parallax="0.06">
        <img src={article.image} srcset={article.imageWidths.length ? imageSrcSet(article.image, article.imageWidths) : undefined} sizes="(max-width: 900px) 100vw, 52vw" alt={article.imageAlt} width={article.imageWidth} height={article.imageHeight} decoding="async" />
        <figcaption>
          {article.slug === 'le-riz-symbole-de-vie-au-cambodge' ? (
            <>Rizières près de Siem Reap · Photo Dmitry A. Mottl, CC BY-SA 4.0 · <a href="https://commons.wikimedia.org/wiki/File:Cambodia%27s_rice_fields.jpg" target="_blank" rel="noreferrer">Crédit et licence</a></>
          ) : article.slug === 'construire-repas-cambodgien' ? (
            <>Illustration éditoriale d’un repas partagé · <a href="/credits-photos/">crédits photo</a>.</>
          ) : <>Photographie illustrative · <a href="/credits-photos/">crédits photo</a>.</>}
        </figcaption>
      </figure>
    </section>

    <article class="culture-copy">
      {article.sections.map((section: CultureArticle['sections'][number], index: number) => (
        <>
        <section data-reveal={index % 2 === 0 ? 'up' : 'right'}>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
        </section>
        {article.gallery && index === 1 && (
          <div class="rice-photo-report" aria-label="Le riz des champs à la table">
            {article.gallery.slice(0, 2).map((photo) => (
              <figure>
                <img src={photo.image} alt={photo.imageAlt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
                <figcaption>{photo.caption} <small>{photo.credit} · <a href={photo.source} target="_blank" rel="noreferrer">Crédit et licence</a></small></figcaption>
              </figure>
            ))}
          </div>
        )}
        {article.gallery && index === 5 && article.gallery[2] && (
          <figure class="rice-festival-photo">
            <img src={article.gallery[2].image} alt={article.gallery[2].imageAlt} width={article.gallery[2].width} height={article.gallery[2].height} loading="lazy" decoding="async" />
            <figcaption>{article.gallery[2].caption} <small>{article.gallery[2].credit} · <a href={article.gallery[2].source} target="_blank" rel="noreferrer">Crédit et licence</a></small></figcaption>
          </figure>
        )}
        </>
      ))}

    </article>

    <GlossaryStrip entries={glossary} />

    <a class="text-link" href="/culture/">← Tous les carnets</a>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SiteFooter />
</BaseLayout>

<style>
  .culture-visual figcaption a{color:inherit;text-decoration:underline;text-underline-offset:.15em;font-size:inherit}
  .rice-photo-report{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:clamp(.8rem,2vw,1.5rem);margin:clamp(1.4rem,4vw,3rem) 0}
  .rice-photo-report figure,.rice-festival-photo{margin:0;min-width:0}
  .rice-photo-report img,.rice-festival-photo img{width:100%;height:clamp(15rem,33vw,23rem);object-fit:cover;border-radius:1rem;display:block}
  .rice-photo-report figcaption,.rice-festival-photo figcaption{padding:.75rem .25rem 0;color:#4d483e;font-size:.95rem;line-height:1.55}
  .rice-photo-report figcaption small,.rice-festival-photo figcaption small{display:block;margin-top:.3rem;font-size:.78rem}
  .rice-photo-report a,.rice-festival-photo a{color:#664c27;text-decoration:underline;text-underline-offset:.2em}
  .rice-festival-photo{max-width:42rem;margin:1.5rem auto 2rem}
  .rice-festival-photo img{max-height:32rem;object-position:center 44%}
  @media(max-width:720px){.rice-photo-report{grid-template-columns:1fr}.rice-photo-report img{height:auto;max-height:25rem}.rice-festival-photo img{height:auto;max-height:27rem}}
</style>
