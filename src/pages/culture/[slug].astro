---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { cultureArticles } from '../../data/culture';
import type { CultureArticle } from '../../data/culture';
import { recipes } from '../../data/recipes';
import { ingredientGuides } from '../../data/ingredients';
import GlossaryStrip from '../../components/GlossaryStrip.astro';
import { getGlossaryEntries } from '../../data/glossary';
import { imageSrcSet } from '../../utils/images';
import CulinaryIcon from '../../components/CulinaryIcon.astro';

export function getStaticPaths() {
  return cultureArticles.map((article: CultureArticle) => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

const { article } = Astro.props;

const glossaryByArticle: Record<string, string[]> = {
  'poivre-de-kampot': ['poivre-de-kampot'],
  'comprendre-le-kroeung': ['kroeung', 'citronnelle', 'galanga', 'combava', 'curcuma'],
  'comprendre-amok': ['amok', 'kroeung', 'lait-de-coco', 'combava'],
  'prahok-fermentation': ['prahok', 'kroeung'],
  'marches-herbes-cuisine-khmere': ['citronnelle', 'galanga', 'combava', 'num-banh-chok'],
  'transmission-cuisine-khmere': ['kroeung', 'prahok', 'amok', 'bobor']
};
const glossary = getGlossaryEntries(glossaryByArticle[article.slug] ?? []);

const relatedContent = article.slug === 'poivre-de-kampot'
  ? [
      ingredientGuides.find((item) => item.slug === 'poivre-de-kampot'),
      recipes.find((item) => item.slug === 'lok-lak')
    ].filter(Boolean)
  : article.slug === 'comprendre-le-kroeung'
    ? [
        ingredientGuides.find((item) => item.slug === 'kroeung'),
        recipes.find((item) => item.slug === 'kroeung-jaune'),
        recipes.find((item) => item.slug === 'amok-trey')
      ].filter(Boolean)
    : [
        recipes.find((item) => item.slug === 'amok-trey'),
        ingredientGuides.find((item) => item.slug === 'kroeung')
      ].filter(Boolean);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.seoDescription,
  image: new URL(article.image, Astro.site ?? new URL('https://www.cuisine-du-cambodge.com')).href,
  inLanguage: 'fr-FR',
  author: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  publisher: { '@type': 'Organization', name: 'Cuisine du Cambodge' },
  mainEntityOfPage: `https://www.cuisine-du-cambodge.com/culture/${article.slug}/`
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: 'https://www.cuisine-du-cambodge.com/' },
    { '@type': 'ListItem', position: 2, name: 'Culture', item: 'https://www.cuisine-du-cambodge.com/culture/' },
    { '@type': 'ListItem', position: 3, name: article.title, item: `https://www.cuisine-du-cambodge.com/culture/${article.slug}/` }
  ]
};
---
<BaseLayout title={`${article.title} | Culture culinaire cambodgienne`} description={article.seoDescription} image={article.image} imageAlt={article.imageAlt}>
  <SiteHeader />
  <main class="culture-article editorial-detail culture-detail">
    <section class="detail-hero-shell detail-hero-shell--culture">
      <header class="culture-article-hero" data-reveal="up">
        <p class="eyebrow"><CulinaryIcon name="story" size={17} /> {article.eyebrow} · {article.readingTime}</p>
        <h1>{article.title}</h1>
        <p>{article.intro}</p>
      </header>

      <figure class="culture-visual" data-parallax="0.06">
        <img src={article.image} srcset={imageSrcSet(article.image, article.imageWidths)} sizes="(max-width: 900px) 100vw, 52vw" alt={article.imageAlt} width={article.imageWidth} height={article.imageHeight} decoding="async" />
        <figcaption>Photographie illustrative · crédits et licence en bas de page.</figcaption>
      </figure>
    </section>

    <article class="culture-copy">
      {article.sections.map((section: CultureArticle['sections'][number], index: number) => (
        <section data-reveal={index % 2 === 0 ? 'up' : 'right'}>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph: string) => <p>{paragraph}</p>)}
        </section>
      ))}

      <aside class="source-box">
        <p class="eyebrow">Sources</p>
        <ul>
          {article.sources.map((source: CultureArticle['sources'][number]) => (
            <li><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a></li>
          ))}
        </ul>
      </aside>
    </article>

    <GlossaryStrip entries={glossary} />

    {relatedContent.length > 0 && (
      <section class="culture-related" data-reveal="up">
        <p class="eyebrow">Pour continuer</p>
        <h2>Passer de l’histoire à la cuisine</h2>
        <div class="culture-related-links">
          {relatedContent.map((item: any) => {
            const isRecipe = 'prepTime' in item;
            const href = isRecipe ? `/recettes/${item.slug}/` : `/ingredients/${item.slug}/`;
            return (
              <a href={href}>
                <span>{isRecipe ? 'Recette' : 'Ingrédient'}</span>
                <strong>{item.title}</strong>
                <em>{item.intro}</em>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <a class="text-link" href="/culture/">← Tous les articles</a>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <SiteFooter />
</BaseLayout>
