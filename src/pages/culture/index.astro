---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import EditorialSectionHero from '../../components/EditorialSectionHero.astro';
import { cultureArticles } from '../../data/culture';
import { imageSrcSet } from '../../utils/images';
import '../../styles/v16-editorial.css';
import '../../styles/v19-premium-pages.css';
import '../../styles/editorial-shared-hero.css';

// Vitrine et fiches restent liées à la même illustration de carnet.
 // Une carte ne peut plus pointer par erreur sur une photo de restaurant recyclée.
const momentDefinitions = [
  { slug:'construire-repas-cambodgien', moment:'Autour du riz', title:'Le repas, un moment de vie', text:'La place du riz et des plats partagés raconte des habitudes de table qui varient selon les familles.' , href:'/culture/construire-repas-cambodgien/', cta:'Lire le carnet →' },
  { slug:'kep-marche-crabe-poivre', moment:'Sur les marchés', title:'La vie des marchés du littoral', text:'À Kep, la mer, le commerce et les pêcheurs font partie d’une même histoire locale.' , href:'/culture/kep-marche-crabe-poivre/', cta:'Lire le carnet →' },
  { slug:'comprendre-le-kroeung', moment:'Dans les mémoires', title:'Le kroeung, une mémoire de famille', text:'Les goûts du pays accompagnent parfois les récits d’exil et les nouvelles générations.' , href:'/culture/comprendre-le-kroeung/', cta:'Lire le carnet →' },
  { slug:'poivre-de-kampot', moment:'Dans les terroirs', title:'Un nom, un lieu, des producteurs', text:'Le poivre de Kampot relie un territoire, des savoir-faire et une origine protégée.' , href:'/culture/poivre-de-kampot/', cta:'Lire le carnet →' }
];
const moments = momentDefinitions.map((definition) => {
  const article = cultureArticles.find((entry) => entry.slug === definition.slug);
  if (definition.href !== `/culture/${definition.slug}/`) {
    throw new Error(`Carnets : lien et slug incohérents pour ${definition.slug}`);
  }
  if (!article || !article.image?.startsWith('/images/')) {
    throw new Error(`Carnets : image locale absente pour ${definition.slug}`);
  }
  return {
    ...definition,
    image: article.image,
    imageAlt: article.imageAlt,
    imageWidth: article.imageWidth,
    imageHeight: article.imageHeight,
    imageWidths: article.imageWidths,
    href: definition.href
  };
});
if (new Set(moments.map((moment) => moment.image)).size !== moments.length) {
  throw new Error('Carnets : images de vignettes dupliquées');
}

// Select the featured journal by its stable slug, not its position in the catalogue.
const featuredSlug = 'kep-marche-crabe-poivre';
const featuredArticle = cultureArticles.find((article) => article.slug === featuredSlug);

// Trois univers effectivement représentés par les sept Carnets.
// Le quatrième univers envisagé reste absent tant qu'il ne contient aucun récit.
const carnetUniverses = [
  { key: 'Vie quotidienne', label: 'Vie quotidienne' },
  { key: 'Terroirs et marchés', label: 'Terroirs et marchés' },
  { key: 'Mémoire culinaire', label: 'Mémoire et transmission' }
].map((universe) => ({
  ...universe,
  count: cultureArticles.filter((article) => article.eyebrow === universe.key).length
}));
if (carnetUniverses.some((universe) => universe.count === 0) ||
    carnetUniverses.reduce((sum, universe) => sum + universe.count, 0) !== cultureArticles.length) {
  throw new Error('Taxonomie Carnets : univers vide ou article sans univers reconnu.');
}

const heritagePath = [
  {
    step: '01 · Vie quotidienne',
    title: 'Le riz, de la terre à la table',
    text: 'Le riz raconte des paysages, des saisons et des habitudes partagées.',
    href: '/culture/le-riz-symbole-de-vie-au-cambodge/',
    action: 'Lire le carnet'
  },
  {
    step: '02 · Mémoire',
    title: 'Le kroeung et les histoires de l’exil',
    text: 'Les traditions culinaires peuvent garder une place particulière dans les souvenirs des familles.',
    href: '/culture/comprendre-le-kroeung/',
    action: 'Découvrir le récit'
  },
  {
    step: '03 · Littoral',
    title: 'Le marché aux crabes de Kep',
    text: 'Pêche, vente et préservation des ressources racontent un territoire vivant.',
    href: '/culture/kep-marche-crabe-poivre/',
    action: 'Explorer le marché'
  }
];

const collectionSchema = {
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Carnets culinaires du Cambodge',
  description:'Histoire, marchés, mémoire, territoires et traditions culinaires : des récits sur la vie et le patrimoine du Cambodge.',
  url:'https://www.cuisine-du-cambodge.com/culture/',
  inLanguage:'fr-FR',
  mainEntity:{
    '@type':'ItemList',
    itemListElement:cultureArticles.map((article,index)=>({
      '@type':'ListItem',position:index+1,name:article.title,url:`https://www.cuisine-du-cambodge.com/culture/${article.slug}/`
    }))
  }
};
---
<BaseLayout
  title="Carnets du Cambodge : histoire, marchés et mémoire culinaire"
  description="Explorez les récits culinaires du Cambodge : territoires, mémoire, habitudes de table, histoire et traditions."
>
  <SiteHeader />
  <main class="v16-editorial v16-journals">
    <EditorialSectionHero
      kicker="Carnets du Cambodge"
      title="Des marchés animés aux repas partagés."
      description="Ces carnets racontent les lieux, l’histoire, les traditions et les mémoires autour de la cuisine cambodgienne. Les gestes et les préparations sont détaillés dans nos Ateliers et Recettes."
      image="/images/cuisine/v17-market-live-1800.jpg"
      imageWidth={1800}
      imageHeight={1200}
    />

    <section class="v16-day-notes" aria-labelledby="v16-day-title">
      <header>
        <p class="v16-page-kicker">Culture et patrimoine</p>
        <h2 id="v16-day-title">Quatre regards sur les lieux et la mémoire.</h2>
      </header>
      <div>
        {moments.map((moment) => (
          <a href={moment.href} class="v16-day-note">
            <img class="v19-note-image" src={moment.image} srcset={moment.imageWidths.length ? imageSrcSet(moment.image, moment.imageWidths) : undefined} sizes="(max-width:760px) 90vw, 320px" alt={moment.imageAlt} loading="lazy" decoding="async" width={moment.imageWidth} height={moment.imageHeight} />
            <span>{moment.moment}</span>
            <h3>{moment.title}</h3>
            <p>{moment.text}</p>
            <strong>{moment.cta}</strong>
          </a>
        ))}
      </div>
    </section>

    {featuredArticle && <section class="v16-journal-lead" aria-label="Carnet à la une" data-carnets-universe={featuredArticle.eyebrow}>
      <a href={'/culture/' + featuredArticle.slug + '/'} class="v16-journal-lead-card">
        <figure>
          <img src={featuredArticle.image} srcset={featuredArticle.imageWidths.length ? imageSrcSet(featuredArticle.image,featuredArticle.imageWidths) : undefined} sizes="(max-width:900px) 100vw, 58vw" alt={featuredArticle.imageAlt} width={featuredArticle.imageWidth} height={featuredArticle.imageHeight} loading="eager" decoding="async" />
        </figure>
        <div>
          <p class="v16-mini-label">À la une · {featuredArticle.readingTime}</p>
          <h2>{featuredArticle.title}</h2>
          <p>{featuredArticle.intro}</p>
          <strong>Lire le carnet →</strong>
        </div>
      </a>
    </section>}

    <section class="carnets-explorer" aria-labelledby="carnets-explorer-title">
      <p class="v16-page-kicker">Explorer par univers</p>
      <h2 id="carnets-explorer-title">Choisir une histoire du Cambodge</h2>
      <nav class="carnets-filters" data-carnets-filters hidden aria-label="Filtrer les Carnets par univers">
        <button type="button" data-carnets-filter="all" aria-pressed="true">Tous les Carnets · {cultureArticles.length}</button>
        {carnetUniverses.map((universe) => (
          <button type="button" data-carnets-filter={universe.key} aria-pressed="false">{universe.label} · {universe.count}</button>
        ))}
      </nav>
      <p class="carnets-filter-status" data-carnets-filter-status aria-live="polite">{cultureArticles.length} Carnets à découvrir.</p>
    </section>

    <section class="v16-journal-grid" aria-label="Tous les carnets">
      {cultureArticles.filter((article) => article.slug !== featuredSlug).map((article,index) => (
        <a href={'/culture/' + article.slug + '/'} class:list={['v16-journal-card', index === 0 && 'v16-journal-card--wide']} data-reveal="up" data-carnets-universe={article.eyebrow}>
          <figure>
            <img src={article.image} srcset={article.imageWidths.length ? imageSrcSet(article.image,article.imageWidths) : undefined} sizes="(max-width:760px) 100vw, 45vw" alt={article.imageAlt} width={article.imageWidth} height={article.imageHeight} loading="lazy" decoding="async" />
          </figure>
          <div>
            <p class="v16-mini-label">{article.eyebrow} · {article.readingTime}</p>
            <h2>{article.title}</h2>
            <p>{article.intro}</p>
            <strong>Lire →</strong>
          </div>
        </a>
      ))}
    </section>

    <section class="v16-journal-path" aria-labelledby="v16-journal-path-title">
      <header>
        <p class="v16-page-kicker">Parcourir les histoires</p>
        <h2 id="v16-journal-path-title">Trois histoires pour découvrir la vie autour des repas.</h2>
        <p>Des paysages agricoles aux mémoires familiales et aux marchés du littoral, la cuisine raconte une histoire plus vaste que ses recettes.</p>
      </header>
      <nav aria-label="Parcours à travers les Carnets du Cambodge" class="v16-journal-path-grid">
        {heritagePath.map((item) => (
          <a href={item.href}>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <strong>{item.action} →</strong>
          </a>
        ))}
      </nav>
    </section>

    <section class="v16-journal-manifesto">
      <p class="v16-page-kicker">Ce qu’on aime raconter</p>
      <h2>Une cuisine, ce sont aussi des lieux, une histoire et des souvenirs.</h2>
      <div>
        <p>Les marchés et les produits de saison.</p>
        <p>Les savoirs et les récits qui passent d’une génération à l’autre.</p>
        <p>Les repas que l’on partage autour du riz et de plusieurs plats.</p>
        <p>Les recettes qui changent d’une famille à l’autre et continuent de se transmettre.</p>
      </div>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <SiteFooter />
</BaseLayout>

<script>
  const filters = document.querySelector<HTMLElement>('[data-carnets-filters]');
  if (filters) {
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-carnets-universe]'));
    const buttons = Array.from(filters.querySelectorAll<HTMLButtonElement>('[data-carnets-filter]'));
    const status = document.querySelector<HTMLElement>('[data-carnets-filter-status]');

    const selectUniverse = (key: string) => {
      for (const item of items) item.hidden = key !== 'all' && item.dataset.carnetsUniverse !== key;
      for (const button of buttons) button.setAttribute('aria-pressed', String(button.dataset.carnetsFilter === key));
      const count = items.filter((item) => !item.hidden).length;
      const current = buttons.find((button) => button.dataset.carnetsFilter === key);
      if (status) status.textContent = key === 'all'
        ? `${count} Carnets à découvrir.`
        : `${count} Carnets dans « ${current?.textContent?.split(' · ')[0] ?? ''} ».`;
    };

    buttons.forEach((button) => button.addEventListener('click', () => selectUniverse(button.dataset.carnetsFilter || 'all')));
    filters.hidden = false; // Sans JavaScript, la liste complète reste visible.
  }
</script>

<style>
  .carnets-explorer{width:min(calc(100% - 36px),1220px);margin:clamp(34px,5vw,66px) auto 24px}
  .carnets-explorer h2{font-family:Georgia,serif;font-size:clamp(1.55rem,3.2vw,2.6rem);margin:.5rem 0 1rem}
  .carnets-filters{display:flex;flex-wrap:wrap;gap:.65rem;margin:1.25rem 0}
  .carnets-filters[hidden],[data-carnets-universe][hidden]{display:none!important}
  .carnets-filters button{appearance:none;font:inherit;font-size:.93rem;font-weight:650;border:1px solid #b5a183;background:#fffaf1;color:#473622;border-radius:999px;min-height:44px;padding:.6rem 1rem;cursor:pointer}
  .carnets-filters button[aria-pressed="true"]{background:#473622;color:#fff;border-color:#473622}
  .carnets-filters button:focus-visible{outline:3px solid #9a6c2d;outline-offset:3px}
  .carnets-filter-status{font-size:.92rem;color:#63584b}
</style>
