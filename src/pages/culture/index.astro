---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { cultureArticles } from '../../data/culture';
import { imageSrcSet } from '../../utils/images';
import '../../styles/v16-editorial.css';
import '../../styles/v19-premium-pages.css';

const moments = [
  { image:'/images/cuisine/v18-kuy-teav.webp', moment:'Au réveil', title:'Un bol de kuy teav pour commencer la journée', text:'Nouilles, bouillon parfumé et herbes fraîches : découvrez comment préparer ce bol chez vous.', href:'/recettes/kuy-teav/', cta:'Voir la recette →' },
  { image:'/images/cuisine/kep-market-1600.webp', moment:'Au marché', title:'Le marché inspire le repas', text:'Poissons, herbes, légumes, fruits : on cuisine d’abord avec ce qui est frais et disponible.', href:'/culture/kep-marche-crabe-poivre/', cta:'Lire le carnet →' },
  { image:'/images/cuisine/v17-mortar-hands-1600.jpg', moment:'Au mortier', title:'Au mortier, les aromates prennent forme', text:'Le kroeung se prépare patiemment : on coupe, on pile, on sent, jusqu’à obtenir une pâte bien parfumée.', href:'/culture/comprendre-le-kroeung/', cta:'Lire le carnet →' },
  { image:'/images/cuisine/v17-table-meal-1600.jpg', moment:'À table', title:'À table, chacun compose sa bouchée', text:'Riz, plat chaud, légumes, herbes, soupe ou condiment se mangent ensemble et se complètent.', href:'/culture/construire-repas-cambodgien/', cta:'Lire le carnet →' }
];

// Select the featured journal by its stable slug, not its position in the catalogue.
const featuredSlug = 'kep-marche-crabe-poivre';
const featuredArticle = cultureArticles.find((article) => article.slug === featuredSlug);

const culinaryPath = [
  {
    step: '01 · Lire',
    title: 'Comprendre le kroeung',
    text: 'Citronnelle, galanga, curcuma : découvrez ce que chaque aromate apporte à la pâte.',
    href: '/culture/comprendre-le-kroeung/',
    action: 'Découvrir le carnet'
  },
  {
    step: '02 · Essayer',
    title: 'Prendre le pilon en main',
    text: 'Au mortier, observez la texture et le parfum qui changent au fil du geste.',
    href: '/apprendre/piler-aromates-au-mortier/',
    action: 'Suivre l’atelier'
  },
  {
    step: '03 · Cuisiner',
    title: 'Passer à l’amok de poisson',
    text: 'Retrouvez ces parfums dans une recette guidée, avec les quantités et les repères de cuisson.',
    href: '/recettes/amok-trey/',
    action: 'Préparer l’amok'
  }
];

const collectionSchema = {
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Carnets culinaires du Cambodge',
  description:'Marchés, gestes, produits, fermentation et table : des carnets pour comprendre la cuisine cambodgienne par ce qui se mange, se prépare et se partage.',
  url:'https://www.cuisine-du-cambodge.com/culture/',
  inLanguage:'fr-FR',
  mainEntity:{
    '@type':'ItemList',
    itemListElement:cultureArticles.map((article,index)=>({
      '@type':'ListItem',position:index+1,name:article.title,url:`https://www.cuisine-du-cambodge.com/culture/${article.slug}/`
    }))
  }
};
---
<BaseLayout
  title="Carnets du Cambodge : marchés, gestes et culture culinaire"
  description="Des marchés du matin aux tables familiales : découvrir la cuisine cambodgienne par ses produits, ses gestes, ses fermentations et ses habitudes."
>
  <SiteHeader />
  <main class="v16-editorial v16-journals">
    <header class="v16-page-hero v16-page-hero--journals">
      <p class="v16-page-kicker">Carnets du Cambodge</p>
      <h1>Des marchés animés aux repas partagés.</h1>
      <p>Ces carnets racontent les marchés, les produits, les gestes et les habitudes qui donnent toute sa saveur à la cuisine cambodgienne.</p>
      <figure class="v19-hero-photo" aria-hidden="true"><img src="/images/cuisine/v17-market-live-1800.jpg" alt="" width="1800" height="1200" decoding="async" fetchpriority="high" /></figure>
      <div class="v16-journal-stamp" aria-hidden="true">marchés · gestes · produits · table · transmission</div>
    </header>

    <section class="v16-day-notes" aria-labelledby="v16-day-title">
      <header>
        <p class="v16-page-kicker">Du marché à la table</p>
        <h2 id="v16-day-title">Quatre moments pour découvrir les parfums et les gestes.</h2>
      </header>
      <div>
        {moments.map((moment) => (
          <a href={moment.href} class="v16-day-note">
            <img class="v19-note-image" src={moment.image} alt="" loading="lazy" decoding="async" width="320" height="240" />
            <span>{moment.moment}</span>
            <h3>{moment.title}</h3>
            <p>{moment.text}</p>
            <strong>{moment.cta}</strong>
          </a>
        ))}
      </div>
    </section>

    {featuredArticle && <section class="v16-journal-lead" aria-label="Carnet à la une">
      <a href={'/culture/' + featuredArticle.slug + '/'} class="v16-journal-lead-card">
        <figure>
          <img src={featuredArticle.image} srcset={imageSrcSet(featuredArticle.image,featuredArticle.imageWidths)} sizes="(max-width:900px) 100vw, 58vw" alt={featuredArticle.imageAlt} width={featuredArticle.imageWidth} height={featuredArticle.imageHeight} loading="eager" decoding="async" />
        </figure>
        <div>
          <p class="v16-mini-label">À la une · {featuredArticle.readingTime}</p>
          <h2>{featuredArticle.title}</h2>
          <p>{featuredArticle.intro}</p>
          <strong>Lire le carnet →</strong>
        </div>
      </a>
    </section>}

    <section class="v16-journal-grid" aria-label="Tous les carnets">
      {cultureArticles.filter((article) => article.slug !== featuredSlug).map((article,index) => (
        <a href={'/culture/' + article.slug + '/'} class:list={['v16-journal-card', index === 0 && 'v16-journal-card--wide']} data-reveal="up">
          <figure>
            <img src={article.image} srcset={imageSrcSet(article.image,article.imageWidths)} sizes="(max-width:760px) 100vw, 45vw" alt={article.imageAlt} width={article.imageWidth} height={article.imageHeight} loading="lazy" decoding="async" />
          </figure>
          <div>
            <p class="v16-mini-label">{article.eyebrow} · {article.readingTime}</p>
            <h2>{article.title}</h2>
            <p>{article.intro}</p>
            <strong>Lire →</strong>
          </div>
        </a>
      ))}
    </section>

    <section class="v16-journal-path" aria-labelledby="v16-journal-path-title">
      <header>
        <p class="v16-page-kicker">Du carnet à votre cuisine</p>
        <h2 id="v16-journal-path-title">Découvrez le kroeung, pilez les aromates, puis cuisinez l’amok.</h2>
        <p>Un mot découvert dans un carnet devient plus facile à retenir quand on sent les aromates et qu’on les utilise dans un plat.</p>
      </header>
      <nav aria-label="Parcours pour découvrir le kroeung" class="v16-journal-path-grid">
        {culinaryPath.map((item) => (
          <a href={item.href}>
            <span>{item.step}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <strong>{item.action} →</strong>
          </a>
        ))}
      </nav>
    </section>

    <section class="v16-journal-manifesto">
      <p class="v16-page-kicker">Ce qu’on aime raconter</p>
      <h2>Une cuisine, ce sont aussi des lieux, des gestes et des souvenirs.</h2>
      <div>
        <p>Les marchés et les produits de saison.</p>
        <p>Les gestes que l’on apprend en regardant faire.</p>
        <p>Les repas que l’on partage autour du riz et de plusieurs plats.</p>
        <p>Les recettes qui changent d’une famille à l’autre et continuent de se transmettre.</p>
      </div>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <SiteFooter />
</BaseLayout>
