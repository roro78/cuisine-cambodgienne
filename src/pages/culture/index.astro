---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { cultureArticles } from '../../data/culture';
import { imageSrcSet } from '../../utils/images';
import '../../styles/v16-editorial.css';

const moments = [
  { time:'05:30', title:'Un bol de kuy teav pour commencer la journée', text:'Nouilles, bouillon parfumé et herbes fraîches : découvrez comment préparer ce bol chez vous.', href:'/recettes/kuy-teav/', cta:'Voir la recette →' },
  { time:'08:30', title:'Le marché inspire le repas', text:'Poissons, herbes, légumes, fruits : on cuisine d’abord avec ce qui est frais et disponible.', href:'/culture/kep-marche-crabe-poivre/', cta:'Lire le carnet →' },
  { time:'11:00', title:'Au mortier, les aromates prennent forme', text:'Le kroeung se prépare patiemment : on coupe, on pile, on sent, jusqu’à obtenir une pâte bien parfumée.', href:'/culture/comprendre-le-kroeung/', cta:'Lire le carnet →' },
  { time:'12:30', title:'À table, chacun compose sa bouchée', text:'Riz, plat chaud, légumes, herbes, soupe ou condiment se mangent ensemble et se complètent.', href:'/culture/construire-repas-cambodgien/', cta:'Lire le carnet →' }
];

const collectionSchema = {
  '@context':'https://schema.org',
  '@type':'CollectionPage',
  name:'Carnets culinaires du Cambodge',
  description:'Marchés, gestes, produits, fermentation et table : des carnets pour comprendre la cuisine cambodgienne par ce qui se mange, se prépare et se partage.',
  url:'https://www.cuisine-du-cambodge.com/culture/',
  inLanguage:'fr-FR',
  mainEntity:{
    '@type':'ItemList',
    itemListElement:cultureArticles.map((article,index)=>({
      '@type':'ListItem',position:index+1,name:article.title,url:`https://www.cuisine-du-cambodge.com/culture/${article.slug}/`
    }))
  }
};
---
<BaseLayout
  title="Carnets du Cambodge : marchés, gestes et culture culinaire"
  description="Des marchés du matin aux tables familiales : découvrir la cuisine cambodgienne par ses produits, ses gestes, ses fermentations et ses habitudes."
>
  <SiteHeader />
  <main class="v16-editorial v16-journals">
    <header class="v16-page-hero v16-page-hero--journals">
      <p class="v16-page-kicker">Carnets du Cambodge</p>
      <h1>Des marchés animés aux repas partagés.</h1>
      <p>Ces carnets racontent les marchés, les produits, les gestes et les habitudes qui donnent toute sa saveur à la cuisine cambodgienne.</p>
      <div class="v16-journal-stamp" aria-hidden="true">marchés · gestes · produits · table · transmission</div>
    </header>

    <section class="v16-day-notes" aria-labelledby="v16-day-title">
      <header>
        <p class="v16-page-kicker">Une journée au rythme des saveurs</p>
        <h2 id="v16-day-title">La cuisine se découvre aussi dans les habitudes de tous les jours.</h2>
      </header>
      <div>
        {moments.map((moment) => (
          <a href={moment.href} class="v16-day-note">
            <span>{moment.time}</span>
            <h3>{moment.title}</h3>
            <p>{moment.text}</p>
            <strong>{moment.cta}</strong>
          </a>
        ))}
      </div>
    </section>

    <section class="v16-journal-lead" aria-label="Carnet à la une">
      <a href={'/culture/' + cultureArticles[3].slug + '/'} class="v16-journal-lead-card">
        <figure>
          <img src={cultureArticles[3].image} srcset={imageSrcSet(cultureArticles[3].image,cultureArticles[3].imageWidths)} sizes="(max-width:900px) 100vw, 58vw" alt={cultureArticles[3].imageAlt} width={cultureArticles[3].imageWidth} height={cultureArticles[3].imageHeight} loading="eager" decoding="async" />
        </figure>
        <div>
          <p class="v16-mini-label">À la une · {cultureArticles[3].readingTime}</p>
          <h2>{cultureArticles[3].title}</h2>
          <p>{cultureArticles[3].intro}</p>
          <strong>Lire le carnet →</strong>
        </div>
      </a>
    </section>

    <section class="v16-journal-grid" aria-label="Tous les carnets">
      {cultureArticles.filter((_,index)=>index !== 3).map((article,index) => (
        <a href={'/culture/' + article.slug + '/'} class:list={['v16-journal-card', index === 0 && 'v16-journal-card--wide']} data-reveal="up">
          <figure>
            <img src={article.image} srcset={imageSrcSet(article.image,article.imageWidths)} sizes="(max-width:760px) 100vw, 45vw" alt={article.imageAlt} width={article.imageWidth} height={article.imageHeight} loading="lazy" decoding="async" />
          </figure>
          <div>
            <p class="v16-mini-label">{article.eyebrow} · {article.readingTime}</p>
            <h2>{article.title}</h2>
            <p>{article.intro}</p>
            <strong>Lire →</strong>
          </div>
        </a>
      ))}
    </section>

    <section class="v16-journal-manifesto">
      <p class="v16-page-kicker">Ce qu’on aime raconter</p>
      <h2>Une cuisine, ce sont aussi des lieux, des gestes et des souvenirs.</h2>
      <div>
        <p>Les marchés et les produits de saison.</p>
        <p>Les gestes que l’on apprend en regardant faire.</p>
        <p>Les repas que l’on partage autour du riz et de plusieurs plats.</p>
        <p>Les recettes qui changent d’une famille à l’autre et continuent de se transmettre.</p>
      </div>
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <SiteFooter />
</BaseLayout>
