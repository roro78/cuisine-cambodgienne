---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { cultureArticles } from '../../data/culture';
import { imageSrcSet } from '../../utils/images';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Culture culinaire khmère',
  description: 'Territoires, gestes, ingrédients et transmission autour de la cuisine cambodgienne.',
  url: 'https://www.cuisine-du-cambodge.com/culture/',
  inLanguage: 'fr-FR',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: cultureArticles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: `https://www.cuisine-du-cambodge.com/culture/${article.slug}/`
    }))
  }
};
---
<BaseLayout title="Culture culinaire khmère | Cuisine du Cambodge" description="Histoires, territoires, gestes et transmission autour de la cuisine cambodgienne.">
  <SiteHeader />
  <main class="listing-page editorial-listing culture-listing">
    <header class="page-intro page-intro-split" data-reveal="up">
      <p class="eyebrow">Comprendre</p>
      <h1>Culture culinaire</h1>
      <p>Pourquoi le poivre de Kampot a ce goût, comment le kroeung parfume une cuisine entière, ce que l’on mange et partage autour de la table : la culture culinaire racontée par ce qui se cuisine vraiment.</p>
      <div class="page-intro-visual" data-parallax="0.10"><img src={cultureArticles[0].image} srcset={imageSrcSet(cultureArticles[0].image, cultureArticles[0].imageWidths)} sizes="(max-width: 900px) 100vw, 58vw" alt={cultureArticles[0].imageAlt} width={cultureArticles[0].imageWidth} height={cultureArticles[0].imageHeight} fetchpriority="high" decoding="async" /></div>
    </header>

    <section class="culture-grid" data-reveal="up">
      {cultureArticles.map((article) => (
        <a class="culture-card" href={`/culture/${article.slug}/`}>
          <div class="culture-card-image"><img src={article.image} srcset={imageSrcSet(article.image, article.imageWidths)} sizes="(max-width: 720px) 100vw, 33vw" alt={article.imageAlt} width={article.imageWidth} height={article.imageHeight} loading="lazy" decoding="async" /></div>
          <span class="card-meta">{article.eyebrow}</span>
          <h2>{article.title}</h2>
          <p>{article.intro}</p>
          <span class="text-link">Lire</span>
        </a>
      ))}
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
  <SiteFooter />
</BaseLayout>
