---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { glossaryEntries } from '../../data/glossary';
import '../../styles/v16-editorial.css';

const families = ['Tous','Base aromatique','Herbe & racine','Condiment','Cuisson & plat','Produit'];

const glossarySchema = {
  '@context':'https://schema.org',
  '@type':'DefinedTermSet',
  name:'Glossaire de la cuisine cambodgienne',
  description:'Glossaire des ingrédients, techniques, plats et gestes de la cuisine khmère.',
  url:'https://www.cuisine-du-cambodge.com/glossaire/',
  inLanguage:'fr-FR',
  hasDefinedTerm:glossaryEntries.map((entry)=>({
    '@type':'DefinedTerm',
    name:entry.term,
    description:entry.short,
    inDefinedTermSet:'https://www.cuisine-du-cambodge.com/glossaire/'
  }))
};
---
<BaseLayout
  title="Glossaire de la cuisine cambodgienne : ingrédients, gestes et plats"
  description="Kroeung, prahok, combava, galanga, tamarin : des explications simples pour reconnaître, choisir et utiliser les mots et ingrédients de la cuisine cambodgienne."
>
  <SiteHeader />
  <main class="v16-editorial v16-glossary-page">
    <header class="v16-page-hero v16-page-hero--glossary">
      <p class="v16-page-kicker">Le glossaire</p>
      <h1>Un mot vous échappe ? On vous l’explique simplement.</h1>
      <p>Ingrédients, condiments, plats et gestes : découvrez ce que chaque mot signifie, quel goût attendre et comment l’utiliser en cuisine.</p>

      <label class="v16-glossary-search">
        <span>Rechercher dans le glossaire</span>
        <input type="search" placeholder="Ex. combava, prahok, galanga…" autocomplete="off" data-glossary-search />
      </label>
    </header>

    <section class="v16-glossary-tools" aria-label="Filtrer le glossaire">
      <div role="group" aria-label="Famille">
        {families.map((family,index)=>(
          <button type="button" class:list={[index === 0 && 'is-active']} aria-pressed={index === 0 ? 'true' : 'false'} data-glossary-family={family === 'Tous' ? 'all' : family}>{family}</button>
        ))}
      </div>
      <p aria-live="polite" data-glossary-status>{glossaryEntries.length} termes</p>
    </section>

    <section class="v16-glossary-directory" aria-label="Glossaire de la cuisine cambodgienne">
      {glossaryEntries.map((entry,index)=>(
        <article
          class="v16-glossary-card"
          id={entry.slug}
          data-glossary-card
          data-family={entry.family ?? 'Autre'}
          data-search={(entry.term + ' ' + entry.short + ' ' + (entry.culinaryUse ?? '')).toLocaleLowerCase('fr')}
          data-reveal="up"
        >
          <div class="v16-glossary-letter">{String(index+1).padStart(2,'0')}</div>
          <div class="v16-glossary-card-main">
            <p class="v16-mini-label">{entry.family ?? 'Cuisine khmère'}</p>
            <h2>{entry.term}</h2>
            <p class="v16-glossary-definition">{entry.short}</p>
            <dl>
              {entry.culinaryUse && <div><dt>En cuisine</dt><dd>{entry.culinaryUse}</dd></div>}
              {entry.cue && <div><dt>Repère</dt><dd>{entry.cue}</dd></div>}
            </dl>
            {entry.href && <a href={entry.href}>En savoir plus →</a>}
          </div>
        </article>
      ))}
    </section>
  </main>

  <script>
    const search = document.querySelector<HTMLInputElement>('[data-glossary-search]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-glossary-card]'));
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-glossary-family]'));
    const status = document.querySelector<HTMLElement>('[data-glossary-status]');
    let family = 'all';

    const normalize = (value: string) => value.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();

    const render = () => {
      const query = normalize(search?.value ?? '');
      let visible = 0;
      cards.forEach((card) => {
        const cardFamily = card.dataset.family ?? '';
        const haystack = normalize(card.dataset.search ?? '');
        const matchesFamily = family === 'all' || cardFamily === family;
        const matchesQuery = !query || haystack.includes(query);
        const show = matchesFamily && matchesQuery;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (status) status.textContent = visible + ' terme' + (visible > 1 ? 's' : '');
    };

    search?.addEventListener('input', render);
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        family = button.dataset.glossaryFamily ?? 'all';
        buttons.forEach((candidate) => {
          const active = candidate === button;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        render();
      });
    });
  </script>

  <script type="application/ld+json" set:html={JSON.stringify(glossarySchema)} />
  <SiteFooter />
</BaseLayout>
