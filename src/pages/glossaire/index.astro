---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { glossaryEntries } from '../../data/glossary';

const glossarySchema = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: 'Glossaire de la cuisine cambodgienne',
  description: 'Glossaire des ingrédients, techniques et plats de la cuisine khmère.',
  url: 'https://www.cuisine-du-cambodge.com/glossaire/',
  inLanguage: 'fr-FR',
  hasDefinedTerm: glossaryEntries.map((entry) => ({
    '@type': 'DefinedTerm',
    name: entry.term,
    description: entry.short,
    inDefinedTermSet: 'https://www.cuisine-du-cambodge.com/glossaire/'
  }))
};
---
<BaseLayout
  title="Glossaire cuisine cambodgienne : kroeung, prahok, amok…"
  description="Kroeung, prahok, poivre de Kampot, combava, galanga, amok et riz : comprendre les mots essentiels de la cuisine cambodgienne et savoir comment les utiliser."
>
  <SiteHeader />
  <main class="listing-page editorial-listing glossary-page">
    <header class="glossary-hero" data-reveal="up">
      <p class="eyebrow">Parler cuisine khmère</p>
      <h1>Le glossaire qui donne envie de cuisiner.</h1>
      <p>Un mot inconnu ne devrait jamais bloquer une recette. Ici, chaque terme est expliqué avec son rôle, son usage et un repère sensoriel pour le reconnaître en cuisine.</p>
    </header>

    <section class="glossary-directory" aria-label="Glossaire de la cuisine cambodgienne">
      {glossaryEntries.map((entry, index) => (
        <article class="glossary-card" id={entry.slug} data-reveal="up" data-reveal-delay={Math.min(index * .03, .18)}>
          <span class="glossary-card-index">{String(index + 1).padStart(2, '0')}</span>
          <div>
            <h2>{entry.term}</h2>
            <p>{entry.short}</p>
            {entry.culinaryUse && <p><strong>En cuisine :</strong> {entry.culinaryUse}</p>}
            {entry.cue && <p class="glossary-cue"><strong>Repère :</strong> {entry.cue}</p>}
            {entry.href && <a class="text-link" href={entry.href}>Approfondir</a>}
          </div>
        </article>
      ))}
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(glossarySchema)} />
  <SiteFooter />
</BaseLayout>
