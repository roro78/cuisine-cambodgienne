---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ScrollCompanion from '../components/ScrollCompanion.astro';
import { imageSrcSet } from '../utils/images';
---
<BaseLayout title="À propos | Cuisine du Cambodge" description="Pourquoi Cuisine du Cambodge existe : transmettre recettes, ingrédients, gestes et culture culinaire khmère.">
  <SiteHeader />
  <main class="about-page editorial-detail about-detail">
    <header class="page-intro about-opening" data-reveal="up">
      <p class="eyebrow">Le projet</p>
      <h1>Raconter la cuisine cambodgienne autrement.</h1>
      <p>Un site pour cuisiner réellement, comprendre les parfums et garder une place pour les gestes, les territoires et celles et ceux qui transmettent cette cuisine.</p>
    </header>

    <section class="about-story">
      <ScrollCompanion target=".about-story" />

      <article class="about-chapter about-chapter--intro" data-reveal="up">
        <div class="about-chapter-index">01</div>
        <div class="about-chapter-copy">
          <p class="eyebrow">Pourquoi ce site existe</p>
          <h2>Parce qu’une recette ne raconte jamais toute l’histoire.</h2>
          <p>Une quantité et un temps de cuisson ne disent pas comment doit sentir un kroeung fraîchement pilé, à quel moment le coco devient trop lourd, ni pourquoi un tour de poivre de Kampot peut réveiller tout un plat.</p>
        </div>
        <figure class="about-chapter-media" data-parallax="0.08">
          <img src="/images/cuisine/kroeung-1600.webp" srcset={imageSrcSet('/images/cuisine/kroeung-1600.webp', [480, 800, 1200, 1600])} sizes="(max-width: 800px) 100vw, 46vw" alt="Kroeung cambodgien fraîchement préparé" width="5184" height="3456" loading="lazy" decoding="async" />
        </figure>
      </article>

      <article class="about-chapter about-chapter--reverse" data-reveal="up">
        <div class="about-chapter-index">02</div>
        <div class="about-chapter-copy">
          <p class="eyebrow">Ce que j’aime dans cette cuisine</p>
          <h2>Le parfum arrive avant l’assiette.</h2>
          <p>La citronnelle coupée, les feuilles froissées, les racines pilées au mortier, la vapeur, le poivre : la cuisine khmère se reconnaît aussi à ce qui se passe autour de la casserole.</p>
        </div>
        <figure class="about-chapter-media" data-parallax="0.11">
          <img src="/images/cuisine/kampot-1600.webp" srcset={imageSrcSet('/images/cuisine/kampot-1600.webp', [480, 800, 1200, 1600])} sizes="(max-width: 800px) 100vw, 46vw" alt="Poivre de Kampot au Cambodge" width="6000" height="4000" loading="lazy" decoding="async" />
        </figure>
      </article>

      <article class="about-chapter about-chapter--text" data-reveal="up">
        <div class="about-chapter-index">03</div>
        <div class="about-chapter-copy">
          <p class="eyebrow">Ce que je veux transmettre</p>
          <h2>Des repères assez précis pour oser cuisiner sans figer la cuisine.</h2>
          <p>Le but n’est pas de transformer chaque plat en règle absolue. Il est de donner les clés : savoir ce que l’on cherche en bouche, comprendre le rôle d’un ingrédient et reconnaître le bon geste.</p>
        </div>
      </article>

      <article class="about-chapter about-chapter--future" data-reveal="up">
        <div class="about-chapter-index">04</div>
        <div class="about-chapter-copy">
          <p class="eyebrow">Ce que le site va devenir</p>
          <h2>Une bibliothèque vivante de cuisine khmère.</h2>
          <p>Plus de recettes, davantage de gestes expliqués, des ingrédients documentés, des histoires et des parcours pour apprendre en cuisinant. Le site doit grandir comme un carnet que l’on ouvre avec les mains encore parfumées.</p>
          <a class="text-link" href="/recettes/">Commencer par cuisiner</a>
        </div>
      </article>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
