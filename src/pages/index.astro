---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const heroImage = 'https://commons.wikimedia.org/wiki/Special:FilePath/Fish_Amok-_Khmer_specialty.jpg?width=1800';
const marketImage = 'https://commons.wikimedia.org/wiki/Special:FilePath/06-Kep_Crab_Market_Cambodia-nX-3_(cropped).jpg?width=1800';
const pepperImage = 'https://commons.wikimedia.org/wiki/Special:FilePath/Kampot_Pepper.jpg?width=1800';
const amokImage = 'https://commons.wikimedia.org/wiki/Special:FilePath/Fish_amok_amok_trei_Khmer_Cambodian_food.jpg?width=1800';
---
<BaseLayout image={heroImage}>
  <SiteHeader overlay />

  <main>
    <section class="story-hero" aria-labelledby="hero-title">
      <div class="story-stage">
        <img
          class="story-hero-image"
          src={heroImage}
          alt="Amok cambodgien servi dans une feuille de bananier avec du riz"
          fetchpriority="high"
        />
        <div class="story-shade" aria-hidden="true"></div>
        <div class="story-progress" aria-hidden="true"><span></span></div>

        <div class="story-panel story-panel-1 is-active">
          <p class="eyebrow">Cuisine du Cambodge</p>
          <h1 id="hero-title">Un plat.<br />Puis tout un pays.</h1>
          <p>Faites défiler. On part de l’assiette pour remonter jusqu’aux gestes, aux aromates et aux territoires qui la construisent.</p>
        </div>

        <div class="story-panel story-panel-2">
          <p class="eyebrow">01 — Le geste</p>
          <h2>Avant le plat,<br />il y a le mortier.</h2>
          <p>Citronnelle, galanga, curcuma, combava : les parfums ne sont pas ajoutés à la fin. Ils sont construits, pilés et liés dès le départ.</p>
        </div>

        <div class="story-panel story-panel-3">
          <p class="eyebrow">02 — L’équilibre</p>
          <h2>Pas une épice.<br />Une architecture.</h2>
          <p>Le kroeung donne la profondeur. Le coco arrondit. Le poisson apporte la matière. La cuisson douce assemble le tout.</p>
        </div>

        <div class="story-panel story-panel-4">
          <p class="eyebrow">03 — La transmission</p>
          <h2>Cuisiner,<br />c’est comprendre.</h2>
          <p>Le site ne donne pas seulement des listes d’ingrédients : il explique les gestes, les équilibres et le contexte derrière chaque recette.</p>
          <a class="story-cta" href="/recettes/amok-trey/">Entrer par l’Amok Trey →</a>
        </div>

        <div class="scroll-cue" aria-hidden="true">
          <span>Défiler</span>
          <i></i>
        </div>
      </div>
    </section>

    <section class="market-story" id="culture">
      <div class="market-media">
        <img src={marketImage} alt="Épices et poivres présentés au marché de Kep au Cambodge" loading="lazy" />
      </div>
      <div class="market-copy">
        <p class="eyebrow">04 — Le marché</p>
        <h2>Les saveurs commencent avant la cuisine.</h2>
        <p>Sur les étals : poivres, herbes fraîches, racines, condiments fermentés. Une cuisine se lit aussi dans les produits qui circulent autour d’elle.</p>
        <a class="text-link" href="/culture/">Explorer la culture culinaire</a>
      </div>
    </section>

    <section class="ingredient-story" id="saveurs">
      <div class="ingredient-sticky">
        <div class="ingredient-photo">
          <img src={amokImage} alt="Petites portions d'amok trei cambodgien" loading="lazy" />
        </div>
        <div class="ingredient-copy">
          <p class="eyebrow">05 — Le kroeung</p>
          <h2>Quatre parfums.<br />Une base.</h2>
          <p class="ingredient-intro">Au scroll, chaque élément entre dans la composition.</p>
          <ol class="ingredient-steps">
            <li><span>01</span><strong>Citronnelle</strong><em>fraîche, citronnée, fibreuse</em></li>
            <li><span>02</span><strong>Galanga</strong><em>poivré, camphré, racinaire</em></li>
            <li><span>03</span><strong>Curcuma</strong><em>terreux, chaud, colorant</em></li>
            <li><span>04</span><strong>Combava</strong><em>vif, floral, zesté</em></li>
          </ol>
          <a class="text-link" href="/ingredients/kroeung/">Comprendre le kroeung</a>
        </div>
      </div>
    </section>

    <section class="feature-recipe">
      <div class="feature-recipe-copy">
        <p class="eyebrow">06 — Cuisiner</p>
        <h2>Amok Trey</h2>
        <p>Le meilleur point de départ pour comprendre comment la cuisine khmère assemble aromates, coco, poisson et cuisson douce.</p>
        <a class="text-link" href="/recettes/amok-trey/">Voir la recette complète</a>
      </div>
      <div class="feature-recipe-media">
        <img src={heroImage} alt="Amok cambodgien et riz servis sur feuille de bananier" loading="lazy" />
      </div>
    </section>

    <section class="kampot-story">
      <img src={pepperImage} alt="Grappes de poivre vert de Kampot sur le plant" loading="lazy" />
      <div class="kampot-overlay"></div>
      <div class="kampot-copy">
        <p class="eyebrow">07 — Le terroir</p>
        <h2>Kampot.</h2>
        <p>Le poivre raconte un territoire autant qu’un goût : maturité, fraîcheur, chaleur et longueur aromatique.</p>
        <a class="story-cta" href="/ingredients/poivre-de-kampot/">Découvrir le poivre de Kampot →</a>
      </div>
    </section>

    <section class="explore-grid">
      <div class="explore-heading">
        <p class="eyebrow">Continuer</p>
        <h2>Choisissez votre porte d’entrée.</h2>
      </div>
      <div class="explore-links">
        <a href="/recettes/"><span>Recettes</span><strong>Cuisiner</strong><em>Amok, lok lak, kroeung et classiques khmers.</em></a>
        <a href="/ingredients/"><span>Ingrédients</span><strong>Comprendre</strong><em>Kroeung, prahok, tamarin, poivres et aromates.</em></a>
        <a href="/culture/"><span>Culture</span><strong>Raconter</strong><em>Territoires, produits, gestes et transmission.</em></a>
      </div>
    </section>

    <section class="photo-credit-strip">
      <span>Photographies : Ben Yapp, MoonsMoon, PsamatheM, Thalias — Creative Commons.</span>
      <a href="/credits-photos/">Crédits & licences</a>
    </section>
  </main>

  <SiteFooter />

  <script>
    import { initStorytelling } from '../scripts/storytelling';
    initStorytelling();
  </script>
</BaseLayout>
