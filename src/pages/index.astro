---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/home-v16.css';

const images = {
  market: {
    src: '/images/cuisine/kep-market-2200.webp',
    srcset: '/images/cuisine/kep-market-800.webp 800w, /images/cuisine/kep-market-1200.webp 1200w, /images/cuisine/kep-market-1600.webp 1600w, /images/cuisine/kep-market-2200.webp 2200w'
  },
  kampot: {
    src: '/images/cuisine/kampot-2200.webp',
    srcset: '/images/cuisine/kampot-800.webp 800w, /images/cuisine/kampot-1200.webp 1200w, /images/cuisine/kampot-1600.webp 1600w, /images/cuisine/kampot-2200.webp 2200w'
  },
  tamarind: {
    src: '/images/cuisine/tamarind-1600.webp',
    srcset: '/images/cuisine/tamarind-800.webp 800w, /images/cuisine/tamarind-1200.webp 1200w, /images/cuisine/tamarind-1600.webp 1600w'
  },
  prahok: {
    src: '/images/cuisine/prahok-1600.webp',
    srcset: '/images/cuisine/prahok-800.webp 800w, /images/cuisine/prahok-1200.webp 1200w, /images/cuisine/prahok-1600.webp 1600w'
  },
  kroeung: {
    src: '/images/cuisine/kroeung-2200.webp',
    srcset: '/images/cuisine/kroeung-800.webp 800w, /images/cuisine/kroeung-1200.webp 1200w, /images/cuisine/kroeung-1600.webp 1600w, /images/cuisine/kroeung-2200.webp 2200w'
  },
  amok: {
    src: '/images/cuisine/amok-alt-1600.webp',
    srcset: '/images/cuisine/amok-alt-800.webp 800w, /images/cuisine/amok-alt-1200.webp 1200w, /images/cuisine/amok-alt-1600.webp 1600w'
  },
  lokLak: {
    src: '/images/cuisine/lok-lak-800.webp',
    srcset: '/images/cuisine/lok-lak-480.webp 480w, /images/cuisine/lok-lak-800.webp 800w'
  }
};

const marketMoments = [
  { time: '08:10', eyebrow: 'Kampot', title: 'Le poivre de Kampot, fraîchement moulu.', text: 'Vert, noir, rouge ou blanc : il apporte du parfum, de la chaleur et parfois une belle note fruitée.', image: images.kampot, href: '/culture/poivre-de-kampot/' },
  { time: '08:35', eyebrow: 'Acidité', title: 'Le tamarin apporte une acidité douce et fruitée.', text: 'On l’ajoute peu à peu dans une sauce ou une soupe, jusqu’à trouver le bon équilibre.', image: images.tamarind, href: '/glossaire/#tamarin' },
  { time: '09:05', eyebrow: 'Fermentation', title: 'Le prahok, puissant mais précieux.', text: 'Une petite quantité suffit souvent à donner du relief et cette saveur fermentée si particulière.', image: images.prahok, href: '/culture/prahok-fermentation-umami/' }
];

const glossaryWords = ['Kroeung', 'Prahok', 'Combava', 'Galanga', 'Tamarin', 'Amok'];

const recipes = [
  { title: 'Amok Trey', meta: 'Poisson · coco · vapeur', text: 'Un poisson tendre, une sauce parfumée au kroeung et au coco, cuite tout doucement.', href: '/recettes/amok-trey/', image: images.amok, alt: 'Amok Trey cambodgien' },
  { title: 'Lok Lak', meta: 'Bœuf · citron vert · poivre', text: 'Du bœuf saisi à feu vif, du citron vert et beaucoup de poivre fraîchement moulu.', href: '/recettes/lok-lak/', image: images.lokLak, alt: 'Lok lak cambodgien au bœuf' }
];
---
<BaseLayout
  image={images.market.src}
  title="Cuisine du Cambodge — Recettes, saveurs et histoires à partager"
  description="Recettes cambodgiennes, gestes de cuisine, produits, marchés et histoires gourmandes pour découvrir le Cambodge à table."
>
  <SiteHeader overlay />

  <main class="v16-home">
    <section class="v16-hero v16-scroll-scene" data-v16-hero aria-labelledby="v16-hero-title">
      <div class="v16-sticky v16-hero-stage">
        <figure class="v16-hero-image" aria-hidden="true">
          <img src={images.market.src} srcset={images.market.srcset} sizes="100vw" alt="" width="3888" height="2592" fetchpriority="high" decoding="async" />
        </figure>
        <div class="v16-hero-wash" aria-hidden="true"></div>
        <div class="v16-hero-copy">
          <p class="v16-time">06:30 · Cambodge</p>
          <p class="v16-kicker">À table au Cambodge</p>
          <h1 id="v16-hero-title">
            <span data-v16-hero-line>Sentir.</span>
            <span data-v16-hero-line>Goûter.</span>
            <span data-v16-hero-line>Cuisiner.</span>
          </h1>
          <p>Des marchés aux cuisines familiales, découvrez les parfums, les produits et les gestes qui rendent la cuisine cambodgienne si généreuse.</p>
          <nav class="v16-hero-actions" aria-label="Accès rapide">
            <a href="/recettes/">Voir les recettes</a>
            <a href="/apprendre/">Apprendre les gestes</a>
          </nav>
        </div>
        <div class="v16-hero-orbit" aria-hidden="true">
          <span class="v16-orbit-chip chip-a">marchés</span>
          <span class="v16-orbit-chip chip-b">herbes fraîches</span>
          <span class="v16-orbit-chip chip-c">feu vif</span>
          <span class="v16-orbit-chip chip-d">riz chaud</span>
        </div>
        <div class="v16-scroll-cue" aria-hidden="true"><span>Faire défiler</span><i></i></div>
      </div>
    </section>

    <section class="v16-morning" data-v16-morning aria-labelledby="v16-morning-title">
      <div class="v16-morning-time" aria-hidden="true">07:15</div>
      <div class="v16-morning-copy" data-reveal="up">
        <p class="v16-kicker">Le matin</p>
        <h2 id="v16-morning-title">Le matin, les rues sentent déjà le bouillon et les grillades.</h2>
        <p>Dès le matin, on trouve des bols de nouilles, du riz, des bouillons fumants et des viandes grillées. Une cuisine simple, chaude et parfumée qui accompagne le début de la journée.</p>
        <a href="/culture/">Entrer dans les carnets</a>
      </div>
      <div class="v16-morning-notes" aria-label="Repères du matin">
        <span>bouillon</span><span>riz</span><span>herbes</span><span>grillades</span>
      </div>
    </section>

    <section class="v16-market v16-scroll-scene" data-v16-market aria-labelledby="v16-market-title">
      <div class="v16-sticky v16-market-stage">
        <header class="v16-market-head">
          <p class="v16-time">08:00 · Marché</p>
          <h2 id="v16-market-title">Au marché, tout commence par les produits.</h2>
          <p>Poivre de Kampot, tamarin, prahok : trois saveurs très différentes qui racontent chacune une facette de la cuisine cambodgienne.</p>
        </header>
        <div class="v16-market-window">
          <div class="v16-market-track" data-v16-market-track>
            {marketMoments.map((item, index) => (
              <a class="v16-market-panel" href={item.href} data-v16-market-panel>
                <figure>
                  <img src={item.image.src} srcset={item.image.srcset} sizes="100vw" alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                </figure>
                <div class="v16-market-panel-shade"></div>
                <div class="v16-market-panel-copy">
                  <span>{item.time}</span>
                  <p>{item.eyebrow}</p>
                  <h3>{item.title}</h3>
                  <strong>{item.text}</strong>
                </div>
              </a>
            ))}
          </div>
        </div>
        <div class="v16-market-progress" aria-hidden="true"><span data-v16-market-count>01</span><i></i><span>03</span></div>
      </div>
    </section>

    <section class="v16-gesture v16-scroll-scene" data-v16-gesture aria-labelledby="v16-gesture-title">
      <div class="v16-sticky v16-gesture-stage">
        <figure class="v16-gesture-image">
          <img src={images.kroeung.src} srcset={images.kroeung.srcset} sizes="(max-width: 760px) 100vw, 54vw" alt="Kroeung cambodgien et aromates" loading="lazy" decoding="async" />
        </figure>
        <div class="v16-gesture-copy">
          <p class="v16-time">11:00 · Le geste</p>
          <p class="v16-kicker">Au mortier</p>
          <h2 id="v16-gesture-title">Les parfums se mêlent sous le pilon.</h2>
          <p>Citronnelle, galanga, curcuma, combava : on les coupe finement, puis on les pile jusqu’à obtenir une pâte souple, fraîche et très parfumée.</p>
          <a href="/apprendre/">Voir les ateliers</a>
        </div>
        <div class="v16-gesture-steps" aria-hidden="true">
          <span data-v16-gesture-chip>couper fin</span>
          <span data-v16-gesture-chip>piler</span>
          <span data-v16-gesture-chip>sentir</span>
          <span data-v16-gesture-chip>ajuster</span>
        </div>
      </div>
    </section>

    <section class="v16-table v16-scroll-scene" data-v16-table aria-labelledby="v16-table-title">
      <div class="v16-sticky v16-table-stage">
        <div class="v16-table-orbit" aria-hidden="true">
          <div class="v16-dish dish-rice" data-v16-dish><span>riz</span></div>
          <div class="v16-dish dish-hot" data-v16-dish><span>plat chaud</span></div>
          <div class="v16-dish dish-fresh" data-v16-dish><span>fraîcheur</span></div>
          <div class="v16-dish dish-condiment" data-v16-dish><span>condiment</span></div>
          <div class="v16-dish dish-soup" data-v16-dish><span>soupe</span></div>
        </div>
        <div class="v16-table-copy">
          <p class="v16-time">12:30 · À table</p>
          <h2 id="v16-table-title">À table, les plats se partagent.</h2>
          <p>Du riz chaud, un plat parfumé, quelques herbes, une soupe ou des légumes frais : chacun pioche, mélange et compose ses bouchées au fil du repas.</p>
          <a href="/culture/construire-repas-cambodgien/">Comprendre la table</a>
        </div>
      </div>
    </section>

    <section class="v16-glossary v16-scroll-scene" data-v16-glossary aria-labelledby="v16-glossary-title">
      <div class="v16-sticky v16-glossary-stage">
        <div class="v16-glossary-copy">
          <p class="v16-time">16:00 · Les mots</p>
          <p class="v16-kicker">Quelques mots pour mieux cuisiner</p>
          <h2 id="v16-glossary-title">Kroeung, prahok, galanga… on vous explique simplement.</h2>
          <a href="/glossaire/">Ouvrir le glossaire</a>
        </div>
        <div class="v16-glossary-words" aria-hidden="true">
          {glossaryWords.map((word, index) => <span data-v16-glossary-word class:list={[index === 0 && 'is-active']}>{word}</span>)}
        </div>
      </div>
    </section>

    <section class="v16-recipes" aria-labelledby="v16-recipes-title">
      <header data-reveal="up">
        <p class="v16-time">19:00 · À vous de cuisiner</p>
        <p class="v16-kicker">Envie de cuisiner ?</p>
        <h2 id="v16-recipes-title">À votre tour de passer en cuisine.</h2>
        <p>Choisissez un plat qui vous fait envie. Les quantités s’adaptent au nombre de personnes et chaque étape vous donne des repères simples pour réussir.</p>
      </header>
      <div class="v16-recipe-grid">
        {recipes.map((recipe) => (
          <a href={recipe.href} class="v16-recipe-card" data-reveal="up">
            <figure><img src={recipe.image.src} srcset={recipe.image.srcset} sizes="(max-width: 760px) 100vw, 50vw" alt={recipe.alt} loading="lazy" decoding="async" /></figure>
            <div><span>{recipe.meta}</span><h3>{recipe.title}</h3><p>{recipe.text}</p><strong>Cuisiner →</strong></div>
          </a>
        ))}
      </div>
      <nav class="v16-explore" aria-label="Explorer Cuisine du Cambodge">
        <a href="/recettes/">Toutes les recettes</a>
        <a href="/apprendre/">Les ateliers</a>
        <a href="/culture/">Les carnets</a>
        <a href="/glossaire/">Le glossaire</a>
      </nav>
    </section>

    <section class="home-credits">
      <span>Photographies sous licences Creative Commons — détails et auteurs dans les crédits.</span>
      <a href="/credits-photos/">Crédits photos</a>
    </section>
  </main>

  <SiteFooter />
  <script>
    import { initStorytelling } from '../scripts/storytelling';
    initStorytelling();
  </script>
</BaseLayout>
