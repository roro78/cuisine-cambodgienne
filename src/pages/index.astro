---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const images = {
  amok: 'https://commons.wikimedia.org/wiki/Special:FilePath/Fish_Amok-_Khmer_specialty.jpg?width=2000',
  market: 'https://commons.wikimedia.org/wiki/Special:FilePath/06-Kep_Crab_Market_Cambodia-nX-3_(cropped).jpg?width=2000',
  kroeung: 'https://commons.wikimedia.org/wiki/Special:FilePath/Cha_kroeung.jpg?width=2000',
  kampot: 'https://commons.wikimedia.org/wiki/Special:FilePath/Kampot_Pepper.jpg?width=2000',
  amokAlt: 'https://commons.wikimedia.org/wiki/Special:FilePath/Fish_amok_amok_trei_Khmer_Cambodian_food.jpg?width=2000'
};
---
<BaseLayout image={images.amok}>
  <SiteHeader overlay />

  <main>
    <section class="cinematic-story" aria-labelledby="cinematic-title">
      <div class="cinematic-stage">
        <div class="cinematic-scenes" aria-hidden="true">
          <figure class="cinematic-scene scene-0 is-base"><img src={images.amok} alt="" fetchpriority="high" /></figure>
          <figure class="cinematic-scene scene-1"><img src={images.market} alt="" /></figure>
          <figure class="cinematic-scene scene-2"><img src={images.kroeung} alt="" /></figure>
          <figure class="cinematic-scene scene-3"><img src={images.kampot} alt="" /></figure>
          <figure class="cinematic-scene scene-4"><img src={images.amokAlt} alt="" /></figure>
        </div>

        <div class="cinematic-vignette" aria-hidden="true"></div>
        <div class="cinematic-grain" aria-hidden="true"></div>

        <div class="cinematic-copy copy-0 is-visible">
          <p class="cinematic-kicker">Cuisine du Cambodge</p>
          <h1 id="cinematic-title">Avant la recette,<br />il y a le geste.</h1>
          <p class="cinematic-lead">On ne commence pas par une liste d’ingrédients. On commence par ce que l’on coupe, pile, chauffe et goûte.</p>
        </div>

        <div class="cinematic-copy copy-1">
          <p class="cinematic-kicker">01 — Frais</p>
          <h2>Tout commence<br />au marché.</h2>
          <p>Des racines, des herbes, du poivre, du poisson. La cuisine khmère part du produit avant de devenir recette.</p>
        </div>

        <div class="cinematic-copy copy-2">
          <p class="cinematic-kicker">02 — Kroeung</p>
          <h2>On pile.<br />On construit.</h2>
          <p>Citronnelle, galanga, curcuma, combava : le parfum devient une base. Pas un décor. Une structure.</p>
        </div>

        <div class="cinematic-copy copy-3">
          <p class="cinematic-kicker">03 — Kampot</p>
          <h2>Le goût a<br />un territoire.</h2>
          <p>À Kampot, le poivre raconte le sol, le climat et la main qui le cultive. Le produit devient mémoire.</p>
        </div>

        <div class="cinematic-copy copy-4">
          <p class="cinematic-kicker">04 — Amok</p>
          <h2>Puis tout revient<br />à l’assiette.</h2>
          <p>Le kroeung, le coco, le poisson, la vapeur. Comprendre chaque geste change la façon de cuisiner le plat.</p>
          <a class="cinematic-cta" href="/recettes/amok-trey/">Entrer par l’Amok Trey</a>
        </div>

        <div class="cinematic-ui" aria-hidden="true">
          <div class="cinematic-counter"><span class="counter-current">01</span><span>/05</span></div>
          <div class="cinematic-progress"><span class="cinematic-progress__fill"></span></div>
          <div class="cinematic-scroll-label">Défiler</div>
        </div>
      </div>
    </section>

    <section class="statement-section">
      <p class="statement-kicker">La ligne éditoriale</p>
      <h2>Comprendre ce que l’on fait<br />change ce que l’on cuisine.</h2>
      <p>Chaque recette relie le geste, le produit et le contexte. Pas de folklore plaqué. Pas de texte décoratif. Juste les clés pour cuisiner avec plus de précision.</p>
    </section>

    <section class="doorway-section" aria-label="Explorer le site">
      <a class="doorway doorway-recipes" href="/recettes/">
        <img src={images.amok} alt="Amok cambodgien servi avec du riz" loading="lazy" />
        <span class="doorway-shade"></span>
        <div class="doorway-copy"><small>01 — Recettes</small><strong>Cuisiner</strong><em>Amok, lok lak, kroeung et classiques khmers.</em></div>
      </a>
      <a class="doorway doorway-ingredients" href="/ingredients/">
        <img src={images.kroeung} alt="Plat cambodgien parfumé au kroeung" loading="lazy" />
        <span class="doorway-shade"></span>
        <div class="doorway-copy"><small>02 — Ingrédients</small><strong>Comprendre</strong><em>Kroeung, prahok, tamarin, poivres et aromates.</em></div>
      </a>
      <a class="doorway doorway-culture" href="/culture/">
        <img src={images.kampot} alt="Poivre vert de Kampot sur le plant" loading="lazy" />
        <span class="doorway-shade"></span>
        <div class="doorway-copy"><small>03 — Culture</small><strong>Relier</strong><em>Territoires, gestes, produits et transmission.</em></div>
      </a>
    </section>

    <section class="signature-section">
      <div class="signature-visual"><img src={images.amokAlt} alt="Amok trei cambodgien présenté dans des feuilles" loading="lazy" /></div>
      <div class="signature-copy">
        <p class="eyebrow">Plat signature</p>
        <h2>Amok Trey</h2>
        <p>Un plat pour comprendre l’essentiel : le kroeung comme colonne vertébrale, le coco pour l’équilibre, une cuisson douce pour la texture.</p>
        <a class="text-link" href="/recettes/amok-trey/">Voir la recette</a>
      </div>
    </section>

    <section class="home-credits">
      <span>Photographies sous licences Creative Commons — détails et auteurs dans les crédits.</span>
      <a href="/credits-photos/">Crédits photos</a>
    </section>
  </main>

  <SiteFooter />

  <script>
    import { initStorytelling } from '../scripts/storytelling';
    initStorytelling();
  </script>
</BaseLayout>
