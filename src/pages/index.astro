---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ScrollCompanion from '../components/ScrollCompanion.astro';

const images = {
  amok: '/images/cuisine/amok-2200.webp',
  market: '/images/cuisine/kep-market-2200.webp',
  kroeung: '/images/cuisine/kroeung-2200.webp',
  kampot: '/images/cuisine/kampot-2200.webp',
  amokAlt: '/images/cuisine/amok-alt-1600.webp'
};

const mobileImages = {
  amok: '/images/cuisine/amok-1200.webp',
  market: '/images/cuisine/kep-market-1200.webp',
  kroeung: '/images/cuisine/kroeung-1200.webp',
  kampot: '/images/cuisine/kampot-1200.webp',
  amokAlt: '/images/cuisine/amok-alt-1200.webp'
};

const desires = [
  {
    number: '01',
    eyebrow: 'Ce soir',
    title: 'Cuisiner quelque chose qui parfume toute la maison.',
    text: 'Amok, lok lak, riz chaud et sauces fraîches : commencer par un plat qui donne immédiatement envie de passer à table.',
    href: '/recettes/',
    cta: 'Choisir une recette',
    image: images.market,
    mobile: mobileImages.market,
    alt: 'Marché cambodgien et produits frais',
    tone: 'clay'
  },
  {
    number: '02',
    eyebrow: 'Au mortier',
    title: 'Maîtriser les gestes qui changent vraiment le goût.',
    text: 'Piler la citronnelle, équilibrer le coco, réveiller les aromates : apprendre les bases en les faisant.',
    href: '/apprendre/',
    cta: 'Apprendre les gestes',
    image: images.kroeung,
    mobile: mobileImages.kroeung,
    alt: 'Kroeung cambodgien et aromates frais',
    tone: 'green'
  },
  {
    number: '03',
    eyebrow: 'Dans le panier',
    title: 'Comprendre une saveur avant de la mettre dans la casserole.',
    text: 'Poivre de Kampot, tamarin, prahok, combava : connaître leur goût, leur rôle et les bons accords.',
    href: '/ingredients/',
    cta: 'Explorer les ingrédients',
    image: images.kampot,
    mobile: mobileImages.kampot,
    alt: 'Poivre de Kampot au Cambodge',
    tone: 'gold'
  }
];
---
<BaseLayout
  image={images.amok}
  title="Cuisine du Cambodge — Recettes, parfums et cuisine khmère"
  description="Citronnelle, kroeung, poivre de Kampot, coco, poissons et recettes cambodgiennes : une cuisine à sentir, goûter et refaire chez soi."
>
  <SiteHeader overlay />

  <main>
    <section class="scroll-film" aria-labelledby="scroll-film-title" data-scroll-film>
      <div
        class="scroll-film-stage"
        data-film-images={JSON.stringify([images.amok, images.market, images.kroeung, images.kampot, images.amokAlt])}
        data-film-images-mobile={JSON.stringify([mobileImages.amok, mobileImages.market, mobileImages.kroeung, mobileImages.kampot, mobileImages.amokAlt])}
      >
        <canvas class="scroll-film-canvas" aria-hidden="true"></canvas>
        <img
          class="scroll-film-fallback"
          src={images.amok}
          srcset={`${mobileImages.amok} 1200w, ${images.amok} 2200w`}
          sizes="100vw"
          alt=""
          width="3888"
          height="2592"
          aria-hidden="true"
          fetchpriority="high"
          decoding="async"
        />
        <div class="scroll-film-vignette" aria-hidden="true"></div>
        <div class="scroll-film-grain" aria-hidden="true"></div>

        <div class="film-copy film-copy-0 is-active">
          <p class="film-kicker"><span aria-hidden="true">🇰🇭</span> Cuisine du Cambodge</p>
          <h1 id="scroll-film-title">Le Cambodge<br />commence dans le mortier.</h1>
          <p>Citronnelle fraîche, galanga, curcuma, combava : on pile jusqu’à ce que le parfum remplisse la cuisine. Ensuite seulement, on allume le feu.</p>
        </div>

        <div class="film-copy film-copy-1">
          <p class="film-kicker">01 — Frais</p>
          <h2>Choisir ce qu’on<br />a envie de cuisiner.</h2>
          <p>Herbes fraîches, racines, poivre, poisson : on regarde, on sent, on goûte. Le repas commence bien avant la casserole.</p>
        </div>

        <div class="film-copy film-copy-2">
          <p class="film-kicker">02 — Kroeung</p>
          <h2>Le mortier réveille<br />les parfums.</h2>
          <p>La citronnelle s’écrase, le curcuma colore, le combava éclate. Le kroeung devient humide, puissant, frais : c’est là que le plat prend vie.</p>
        </div>

        <div class="film-copy film-copy-3">
          <p class="film-kicker">03 — Kampot</p>
          <h2>Un tour de poivre.<br />Et tout s’ouvre.</h2>
          <p>Frais, chaud, presque floral : le poivre de Kampot ne se cache pas dans le plat. Il le réveille.</p>
        </div>

        <div class="film-copy film-copy-4">
          <p class="film-kicker">04 — Amok</p>
          <h2>Crémeux, parfumé,<br />juste pris à la vapeur.</h2>
          <p>Le lait de coco enveloppe le kroeung, le poisson reste tendre, le combava arrive à la fin. L’Amok Trey se mange doux, chaud et très parfumé.</p>
          <a class="film-cta" href="/recettes/amok-trey/">Cuisiner l’Amok Trey</a>
        </div>

        <div class="film-side-ui" aria-hidden="true">
          <span class="film-count">01</span>
          <div class="film-progress"><i></i></div>
          <span class="film-label">Défiler</span>
        </div>
      </div>
    </section>

    <section class="desire-story" aria-labelledby="desire-title">
      <ScrollCompanion target=".desire-story" label="Feuille de bananier qui accompagne le défilement" />
      <header class="desire-intro" data-reveal="up">
        <p class="eyebrow">Choisissez votre envie</p>
        <h2 id="desire-title">Aujourd’hui,<br />vous avez envie de quoi&nbsp;?</h2>
        <p>Pas de catalogue. Trois portes d’entrée pour cuisiner, apprendre un geste ou comprendre ce que l’on met dans l’assiette.</p>
      </header>

      <div class="desire-list">
        {desires.map((item) => (
          <a class:list={['desire-entry', `desire-entry--${item.tone}`]} href={item.href} data-desire-entry>
            <div class="desire-copy">
              <span class="desire-number">{item.number}</span>
              <p class="eyebrow">{item.eyebrow}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
              <span class="desire-cta">{item.cta}</span>
            </div>
            <figure class="desire-media">
              <img src={item.image} srcset={`${item.mobile} 1200w, ${item.image} 2200w`} sizes="(max-width: 800px) 100vw, 48vw" alt={item.alt} loading="lazy" decoding="async" />
            </figure>
          </a>
        ))}
      </div>
    </section>

    <section class="amok-finale" data-amok-finale>
      <figure class="amok-finale-media">
        <img src={images.amok} srcset={`${mobileImages.amok} 1200w, ${images.amok} 2200w`} sizes="100vw" alt="Amok cambodgien servi avec du riz et des feuilles de bananier" width="3888" height="2592" loading="lazy" decoding="async" />
      </figure>
      <div class="amok-finale-shade"></div>
      <div class="amok-finale-steam" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="amok-finale-copy" data-reveal="up">
        <p class="eyebrow">À cuisiner ce soir</p>
        <h2>Amok Trey.</h2>
        <p>Poisson tendre, coco soyeux, kroeung très parfumé et une cuisson douce. Une recette emblématique à servir brûlante avec du riz.</p>
        <a href="/recettes/amok-trey/">Voir la recette</a>
      </div>
    </section>

    <section class="home-credits">
      <span>Photographies sous licences Creative Commons — détails et auteurs dans les crédits.</span>
      <a href="/credits-photos/">Crédits photos</a>
    </section>
  </main>

  <SiteFooter />

  <script>
    import { initStorytelling } from '../scripts/storytelling';
    initStorytelling();
  </script>
</BaseLayout>
