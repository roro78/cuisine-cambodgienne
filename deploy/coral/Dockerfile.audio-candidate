# OFFLINE QUALIFICATION/PACKAGE ONLY. No compose service references this image.
FROM node:22-bookworm-slim@sha256:9f0dde62d10e7ff7a310ecaebd66225f6b46c17e6cb778449a77b05d3541bea2
ARG SOURCE_REVISION=unversioned
LABEL org.opencontainers.image.source="https://github.com/roro78/cuisine-cambodgienne" \
      org.opencontainers.image.revision="${SOURCE_REVISION}"
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg=7:5.1.9-0+deb12u1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY scripts/editorial-ai-job-gateway.mjs scripts/private-runtime-secret.mjs \
     scripts/coral-openai-secret.mjs scripts/coral-external-job-provider.mjs \
     scripts/coral-text-api-contract.mjs scripts/coral-chapter-voice-checks.mjs \
     scripts/coral-tts-jobs.mjs scripts/coral-tts-audio.mjs scripts/coral-tts-authority.mjs \
     scripts/coral-tts-cost-plan.mjs scripts/coral-tts-realtime-contract.mjs scripts/coral-tts-checkpoints.mjs \
     scripts/coral-media-backup.mjs scripts/coral-state-backup.mjs scripts/coral-audio-image-preflight.mjs ./scripts/
RUN chmod -R 0555 /app
USER 1000:1000
# Default is a read-only tools check, never an HTTP listener or worker.
CMD ["node", "scripts/coral-audio-image-preflight.mjs"]
