{
  "name": "cuisine-cambodgienne",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "test:motion": "node scripts/check-motion-contract.mjs",
    "test:editorial": "node scripts/check-editorial-contract.mjs && node scripts/check-culinary-lexicon.mjs && node tests/atelier-coral-quota-safety.test.mjs && node tests/editorial-source-visibility.test.mjs && node tests/carnets-c02-contract.test.mjs && node tests/carnets-c05-contract.test.mjs && node tests/carnets-c03-contract.test.mjs",
    "preview": "astro preview",
    "test:recipes": "node scripts/check-recipe-contract.mjs",
    "test:experiences": "node scripts/check-experiences-contract.mjs",
    "test:dinner": "node --test tests/dinner-preview.test.mjs",
    "test:timeline": "node --test tests/dinner-timeline.test.mjs",
    "test:kitchen": "node --test tests/dinner-kitchen-guide.test.mjs",
    "test:pack": "node --test tests/dinner-pack.test.mjs",
    "test:reception": "node --test tests/dinner-reception.test.mjs",
    "test:built-experiences": "node scripts/check-experiences-build.mjs",
    "test:browser-experiences": "node tests/experiences-browser-smoke.mjs",
    "prebuild": "node scripts/v17-responsive-images.mjs && node scripts/build-social-assets.mjs",
    "predev": "node scripts/v17-responsive-images.mjs && node scripts/build-social-assets.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.13.5",
    "gsap": "^3.13.0",
    "typescript": "^5.9.2",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.25.10",
    "playwright-core": "^1.56.1"
  }
}
